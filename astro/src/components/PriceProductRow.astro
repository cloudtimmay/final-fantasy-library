---
import { cdnImage } from '../lib/image-url'
import { cheapestLine, formatPriceNokFirst } from '../lib/price-display'
// Renders one product's <li> in the /prices list — shared between the Product-grouped
// view and every section of the Person-grouped view, so both stay visually/structurally
// identical. `prices` is whichever subset the caller wants listed inside this rendering
// (all of them in Product view; only one buyer's in a Person-grouped section) — the
// cheapest-price line and "+N" below are computed from exactly that subset, not the
// product's full history, matching /prices.astro's "only the matching prices are listed"
// rule. Filtering by person/status within what's rendered here is done client-side by
// /prices.astro's script (toggling [hidden] and data-* attributes, then recomputing the
// price line with the same lib/price-display.ts functions), not by this component.
//
// Compact on purpose: the collapsed row is just the photo, a category icon, the name and
// the cheapest price — NOK first, with yen alongside (`rate`: the trip's jpyToNokRate, see
// lib/price-display.ts). The Japanese name isn't shown here (it's on add-price, edit-price
// and edit-product) but is still part of the search text.
export interface Props {
  product: {
    key: string
    productName: string
    productNameJp?: string
    jan?: string
    category?: string
    image: { assetId: string; url: string } | null
  }
  prices: {
    _id: string
    source: string
    price: number
    currency: string
    condition?: string
    status?: string
    seenAt?: string
    note?: string
    buyer?: string
  }[]
  rate?: number | null
}

const { product: p, prices, rate } = Astro.props

const CATEGORY_ICONS: Record<string, { icon: string; label: string }> = {
  album: { icon: '🎵', label: 'Album' },
  game: { icon: '🎮', label: 'Game' },
  book: { icon: '📚', label: 'Book' },
  figure: { icon: '🧸', label: 'Merchandise' },
  other: { icon: '🏷️', label: 'Other' },
}
const CONDITION_LABELS: Record<string, string> = {
  new: 'New',
  used: 'Used',
  used_complete: 'Used, complete (box/obi)',
}

function formatDate(iso: string | undefined): string {
  if (!iso) return ''
  const d = new Date(iso)
  if (isNaN(d.getTime())) return ''
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
}

const cat = p.category ? CATEGORY_ICONS[p.category] || { icon: '🏷️', label: p.category } : null
const line = cheapestLine(prices, rate)
const searchHay = `${p.productName} ${p.productNameJp || ''} ${p.jan || ''}`.toLowerCase()
---
<li class="price-row" data-search={searchHay}>
  <details data-key={p.key}>
    <summary>
      {p.image ? (
        <img class="thumb" src={cdnImage(p.image.url, 160)} data-lightbox={cdnImage(p.image.url, 2000)} alt={p.productName} />
      ) : (
        <div class="thumb thumb-placeholder">🏷️</div>
      )}
      <div class="summary-info">
        <div class="summary-name">
          {cat && <span class="cat-icon" role="img" aria-label={cat.label} title={cat.label}>{cat.icon}</span>}
          {p.productName}
        </div>
        <div class="summary-price-line">
          <span class="summary-price">{line?.text}</span>
          <span class="summary-more" hidden={!line || line.more === 0}>+{line?.more ?? 0}</span>
        </div>
      </div>
    </summary>

    <ul class="history-list">
      {prices.map((price) => (
        <li
          class="history-item"
          data-buyer={price.buyer || ''}
          data-status={price.status || ''}
          data-currency={price.currency}
          data-price={price.price}
          data-source={price.source}
        >
          <a class="history-row" href={`/edit-price?id=${price._id}`}>
            <div class="history-main">
              <span class="history-source">{price.source}</span>
              {price.buyer && <span class="history-buyer">{price.buyer}</span>}
              <span class="history-price">{formatPriceNokFirst(price.price, price.currency, rate)}</span>
              {price.condition && <span class="history-condition">{CONDITION_LABELS[price.condition] || price.condition}</span>}
              {price.status === 'bought' && <span class="history-bought">✅</span>}
              <span class="history-date">{formatDate(price.seenAt)}</span>
            </div>
            {price.note && <div class="history-note">{price.note}</div>}
          </a>
        </li>
      ))}
    </ul>

    <div class="product-actions">
      <a class="add-price-link" href={`/add-price?product=${encodeURIComponent(p.key)}`}>+ Add price</a>
      <a class="edit-product-link" href={`/edit-product?product=${encodeURIComponent(p.key)}`}>✏️ Edit product</a>
    </div>
  </details>
</li>

<style>
  details {
    background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
    overflow: hidden;
  }
  details[open] { border-color: var(--accent); }

  /* The whole summary is the tap target (min 44px tall); kept as small as that allows. */
  summary {
    display: flex; align-items: center; gap: 0.6rem; min-height: 44px;
    padding: 0.45rem 0.6rem; cursor: pointer; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }

  .thumb {
    width: 44px; height: 44px; object-fit: cover; border-radius: 6px;
    background: var(--bg); flex-shrink: 0;
  }
  .thumb-placeholder {
    display: flex; align-items: center; justify-content: center; font-size: 1.2rem;
    border: 1px solid var(--border);
  }

  .summary-info { flex: 1; min-width: 0; }
  .summary-name {
    font-weight: 600; font-size: 0.95rem; line-height: 1.3;
    overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }
  .cat-icon { font-size: 0.85rem; margin-right: 0.3rem; }
  .summary-price-line { display: flex; align-items: baseline; gap: 0.4rem; margin-top: 0.1rem; min-width: 0; }
  .summary-price {
    font-size: 0.82rem; color: var(--accent); font-weight: 600;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;
  }
  .summary-more {
    font-size: 0.72rem; font-weight: 600; color: var(--muted); white-space: nowrap; flex-shrink: 0;
    font-family: 'IBM Plex Mono', monospace;
  }
  .summary-more[hidden] { display: none; }

  .history-list {
    list-style: none; margin: 0; padding: 0 0.6rem 0.6rem;
    display: flex; flex-direction: column; gap: 0.35rem;
  }
  .history-item[hidden] { display: none; }
  .history-row {
    display: flex; flex-direction: column; gap: 0.2rem; min-height: 44px; justify-content: center;
    font-size: 0.85rem; padding: 0.45rem 0.65rem;
    background: var(--bg); border: 1px solid var(--border); border-radius: 6px;
    text-decoration: none; color: inherit; cursor: pointer;
  }
  .history-row:hover { border-color: var(--accent); }
  .history-main { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .history-source { flex: 1; min-width: 80px; color: var(--text); }
  .history-buyer {
    font-size: 0.7rem; font-weight: 600; padding: 0.1rem 0.4rem; border-radius: 4px;
    background: var(--border); color: var(--text); white-space: nowrap;
  }
  .history-price { font-weight: 600; color: var(--accent); white-space: nowrap; }
  .history-condition { font-size: 0.78rem; color: var(--muted); white-space: nowrap; }
  .history-bought { white-space: nowrap; }
  .history-date { font-size: 0.78rem; color: var(--muted); white-space: nowrap; margin-left: auto; }
  .history-note { font-size: 0.78rem; color: var(--muted); overflow-wrap: anywhere; }

  .product-actions { display: flex; gap: 0.5rem; margin: 0 0.6rem 0.6rem; flex-wrap: wrap; }
  .add-price-link, .edit-product-link {
    flex: 1; min-width: 130px; text-align: center; min-height: 44px; box-sizing: border-box;
    display: flex; align-items: center; justify-content: center;
    padding: 0.5rem; border-radius: 8px; text-decoration: none; font-size: 0.9rem; font-weight: 600;
  }
  .add-price-link { background: var(--bg); color: var(--accent); border: 1px solid var(--accent); }
  .add-price-link:hover { background: rgba(244,162,76,0.1); }
  .edit-product-link { background: var(--bg); color: var(--text); border: 1px solid var(--border); }
  .edit-product-link:hover { border-color: var(--accent); }
</style>
