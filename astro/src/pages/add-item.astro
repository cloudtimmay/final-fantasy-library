---
import Base from '../layouts/Base.astro'
import { sanity } from '../lib/sanity'

const today = new Date().toISOString().split('T')[0]
const seriesRaw = await sanity.fetch(`
  array::unique(*[_type in ["album","game","book","figure"] && defined(series)].series)
`)
const seriesList = (seriesRaw || []).filter(Boolean).sort()
---
<Base title="Add item">
  <div class="add-wrap">
    <h1>Add to collection</h1>
    <p class="hint">Pick a type, scan the barcode, look it up, add a photo, and save.</p>

    <div class="field">
      <label>Type</label>
      <select id="f-type">
        <option value="album">💿 Album / CD</option>
        <option value="game">🎮 Game</option>
        <option value="book">📖 Book</option>
        <option value="merch">🗿 Merch</option>
      </select>
    </div>

    <div class="field">
      <label>Barcode</label>
      <div class="barcode-row">
        <input id="f-barcode" type="text" placeholder="Scanned code (optional)" />
        <button id="f-scan" type="button" class="scan-btn">📷 Scan</button>
      </div>
      <div id="f-reader" class="scan-reader" hidden></div>
      <p id="f-scan-msg" class="scan-msg" hidden></p>
      <div id="f-dup" class="dup-warn" hidden></div>
    </div>

    <div class="lookup-row">
      <span class="lookup-label">Look up:</span>
      <span id="f-lookups"></span>
    </div>

    <div class="field" data-for="merch">
      <label>Merch type</label>
      <select id="f-category">
        <option value="figure">Figure</option>
        <option value="plushie">Plushie</option>
        <option value="wearable">Wearable</option>
        <option value="other">Other</option>
      </select>
    </div>

    <div class="field" data-for="game">
      <label>Platform</label>
      <select id="f-platform">
        <option value="">Select…</option>
        <option>PS1</option><option>PS2</option><option>PS3</option><option>PS4</option><option>PS5</option>
        <option>PSP</option><option>PS Vita</option>
        <option>SNES</option><option>NES</option><option>N64</option><option>GameCube</option>
        <option>Switch</option><option>3DS</option><option>DS</option><option>GBA</option>
        <option>Xbox</option><option>Xbox 360</option><option>PC</option><option>Other</option>
      </select>
    </div>

    <div class="field">
      <label>Series / Franchise</label>
      <select id="f-series">
        <option value="">Select series…</option>
        {seriesList.map((s: string) => <option value={s}>{s}</option>)}
        <option value="__new__">+ New series…</option>
      </select>
      <input id="f-series-new" type="text" placeholder="New series name" hidden style="margin-top:0.5rem" />
    </div>

    <div class="field">
      <label>Title *</label>
      <input id="f-title" type="text" placeholder="Title" />
    </div>

    <div class="field" data-for="album game book">
      <label id="f-creator-label">Creator</label>
      <input id="f-creator" type="text" placeholder="Name" />
    </div>

    <div class="field" data-for="merch">
      <label>Manufacturer</label>
      <input id="f-manufacturer" type="text" placeholder="e.g. Square Enix" />
    </div>

    <div class="field" data-for="album">
      <label>Catalog number</label>
      <input id="f-catalog" type="text" placeholder="e.g. SQEX-10130" />
    </div>

    <div class="field-row" data-for="merch">
      <div class="field">
        <label>Scale</label>
        <input id="f-scale" type="text" placeholder="e.g. 1/7" />
      </div>
      <div class="field">
        <label>Condition</label>
        <input id="f-condition" type="text" placeholder="e.g. New in box" />
      </div>
    </div>

    <div class="field">
      <label id="f-year-label">Year</label>
      <input id="f-year" type="number" inputmode="numeric" placeholder="2005" />
    </div>

    <div class="field-row">
      <div class="field">
        <label>Price (JPY)</label>
        <input id="f-yen" type="number" inputmode="numeric" placeholder="¥" />
      </div>
      <div class="field">
        <label>Price (NOK)</label>
        <input id="f-nok" type="number" inputmode="numeric" placeholder="kr" />
      </div>
    </div>

    <div class="field">
      <label>Acquired date</label>
      <input id="f-date" type="date" value={today} />
    </div>

    <div class="field">
      <label>Photo</label>
      <div class="photo-buttons">
        <label class="upload-btn">
          📷 Take photo
          <input id="f-photo-camera" type="file" accept="image/*" capture="environment" hidden />
        </label>
        <label class="upload-btn">
          🖼️ Choose from gallery
          <input id="f-photo-gallery" type="file" accept="image/*" hidden />
        </label>
      </div>
      <span id="f-photo-name" class="photo-name" hidden></span>
      <img id="f-preview" class="photo-preview" hidden alt="Preview" />
      <button id="f-photo-remove" type="button" class="photo-remove-btn" hidden>✕ Remove photo</button>
      <button id="f-identify-btn" type="button" class="identify-btn" hidden>✨ Identify</button>
      <div id="f-extra-photo-buttons" class="extra-photo-buttons" hidden>
        <label class="upload-btn upload-btn-small">
          📷 Camera
          <input id="f-extra-photo-camera" type="file" accept="image/*" capture="environment" hidden />
        </label>
        <label class="upload-btn upload-btn-small">
          🖼️ Gallery
          <input id="f-extra-photo-gallery" type="file" accept="image/*" hidden />
        </label>
      </div>
      <div id="f-extra-photos" class="extra-photos" hidden></div>
      <div id="f-identify-msg" class="identify-msg" hidden></div>
      <div id="f-identify-card" class="identify-card" hidden></div>
    </div>

    <div class="field">
      <label>Notes</label>
      <textarea id="f-notes" rows="2" placeholder="Anything worth noting…"></textarea>
    </div>

    <button id="f-save" type="button" class="save-btn">Save</button>
    <p id="f-msg" class="save-msg" hidden></p>

    <a href="/" class="back-link">← Back</a>
  </div>

  <script is:inline src="/resize-image.js"></script>
  <script is:inline src="/identify-flow.js"></script>

  <script>
    const CONFIG = {
      album: { endpoint: '/api/album-create', backLabel: 'album', creatorLabel: 'Composer / Artist', yearLabel: 'Release year',
        lookups: [['vgmdb','VGMdb'],['google','Google'],['googleimg','Google Images']] },
      game: { endpoint: '/api/game-create', backLabel: 'game', creatorLabel: 'Publisher / Developer', yearLabel: 'Year',
        lookups: [['mobygames','MobyGames'],['google','Google'],['googleimg','Google Images']] },
      book: { endpoint: '/api/book-create', backLabel: 'book', creatorLabel: 'Author / Publisher', yearLabel: 'Year',
        lookups: [['googlebooks','Google Books'],['google','Google'],['googleimg','Google Images']] },
      merch: { endpoint: '/api/figure-create', backLabel: 'merch', creatorLabel: '', yearLabel: 'Year',
        lookups: [['mfc','MyFigureCollection'],['google','Google'],['googleimg','Google Images']] },
    }

    // identify-product.ts's categories (album|game|book|figure|other) mapped to this
    // page's types — "other" has no sensible type here, so a suggestion with that
    // category just leaves the current type alone.
    const IDENTIFY_CATEGORY_TO_TYPE = { album: 'album', game: 'game', book: 'book', figure: 'merch' }

    const typeSelect = document.querySelector('#f-type')
    const barcodeInput = document.querySelector('#f-barcode')
    const categorySelect = document.querySelector('#f-category')
    const platformSelect = document.querySelector('#f-platform')
    const seriesSelect = document.querySelector('#f-series')
    const seriesNewInput = document.querySelector('#f-series-new')
    const titleInput = document.querySelector('#f-title')
    const creatorLabel = document.querySelector('#f-creator-label')
    const creatorInput = document.querySelector('#f-creator')
    const manufacturerInput = document.querySelector('#f-manufacturer')
    const catalogInput = document.querySelector('#f-catalog')
    const scaleInput = document.querySelector('#f-scale')
    const conditionInput = document.querySelector('#f-condition')
    const yearLabel = document.querySelector('#f-year-label')
    const yearInput = document.querySelector('#f-year')
    const yenInput = document.querySelector('#f-yen')
    const nokInput = document.querySelector('#f-nok')
    const dateInput = document.querySelector('#f-date')
    const notesInput = document.querySelector('#f-notes')
    const saveBtn = document.querySelector('#f-save')
    const msg = document.querySelector('#f-msg')
    const lookupsEl = document.querySelector('#f-lookups')
    const scanBtn = document.querySelector('#f-scan')
    const reader = document.querySelector('#f-reader')
    const scanMsg = document.querySelector('#f-scan-msg')
    const dupWarn = document.querySelector('#f-dup')
    const photoCamera = document.querySelector('#f-photo-camera')
    const photoGallery = document.querySelector('#f-photo-gallery')
    const photoName = document.querySelector('#f-photo-name')
    const preview = document.querySelector('#f-preview')
    const photoRemoveBtn = document.querySelector('#f-photo-remove')
    const identifyBtn = document.querySelector('#f-identify-btn')
    const identifyMsg = document.querySelector('#f-identify-msg')
    const identifyCard = document.querySelector('#f-identify-card')
    const extraPhotoButtons = document.querySelector('#f-extra-photo-buttons')
    const extraPhotoCamera = document.querySelector('#f-extra-photo-camera')
    const extraPhotoGallery = document.querySelector('#f-extra-photo-gallery')
    const extraPhotosWrap = document.querySelector('#f-extra-photos')

    function currentType() { return typeSelect.value }

    function applyType() {
      const type = currentType()
      const cfg = CONFIG[type]
      document.querySelectorAll('[data-for]').forEach((el) => {
        const types = el.getAttribute('data-for').split(' ')
        el.hidden = !types.includes(type)
      })
      if (cfg.creatorLabel) creatorLabel.textContent = cfg.creatorLabel
      yearLabel.textContent = cfg.yearLabel
      lookupsEl.innerHTML = cfg.lookups.map(([src, label]) =>
        `<button type="button" class="lk-btn" data-src="${src}">${label}</button>`).join(' ')
      lookupsEl.querySelectorAll('.lk-btn').forEach((btn) => btn.addEventListener('click', () => doLookup(btn.dataset.src)))
      saveBtn.textContent = 'Save ' + cfg.backLabel
    }

    const identifyFlow = window.createIdentifyFlow({
      els: {
        photoCamera, photoGallery, photoName, preview, photoRemoveBtn, identifyBtn, identifyMsg, identifyCard,
        extraPhotoButtons, extraPhotoCamera, extraPhotoGallery, extraPhotosWrap,
      },
      // No "existing item" concept here (unlike add-price's existing-product dropdown) —
      // a suggestion always just fills fields, never offers to link to something else.
      onUseSuggestion: (result) => {
        const mappedType = result.category && IDENTIFY_CATEGORY_TO_TYPE[result.category]
        if (mappedType) {
          typeSelect.value = mappedType
          applyType()
          if (mappedType === 'merch' && result.category === 'figure') categorySelect.value = 'figure'
        }
        if (result.productName) titleInput.value = result.productName
        if (result.jan) {
          barcodeInput.value = result.jan
          checkDuplicate(result.jan)
        }
        if (typeof result.price === 'number') yenInput.value = String(result.price)
        if (result.notes) notesInput.value = result.notes
      },
    })

    seriesSelect.addEventListener('change', () => {
      if (seriesSelect.value === '__new__') { seriesNewInput.hidden = false; seriesNewInput.focus() }
      else { seriesNewInput.hidden = true; seriesNewInput.value = '' }
    })
    function chosenSeries() {
      if (seriesSelect.value === '__new__') return seriesNewInput.value.trim()
      return seriesSelect.value
    }

    const params = new URLSearchParams(window.location.search)
    const preType = params.get('type')
    if (preType && CONFIG[preType]) typeSelect.value = preType
    const preBarcode = params.get('barcode')
    if (preBarcode) barcodeInput.value = preBarcode

    function showMsg(text, ok) { msg.hidden = false; msg.textContent = text; msg.style.color = ok ? '#2ecc71' : '#e74c3c' }

    async function checkDuplicate(code) {
      dupWarn.hidden = true; dupWarn.innerHTML = ''
      const c = (code || '').trim(); if (!c) return
      try {
        const res = await fetch('/api/check-duplicate?barcode=' + encodeURIComponent(c))
        const data = await res.json()
        if (res.ok && data.count > 0) {
          const m = data.matches[0]
          dupWarn.hidden = false
          dupWarn.innerHTML = `⚠️ <strong>Already in your collection:</strong> “${m.title}” (${m.status || m._type}).`
        }
      } catch (e) {}
    }
    barcodeInput.addEventListener('change', () => checkDuplicate(barcodeInput.value))

    function lookupUrl(src, term) {
      const enc = encodeURIComponent(term)
      switch (src) {
        case 'vgmdb': return `https://vgmdb.net/search?q=${enc}`
        case 'mobygames': return `https://www.mobygames.com/search/?q=${enc}`
        case 'googlebooks': return `https://www.google.com/search?tbm=bks&q=${enc}`
        case 'mfc': return `https://myfigurecollection.net/?_tb=item&keywords=${enc}`
        case 'google': return `https://www.google.com/search?q=${enc}`
        case 'googleimg': return `https://www.google.com/search?tbm=isch&q=${enc}`
      }
      return ''
    }
    function doLookup(src) {
      const term = (catalogInput.value.trim() || titleInput.value.trim() || barcodeInput.value.trim())
      if (!term) { showMsg('Enter a title, code or catalog number first.', false); return }
      const url = lookupUrl(src, term)
      if (url) window.open(url, '_blank', 'noopener')
    }

    let scannerLibLoading = null
    function loadScannerLib() {
      if (window.Html5Qrcode) return Promise.resolve(true)
      if (scannerLibLoading) return scannerLibLoading
      scannerLibLoading = new Promise((resolve) => {
        const s = document.createElement('script')
        s.src = 'https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js'
        s.onload = () => resolve(true)
        s.onerror = () => resolve(false)
        document.head.appendChild(s)
      })
      return scannerLibLoading
    }

    let scanner = null, running = false
    async function startScan() {
      scanMsg.hidden = false; scanMsg.style.color = 'var(--muted)'; scanMsg.textContent = 'Loading scanner…'
      const ok = await loadScannerLib()
      if (!ok || typeof Html5Qrcode === 'undefined') {
        scanMsg.style.color = '#e74c3c'
        scanMsg.textContent = 'Scanner could not be loaded. Check your connection.'
        return
      }
      reader.hidden = false; scanMsg.hidden = true
      scanner = new Html5Qrcode('f-reader')
      try {
        await scanner.start({ facingMode: 'environment' }, { fps: 10, qrbox: { width: 250, height: 150 } },
          (decodedText) => { const code = decodedText.replace(/[^0-9Xx]/g, ''); barcodeInput.value = code; stopScan(); checkDuplicate(code) }, () => {})
        running = true; scanBtn.textContent = '✕ Close'
      } catch (err) { scanMsg.hidden = false; scanMsg.style.color = '#e74c3c'; scanMsg.textContent = 'Could not access camera. Allow camera and try again.'; reader.hidden = true }
    }
    async function stopScan() {
      if (scanner && running) { try { await scanner.stop() } catch (e) {} running = false }
      reader.hidden = true; scanBtn.textContent = '📷 Scan'
    }
    scanBtn.addEventListener('click', () => { if (running) stopScan(); else startScan() })

    function buildBody(type) {
      const base = {
        title: titleInput.value.trim(),
        series: chosenSeries(),
        barcode: barcodeInput.value,
        purchasePriceYen: yenInput.value,
        purchasePrice: nokInput.value,
        acquiredDate: dateInput.value,
        notes: notesInput.value,
      }
      if (type === 'album') return { ...base, composer: creatorInput.value, catalogNumber: catalogInput.value, releaseDate: yearInput.value }
      if (type === 'game') return { ...base, creator: creatorInput.value, platform: platformSelect.value, year: yearInput.value }
      if (type === 'book') return { ...base, creator: creatorInput.value, year: yearInput.value }
      if (type === 'merch') return { ...base, manufacturer: manufacturerInput.value, category: categorySelect.value, scale: scaleInput.value, condition: conditionInput.value, year: yearInput.value }
      return base
    }

    async function save() {
      if (!titleInput.value.trim()) return showMsg('Please enter a title.', false)
      const type = currentType()
      const cfg = CONFIG[type]
      saveBtn.disabled = true; saveBtn.textContent = 'Saving…'
      try {
        const res = await fetch(cfg.endpoint, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(buildBody(type)),
        })
        const data = await res.json()
        if (!res.ok) { showMsg(data.error || 'Save failed.', false); return }
        const selectedPhoto = identifyFlow.getSelectedPhoto()
        if (selectedPhoto && data.id) {
          saveBtn.textContent = 'Uploading photo…'
          const form = new FormData()
          form.append('file', selectedPhoto); form.append('docId', data.id); form.append('field', 'image')
          try { await fetch('/api/upload-image', { method: 'POST', body: form }) } catch (e) {}
        }
        showMsg('Saved ✓ — ready for the next one.', true)
        titleInput.value = ''; creatorInput.value = ''; manufacturerInput.value = ''; catalogInput.value = ''
        scaleInput.value = ''; conditionInput.value = ''; platformSelect.value = ''; categorySelect.value = 'figure'
        seriesSelect.value = ''; seriesNewInput.value = ''; seriesNewInput.hidden = true
        yearInput.value = ''; barcodeInput.value = ''; yenInput.value = ''; nokInput.value = ''; notesInput.value = ''
        identifyFlow.reset()
        dupWarn.hidden = true; dupWarn.innerHTML = ''
        titleInput.focus()
      } catch (e) { showMsg('Network error.', false) }
      finally { saveBtn.disabled = false; saveBtn.textContent = 'Save ' + cfg.backLabel }
    }
    saveBtn.addEventListener('click', save)

    typeSelect.addEventListener('change', applyType)
    applyType()
    if (preBarcode) checkDuplicate(preBarcode)
  </script>

  <style>
    .add-wrap { max-width: 520px; }
    .hint { font-size: 0.9rem; color: var(--muted); margin: 0.25rem 0 1.5rem; }
    .field { margin-bottom: 1rem; }
    .field-row { display: flex; gap: 1rem; }
    .field-row .field { flex: 1; }
    .field label { display: block; font-size: 0.8rem; color: var(--muted); margin-bottom: 0.35rem; }
    .field input, .field select, .field textarea {
      width: 100%; background: var(--surface); color: var(--text);
      border: 1px solid var(--border); padding: 0.7rem 0.75rem; border-radius: 8px; font-size: 1rem;
      font-family: inherit; box-sizing: border-box;
    }
    .barcode-row { display: flex; gap: 0.5rem; }
    .barcode-row input { flex: 1; min-width: 0; }
    .scan-btn { flex-shrink: 0; background: var(--surface); color: var(--text); border: 1px solid var(--accent); padding: 0 1rem; border-radius: 8px; cursor: pointer; font-size: 0.9rem; white-space: nowrap; }
    .scan-reader { width: 100%; max-width: 400px; margin: 0.75rem auto 0; border-radius: 8px; overflow: hidden; }
    .scan-msg { font-size: 0.85rem; color: var(--muted); margin: 0.5rem 0 0; }
    .dup-warn { background: #4a0f1c; border: 1px solid #e74c3c; color: #ffd9d9; padding: 0.7rem 0.85rem; border-radius: 8px; margin-top: 0.6rem; font-size: 0.9rem; }
    .dup-warn strong { color: #fff; }
    .lookup-row { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
    .lookup-label { font-size: 0.8rem; color: var(--muted); }
    .lk-btn { background: var(--surface); color: var(--text); border: 1px solid var(--border); padding: 0.45rem 0.75rem; border-radius: 6px; cursor: pointer; font-size: 0.85rem; }
    .lk-btn:hover { border-color: var(--accent); }
    .photo-buttons { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .upload-btn { display: inline-block; background: var(--surface); color: var(--text); border: 1px solid var(--accent); padding: 0.6rem 0.9rem; border-radius: 8px; cursor: pointer; font-size: 0.9rem; }
    .upload-btn:hover { background: #241826; }
    .photo-name { font-size: 0.85rem; color: var(--muted); display: block; margin-top: 0.5rem; }
    .photo-name[hidden] { display: none; }
    .photo-preview { display: block; max-width: 200px; max-height: 200px; margin-top: 0.75rem; border-radius: 8px; border: 1px solid var(--border); }
    .photo-preview[hidden] { display: none; }
    .photo-remove-btn {
      display: inline-block; margin-top: 0.5rem; background: var(--surface); color: var(--text);
      border: 1px solid var(--border); padding: 0.4rem 0.8rem; border-radius: 6px;
      cursor: pointer; font-size: 0.85rem;
    }
    .photo-remove-btn[hidden] { display: none; }
    .photo-remove-btn:hover { border-color: var(--accent); }
    .identify-btn {
      display: inline-block; margin-top: 0.5rem; margin-left: 0.5rem; background: var(--surface); color: var(--accent);
      border: 1px solid var(--accent); padding: 0.4rem 0.8rem; border-radius: 6px;
      cursor: pointer; font-size: 0.85rem; font-weight: 600;
    }
    .identify-btn[hidden] { display: none; }
    .identify-btn:hover { background: rgba(244,162,76,0.1); }
    .identify-btn:disabled { opacity: 0.6; cursor: default; }
    .identify-msg { font-size: 0.85rem; margin-top: 0.5rem; }
    .identify-msg[hidden] { display: none; }
    .identify-card {
      display: flex; flex-direction: column; gap: 0.4rem; margin-top: 0.75rem;
      padding: 0.75rem; background: rgba(244,162,76,0.06); border: 1px solid rgba(244,162,76,0.3); border-radius: 8px;
    }
    .identify-card[hidden] { display: none; }
    .extra-photo-buttons { display: inline-flex; gap: 0.4rem; margin-top: 0.5rem; margin-left: 0.5rem; flex-wrap: wrap; }
    .extra-photo-buttons[hidden] { display: none; }
    .upload-btn-small { padding: 0.4rem 0.7rem; font-size: 0.85rem; font-weight: 600; }
    .extra-photos { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.6rem; }
    .extra-photos[hidden] { display: none; }
    .save-btn { width: 100%; margin-top: 0.5rem; background: var(--accent); color: #fff; border: none; padding: 0.9rem; border-radius: 8px; font-size: 1.05rem; font-weight: 600; cursor: pointer; }
    .save-btn:disabled { opacity: 0.6; cursor: default; }
    .save-msg { font-size: 0.9rem; margin: 0.75rem 0 0; }
    .back-link { display: inline-block; margin-top: 1.5rem; color: var(--muted); text-decoration: none; font-size: 0.9rem; }
    .back-link:hover { color: var(--accent); }
  </style>

  <!--
    Astro's scoped CSS only applies to elements written directly in this file's own
    template, not ones built at runtime via document.createElement() — so the identify
    suggestion card and extra-photo thumbnails built by the shared identify-flow.js module
    (also used by add-price.astro, which duplicates this block verbatim — Astro has no way
    to share a global style block across pages) need their classes global instead.
  -->
  <style is:global>
    .idf-identify-title { font-weight: 600; font-size: 0.9rem; color: var(--accent); }
    .idf-identify-row { display: flex; justify-content: space-between; gap: 0.75rem; font-size: 0.85rem; }
    .idf-identify-label { color: var(--muted); flex-shrink: 0; }
    .idf-identify-value { text-align: right; overflow-wrap: anywhere; }
    .idf-identify-confidence { font-size: 0.78rem; font-weight: 600; }
    .idf-identify-confidence-high { color: #2ecc71; }
    .idf-identify-confidence-medium { color: #f5c542; }
    .idf-identify-confidence-low { color: #e74c3c; }
    .idf-identify-warning { font-size: 0.8rem; color: #e74c3c; }
    .idf-identify-notes { font-size: 0.8rem; color: var(--muted); font-style: italic; overflow-wrap: anywhere; }
    .idf-identify-actions { display: flex; gap: 0.5rem; margin-top: 0.4rem; flex-wrap: wrap; }
    .idf-identify-use-btn {
