  <!--
    Astro's scoped CSS only applies to elements written directly in this file's own
    template — it's added at build time as a data-astro-cid-* attribute, which elements
    created at runtime via document.createElement() never receive, even without
    innerHTML. For a descendant selector like ".seen-list li", the attribute only needs
    to be missing from the rightmost part (the JS-created <li>) for the whole rule to
    stop matching, even though ".seen-list" itself is a static, scoped element. So every
    class used on a JS-built element — the identify suggestion card, the extra-photo
    thumbnails, the "seen before" list rows, the duplicate-name warning, and the Find
    Prices result list — lives here instead, global and prefixed with "ap-" (add-price)
    so it can't collide with another page's classes.
  -->
  <style is:global>
    .ap-identify-title { font-weight: 600; font-size: 0.9rem; color: var(--accent); }
    .ap-identify-row { display: flex; justify-content: space-between; gap: 0.75rem; font-size: 0.85rem; }
    .ap-identify-label { color: var(--muted); flex-shrink: 0; }
    .ap-identify-value { text-align: right; overflow-wrap: anywhere; }
    .ap-identify-confidence { font-size: 0.78rem; font-weight: 600; }
    .ap-identify-confidence-high { color: #2ecc71; }
    .ap-identify-confidence-medium { color: #f5c542; }
    .ap-identify-confidence-low { color: #e74c3c; }
    .ap-identify-warning { font-size: 0.8rem; color: #e74c3c; }
    .ap-identify-notes { font-size: 0.8rem; color: var(--muted); font-style: italic; overflow-wrap: anywhere; }
    .ap-identify-actions { display: flex; gap: 0.5rem; margin-top: 0.4rem; flex-wrap: wrap; }
    .ap-identify-use-btn {
      flex: 1; min-width: 140px; background: var(--accent); color: #fff; border: none;
      padding: 0.5rem 0.75rem; border-radius: 6px; cursor: pointer; font-size: 0.85rem; font-weight: 600;
    }
    .ap-identify-dismiss-btn {
      background: var(--surface); color: var(--muted); border: 1px solid var(--border);
      padding: 0.5rem 0.75rem; border-radius: 6px; cursor: pointer; font-size: 0.85rem;
