---
import Base from '../layouts/Base.astro'
import { fetchProducts, fetchShopGroups, fetchTrips } from '../lib/price-products'
import { PEOPLE_LIST, OWNER } from '../lib/price-entry-fields'

const shopGroups = await fetchShopGroups()
const products = await fetchProducts()
const trips = await fetchTrips()
---
<Base title="Add price">
  <div class="add-wrap">
    <h1>Add price</h1>
    <p class="hint">Log a price you've seen. Shop, category, source and currency stay selected so you can log several prices in a row.</p>

    <div class="field">
      <label>Existing product</label>
      <select id="p-product">
        <option value="">+ New product</option>
        {products.map((p, i) => (
          <option value={i}>{p.productName} ({p.prices.length} price{p.prices.length === 1 ? '' : 's'})</option>
        ))}
      </select>
    </div>

    <div class="field" id="p-seen-wrap" hidden>
      <label>Seen before</label>
      <ul id="p-seen-list" class="seen-list"></ul>
    </div>

    <div class="field">
      <label>Product name *</label>
      <input id="p-name" type="text" placeholder="What is it?" />
      <div id="p-name-warning" class="name-warning" hidden></div>
    </div>

    <div class="field">
      <label>Photo</label>
      <div class="photo-buttons">
        <label class="upload-btn">
          📷 Take photo
          <input id="p-photo-camera" type="file" accept="image/*" capture="environment" hidden />
        </label>
        <label class="upload-btn">
          🖼️ Choose from gallery
          <input id="p-photo-gallery" type="file" accept="image/*" hidden />
        </label>
      </div>
      <span id="p-photo-name" class="photo-name" hidden></span>
      <img id="p-preview" class="photo-preview" hidden alt="Preview" />
      <button id="p-photo-remove" type="button" class="photo-remove-btn" hidden>✕ Remove photo</button>
      <button id="p-identify-btn" type="button" class="identify-btn" hidden>✨ Identify</button>
      <div id="p-extra-photo-buttons" class="extra-photo-buttons" hidden>
        <label class="upload-btn upload-btn-small">
          📷 Camera
          <input id="p-extra-photo-camera" type="file" accept="image/*" capture="environment" hidden />
        </label>
        <label class="upload-btn upload-btn-small">
          🖼️ Gallery
          <input id="p-extra-photo-gallery" type="file" accept="image/*" hidden />
        </label>
      </div>
      <div id="p-extra-photos" class="extra-photos" hidden></div>
      <div id="p-identify-msg" class="identify-msg" hidden></div>
      <div id="p-identify-card" class="identify-card" hidden></div>
    </div>

    <div class="field">
      <label>Japanese name</label>
      <input id="p-name-jp" type="text" placeholder="日本語名（任意）" />
    </div>

    <div class="field">
      <label>JAN / barcode</label>
      <input id="p-jan" type="text" inputmode="numeric" placeholder="8, 12 or 13 digits (optional)" />
    </div>

    <div class="field">
      <label>Category *</label>
      <select id="p-category">
        <option value="">Select category…</option>
        <option value="album">Album</option>
        <option value="game">Game</option>
        <option value="book">Book</option>
        <option value="figure">Merchandise</option>
        <option value="other">Other</option>
      </select>
    </div>

    <div class="field">
      <label>Source</label>
      <div class="radio-row">
        <label class="radio-opt"><input type="radio" name="p-source" value="japanStore" checked /> 🇯🇵 Shop in Japan</label>
        <label class="radio-opt"><input type="radio" name="p-source" value="online" /> 🌐 Online</label>
        <label class="radio-opt"><input type="radio" name="p-source" value="norway" /> 🇳🇴 Norway</label>
      </div>
    </div>

    <div class="field" data-source-for="japanStore">
      <label>Shop *</label>
      {shopGroups.length > 0 ? (
        <select id="p-shop">
          <option value="">Select shop…</option>
          {shopGroups.map((g) => (
            <optgroup label={g.area}>
              {g.shops.map((s) => <option value={s._id}>{s.shopName}</option>)}
            </optgroup>
          ))}
        </select>
      ) : (
        <select id="p-shop"><option value="">No shops saved yet</option></select>
      )}
    </div>

    <div class="field-row" data-source-for="online norway">
      <div class="field">
        <label>Store / site name</label>
        <input id="p-source-name" type="text" placeholder="e.g. CDJapan, Amiami, Outland" />
      </div>
      <div class="field">
        <label>Link</label>
        <input id="p-url" type="url" placeholder="https://…" />
      </div>
    </div>

    <div class="field" id="p-find-prices-wrap" hidden>
      <button id="p-find-prices-btn" type="button" class="find-prices-btn">🔎 Find prices</button>
      <div id="p-find-prices-msg" class="find-prices-msg" hidden></div>
      <div id="p-find-prices-results" class="find-prices-results" hidden></div>
    </div>

    <div class="field-row">
      <div class="field">
        <label>Price *</label>
        <input id="p-price" type="number" inputmode="decimal" min="0" step="any" placeholder="0" />
      </div>
      <div class="field">
        <label>Currency</label>
        <select id="p-currency">
          <option value="JPY">JPY</option>
          <option value="NOK">NOK</option>
          <option value="USD">USD</option>
          <option value="EUR">EUR</option>
        </select>
      </div>
    </div>

    <div class="field checkbox-field" data-currency-for="JPY">
      <label class="checkbox-label"><input id="p-tax" type="checkbox" checked /> Price includes consumption tax</label>
    </div>

    <div class="field">
      <label>Shipping / extra cost</label>
      <input id="p-extra" type="number" inputmode="decimal" min="0" step="any" placeholder="Same currency as price" />
    </div>

    <div class="field">
      <label>Condition</label>
      <select id="p-condition">
        <option value="new">New</option>
        <option value="used">Used</option>
        <option value="used_complete">Used, complete (box/obi)</option>
      </select>
    </div>

    <div class="field">
      <label>Status</label>
      <select id="p-status">
        <option value="considering">Considering</option>
        <option value="bought">Bought</option>
      </select>
    </div>

    <div class="field-row">
      <div class="field">
        <label>Who buys it</label>
        <select id="p-buyer" data-owner={OWNER}>
          {PEOPLE_LIST.map((person) => <option value={person} selected={person === OWNER}>{person}</option>)}
        </select>
      </div>
      <div class="field">
        <label>Trip</label>
        <select id="p-trip">
          <option value="">No trip</option>
          {trips.map((t) => <option value={t._id}>{t.label || 'Trip'}</option>)}
        </select>
      </div>
    </div>
    <p class="hint buyer-trip-hint">Buyer is required to mark as Bought. Trip is optional — can be set now even while Considering, and without one it just won't count toward any trip budget.</p>
    <div id="p-no-trip-note" class="no-trip-note" hidden></div>

    <div class="field">
      <label>Note</label>
      <textarea id="p-note" rows="2" placeholder="Anything worth remembering…"></textarea>
    </div>

    <button id="p-save" type="button" class="save-btn">Save price</button>
    <p id="p-msg" class="save-msg" hidden></p>

    <a href="/add-menu" class="back-link">← Back</a>
  </div>

  <script type="application/json" id="product-data" set:html={JSON.stringify(products)}></script>
  <script type="application/json" id="trips-data" set:html={JSON.stringify(trips)}></script>

  <script is:inline src="/resize-image.js"></script>
  <script is:inline src="/trip-select.js"></script>

  <script>
    const productSel = document.querySelector('#p-product')
    const seenWrap = document.querySelector('#p-seen-wrap')
    const seenList = document.querySelector('#p-seen-list')
    let PRODUCTS = []
    try {
      PRODUCTS = JSON.parse(document.querySelector('#product-data')?.textContent || '[]')
    } catch (e) { PRODUCTS = [] }
    let TRIPS = []
    try {
      TRIPS = JSON.parse(document.querySelector('#trips-data')?.textContent || '[]')
    } catch (e) { TRIPS = [] }

    const nameInput = document.querySelector('#p-name')
    const nameWarning = document.querySelector('#p-name-warning')
    const CATEGORY_LABELS = { album: 'Album', game: 'Game', book: 'Book', figure: 'Merchandise', other: 'Other' }
    const photoCamera = document.querySelector('#p-photo-camera')
    const photoGallery = document.querySelector('#p-photo-gallery')
    const photoName = document.querySelector('#p-photo-name')
    const preview = document.querySelector('#p-preview')
    const photoRemoveBtn = document.querySelector('#p-photo-remove')
    const identifyBtn = document.querySelector('#p-identify-btn')
    const identifyMsg = document.querySelector('#p-identify-msg')
    const identifyCard = document.querySelector('#p-identify-card')
    const extraPhotoButtons = document.querySelector('#p-extra-photo-buttons')
    const extraPhotoCamera = document.querySelector('#p-extra-photo-camera')
    const extraPhotoGallery = document.querySelector('#p-extra-photo-gallery')
    const extraPhotosWrap = document.querySelector('#p-extra-photos')
    const MAX_EXTRA_PHOTOS = 2
    let extraPhotos = [] // { file, url }[] — identify-only, never uploaded to Sanity
    let suggestionShown = false // true while an AI suggestion card is on screen
    let selectedPhoto = null
    let reusedImage = null
    const nameJpInput = document.querySelector('#p-name-jp')
    const janInput = document.querySelector('#p-jan')
    const categorySel = document.querySelector('#p-category')
    const sourceRadios = document.querySelectorAll('input[name="p-source"]')
    const shopSel = document.querySelector('#p-shop')
    const sourceNameInput = document.querySelector('#p-source-name')
    const urlInput = document.querySelector('#p-url')
    const findPricesWrap = document.querySelector('#p-find-prices-wrap')
    const findPricesBtn = document.querySelector('#p-find-prices-btn')
    const findPricesMsg = document.querySelector('#p-find-prices-msg')
    const findPricesResultsWrap = document.querySelector('#p-find-prices-results')
    const priceInput = document.querySelector('#p-price')
    const currencySel = document.querySelector('#p-currency')
    const taxCheckbox = document.querySelector('#p-tax')
    const extraInput = document.querySelector('#p-extra')
    const conditionSel = document.querySelector('#p-condition')
    const statusSel = document.querySelector('#p-status')
    const buyerSel = document.querySelector('#p-buyer')
    const tripSel = document.querySelector('#p-trip')
    const noTripNote = document.querySelector('#p-no-trip-note')
    const noteInput = document.querySelector('#p-note')
    const saveBtn = document.querySelector('#p-save')
    const msg = document.querySelector('#p-msg')

    function currentSource() {
      const checked = document.querySelector('input[name="p-source"]:checked')
      return checked ? checked.value : 'japanStore'
    }

    function applySource() {
      const src = currentSource()
      document.querySelectorAll('[data-source-for]').forEach((el) => {
        const vals = el.getAttribute('data-source-for').split(' ')
        el.hidden = !vals.includes(src)
      })
      updateFindPricesVisibility()
    }
    sourceRadios.forEach((r) => r.addEventListener('change', applySource))

    // Only offered for online/Norway sources (a Japan shop price is already in hand by
    // definition), and only once there's enough to search for. Never automatic.
    function updateFindPricesVisibility() {
      const src = currentSource()
      const eligible = (src === 'online' || src === 'norway') && !!nameInput.value.trim() && !!categorySel.value
      findPricesWrap.hidden = !eligible
    }
    nameInput.addEventListener('input', updateFindPricesVisibility)
    categorySel.addEventListener('change', updateFindPricesVisibility)
    applySource()

    function applyCurrency() {
      const cur = currencySel.value
      document.querySelectorAll('[data-currency-for]').forEach((el) => {
        const vals = el.getAttribute('data-currency-for').split(' ')
        el.hidden = !vals.includes(cur)
      })
    }
    currencySel.addEventListener('change', applyCurrency)
    applyCurrency()

    const LAST_TRIP_KEY = 'ff-last-trip'
    let initialTripId = ''
    try { initialTripId = localStorage.getItem(LAST_TRIP_KEY) || '' } catch (e) {}
    applyBuyerTripFilter(tripSel, TRIPS, buyerSel.value, noTripNote, initialTripId)
    buyerSel.addEventListener('change', () => applyBuyerTripFilter(tripSel, TRIPS, buyerSel.value, noTripNote))
    function rememberTrip() {
      try { localStorage.setItem(LAST_TRIP_KEY, tripSel.value) } catch (e) {}
    }

    function revokeIfBlob() {
      if (preview.src && preview.src.indexOf('blob:') === 0) { try { URL.revokeObjectURL(preview.src) } catch (e) {} }
    }

    function hideIdentifyMsg() {
      identifyMsg.hidden = true
      identifyMsg.textContent = ''
    }
    function hideIdentifyCard() {
      identifyCard.hidden = true
      identifyCard.replaceChildren()
      suggestionShown = false
    }

    // Extra photos are identify-only — never uploaded to Sanity, never part of the
    // saved priceEntry. Each is kept as { file, url } so the object URL is created once
    // (on add) and reused on every re-render, rather than re-created and leaked.
    function renderExtraPhotos() {
      extraPhotosWrap.replaceChildren()
      extraPhotos.forEach((p, idx) => {
        const item = document.createElement('div')
        item.className = 'ap-extra-photo-item'
        const img = document.createElement('img')
        img.className = 'ap-extra-photo-thumb'
        img.src = p.url
        img.alt = 'Extra photo ' + (idx + 1)
        const removeBtn = document.createElement('button')
        removeBtn.type = 'button'
        removeBtn.className = 'ap-extra-photo-remove'
        removeBtn.textContent = '✕'
        removeBtn.addEventListener('click', () => removeExtraPhoto(idx))
        item.appendChild(img)
        item.appendChild(removeBtn)
        extraPhotosWrap.appendChild(item)
      })
      extraPhotosWrap.hidden = extraPhotos.length === 0
      extraPhotoButtons.hidden = !selectedPhoto || extraPhotos.length >= MAX_EXTRA_PHOTOS
    }
    function addExtraPhoto(file) {
      if (extraPhotos.length >= MAX_EXTRA_PHOTOS) return
      extraPhotos.push({ file, url: URL.createObjectURL(file) })
      renderExtraPhotos()
      // The suggestion card already on screen was built without this photo — nudge
      // toward re-running Identify rather than silently leaving it out.
      if (suggestionShown) showIdentifyMsg('New photo added. Tap Identify again to include it.', true)
    }
    function removeExtraPhoto(idx) {
      const [removed] = extraPhotos.splice(idx, 1)
      if (removed) { try { URL.revokeObjectURL(removed.url) } catch (e) {} }
      renderExtraPhotos()
    }
    function clearExtraPhotos() {
      extraPhotos.forEach((p) => { try { URL.revokeObjectURL(p.url) } catch (e) {} })
      extraPhotos = []
      renderExtraPhotos()
    }
    function handleExtraPhotoInput(input) {
      const file = input.files && input.files[0]
      input.value = ''
      if (file) addExtraPhoto(file)
    }
    extraPhotoCamera.addEventListener('change', () => handleExtraPhotoInput(extraPhotoCamera))
    extraPhotoGallery.addEventListener('change', () => handleExtraPhotoInput(extraPhotoGallery))

    // Decides what the preview area shows: a freshly taken/chosen photo always wins;
    // otherwise an existing product's photo (if one was selected); otherwise nothing.
    // "Identify" (and the extra-photos button) only apply to a freshly taken/chosen
    // photo — reusing a product's existing photo means you already know what it is.
    function updatePhotoPreview() {
      if (selectedPhoto) {
        preview.hidden = false
        photoRemoveBtn.hidden = false
        identifyBtn.hidden = false
        renderExtraPhotos()
        return
      }
      if (reusedImage && reusedImage.url) {
        revokeIfBlob()
        preview.src = reusedImage.url
        preview.hidden = false
        photoName.hidden = false
        photoName.textContent = 'Using existing photo'
        photoRemoveBtn.hidden = false
        identifyBtn.hidden = true
        renderExtraPhotos()
        return
      }
      preview.hidden = true
      preview.src = ''
      photoName.hidden = true
      photoRemoveBtn.hidden = true
      identifyBtn.hidden = true
      renderExtraPhotos()
    }

    async function handlePhoto(fileInput) {
      const file = fileInput.files && fileInput.files[0]
      if (!file) return
      reusedImage = null
      hideIdentifyMsg()
      hideIdentifyCard()
      clearExtraPhotos()
      photoName.hidden = false
      photoName.textContent = 'Processing photo…'
      let chosen = file
      try {
        if (window.resizeImage) chosen = await window.resizeImage(file, 1600, 0.85)
      } catch (e) { chosen = file }
      selectedPhoto = chosen
      revokeIfBlob()
      preview.src = URL.createObjectURL(chosen)
      photoName.textContent = file.name || 'photo'
      updatePhotoPreview()
      fileInput.value = ''
    }
    photoCamera.addEventListener('change', () => handlePhoto(photoCamera))
    photoGallery.addEventListener('change', () => handlePhoto(photoGallery))

    function resetPhoto() {
      revokeIfBlob()
      selectedPhoto = null
      reusedImage = null
      photoCamera.value = ''
      photoGallery.value = ''
      photoName.textContent = ''
      hideIdentifyMsg()
      hideIdentifyCard()
      clearExtraPhotos()
      updatePhotoPreview()
    }
    photoRemoveBtn.addEventListener('click', resetPhoto)

    function fileToBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader()
        reader.onload = () => {
          const result = reader.result || ''
          const commaIdx = result.indexOf(',')
          resolve(commaIdx >= 0 ? result.slice(commaIdx + 1) : result)
        }
        reader.onerror = () => reject(reader.error)
        reader.readAsDataURL(file)
      })
    }

    function showIdentifyMsg(text, ok) {
      identifyMsg.hidden = false
      identifyMsg.textContent = text
      identifyMsg.style.color = ok ? '#2ecc71' : '#e74c3c'
    }

    function renderIdentifyCard(result) {
      identifyCard.replaceChildren()

      const title = document.createElement('div')
      title.className = 'ap-identify-title'
      title.textContent = '✨ AI suggestion'
      identifyCard.appendChild(title)

      function addRow(label, value) {
        if (value == null || value === '') return
        const row = document.createElement('div')
        row.className = 'ap-identify-row'
        const l = document.createElement('span')
        l.className = 'ap-identify-label'
        l.textContent = label
        const v = document.createElement('span')
        v.className = 'ap-identify-value'
        v.textContent = value
        row.appendChild(l)
        row.appendChild(v)
        identifyCard.appendChild(row)
      }

      addRow('Name', result.productName)
      addRow('Japanese', result.productNameJp)
      addRow('JAN', result.jan)
      addRow('Category', result.category ? (CATEGORY_LABELS[result.category] || result.category) : null)
      if (typeof result.price === 'number') {
        const taxText = result.taxIncluded === true ? 'tax included' : result.taxIncluded === false ? 'tax excluded' : ''
        addRow('Price', '¥' + result.price.toLocaleString('en-US') + (taxText ? ' (' + taxText + ')' : ''))
      }

      if (result.confidence) {
        const conf = document.createElement('div')
        conf.className = 'ap-identify-confidence ap-identify-confidence-' + result.confidence
        conf.textContent = 'Confidence: ' + result.confidence
        identifyCard.appendChild(conf)
        if (result.confidence === 'low') {
          const warn = document.createElement('div')
          warn.className = 'ap-identify-warning'
          warn.textContent = '⚠️ Low confidence — double-check before using.'
          identifyCard.appendChild(warn)
        }
      }

      if (result.notes) {
        const notes = document.createElement('div')
        notes.className = 'ap-identify-notes'
        notes.textContent = result.notes
        identifyCard.appendChild(notes)
      }

      const actions = document.createElement('div')
      actions.className = 'ap-identify-actions'

      // A JAN match against an already-logged product offers linking to it instead of
      // filling in the (possibly slightly different) suggested details as a new product.
      let existingIdx = -1
      if (result.jan) existingIdx = PRODUCTS.findIndex((p) => p.jan === result.jan)

      const useBtn = document.createElement('button')
      useBtn.type = 'button'
      useBtn.className = 'ap-identify-use-btn'
      if (existingIdx >= 0) {
        useBtn.textContent = 'Use existing product: ' + PRODUCTS[existingIdx].productName
        useBtn.addEventListener('click', () => {
          productSel.value = String(existingIdx)
          applyProduct()
          hideIdentifyCard()
        })
      } else {
        useBtn.textContent = 'Use suggestion'
        useBtn.addEventListener('click', () => {
          if (result.productName) nameInput.value = result.productName
          if (result.productNameJp) nameJpInput.value = result.productNameJp
          if (result.jan) janInput.value = result.jan
          if (result.category) categorySel.value = result.category
          if (typeof result.price === 'number') {
            priceInput.value = String(result.price)
            currencySel.value = 'JPY'
            applyCurrency()
            if (typeof result.taxIncluded === 'boolean') taxCheckbox.checked = result.taxIncluded
          }
          checkNameDuplicate()
          updateFindPricesVisibility()
          hideIdentifyCard()
        })
      }

      const dismissBtn = document.createElement('button')
      dismissBtn.type = 'button'
      dismissBtn.className = 'ap-identify-dismiss-btn'
      dismissBtn.textContent = 'Dismiss'
      dismissBtn.addEventListener('click', hideIdentifyCard)

      actions.appendChild(useBtn)
      actions.appendChild(dismissBtn)
      identifyCard.appendChild(actions)

      identifyCard.hidden = false
      suggestionShown = true
    }

    async function identifyPhoto() {
      if (!selectedPhoto) return
      hideIdentifyCard()
      hideIdentifyMsg()
      identifyBtn.disabled = true
      identifyBtn.textContent = 'Identifying…'
      try {
        // Downscale further just for the API call — the photos already selected for
        // upload/saving (or kept only for identify) are untouched. The product photo
        // always goes first; extra photos are additional angles of the same item.
        const allPhotos = [selectedPhoto, ...extraPhotos.map((p) => p.file)]
        const images = []
        for (const photo of allPhotos) {
          let forApi = photo
          try {
            if (window.resizeImage) forApi = await window.resizeImage(photo, 1024, 0.8)
          } catch (e) {}
          images.push(await fileToBase64(forApi))
        }
        const res = await fetch('/api/identify-product', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ images }),
        })
        const data = await res.json().catch(() => null)
        if (!res.ok) {
          showIdentifyMsg((data && data.error) || 'Identification failed.', false)
          return
        }
        if (!data.result || Object.keys(data.result).length === 0) {
          showIdentifyMsg('Could not identify anything useful in this photo.', false)
          return
        }
        renderIdentifyCard(data.result)
      } catch (e) {
        showIdentifyMsg('Network error.', false)
      } finally {
        identifyBtn.disabled = false
        identifyBtn.textContent = '✨ Identify'
      }
    }
    identifyBtn.addEventListener('click', identifyPhoto)

    function productKey(jan, name) {
      const j = (jan || '').trim()
      if (j) return j
      return String(name || '').trim().toLowerCase()
    }

    function formatPrice(price, currency) {
      const n = typeof price === 'number' ? price : Number(price)
      return (isNaN(n) ? price : n.toLocaleString('en-US')) + ' ' + (currency || '')
    }

    function renderSeenList(prices) {
      seenList.replaceChildren()
      if (!prices || prices.length === 0) { seenWrap.hidden = true; return }
      seenWrap.hidden = false
      prices.forEach((p) => {
        const li = document.createElement('li')
        li.className = 'ap-seen-item'

        const main = document.createElement('div')
        main.className = 'ap-seen-main'
        const left = document.createElement('span')
        left.className = 'ap-seen-source'
        left.textContent = p.source
        const right = document.createElement('span')
        right.className = 'ap-seen-price'
        right.textContent = formatPrice(p.price, p.currency)
        main.appendChild(left)
        main.appendChild(right)
        li.appendChild(main)

        if (p.note) {
          const note = document.createElement('div')
          note.className = 'ap-seen-note'
          note.textContent = p.note
          li.appendChild(note)
        }

        seenList.appendChild(li)
      })
    }

    function hideNameWarning() {
      nameWarning.hidden = true
      nameWarning.replaceChildren()
    }

    function renderNameWarning(matches) {
      nameWarning.replaceChildren()
      matches.forEach(({ product, idx }) => {
        const row = document.createElement('div')
        row.className = 'ap-name-warning-row'

        const text = document.createElement('span')
        const catLabel = CATEGORY_LABELS[product.category] || product.category || 'Other'
        const n = product.prices.length
        text.textContent = `${product.productName} already exists (${catLabel}, ${n} price${n === 1 ? '' : 's'})`

        const btn = document.createElement('button')
        btn.type = 'button'
        btn.className = 'ap-use-existing-btn'
        btn.textContent = 'Use existing'
        btn.addEventListener('click', () => {
          productSel.value = String(idx)
          applyProduct()
        })

        row.appendChild(text)
        row.appendChild(btn)
        nameWarning.appendChild(row)
      })
      nameWarning.hidden = false
    }

    // Only relevant while creating a brand-new product — once an existing one is
    // selected there's nothing to warn about.
    function checkNameDuplicate() {
      if (productSel.value !== '') { hideNameWarning(); return }
      const typed = nameInput.value.trim().toLowerCase()
      if (!typed) { hideNameWarning(); return }
      const matches = PRODUCTS
        .map((product, idx) => ({ product, idx }))
        .filter(({ product }) => product.productName.trim().toLowerCase() === typed)
      if (matches.length === 0) { hideNameWarning(); return }
      renderNameWarning(matches)
    }
    let nameCheckTimer = null
    nameInput.addEventListener('input', () => {
      clearTimeout(nameCheckTimer)
      nameCheckTimer = setTimeout(checkNameDuplicate, 300)
    })
    nameInput.addEventListener('blur', checkNameDuplicate)

    function applyProduct() {
      const idx = productSel.value
      resetPhoto()
      hideNameWarning()
      if (idx === '') {
        nameInput.value = ''
        nameJpInput.value = ''
        janInput.value = ''
        categorySel.value = ''
        renderSeenList([])
        updateFindPricesVisibility()
        return
      }
      const product = PRODUCTS[Number(idx)]
      if (!product) return
      nameInput.value = product.productName || ''
      nameJpInput.value = product.productNameJp || ''
      janInput.value = product.jan || ''
      categorySel.value = product.category || ''
      renderSeenList(product.prices)
      if (product.image && product.image.url) {
        reusedImage = product.image
        updatePhotoPreview()
      }
      updateFindPricesVisibility()
    }
    productSel.addEventListener('change', applyProduct)

    // Arriving from /prices via "+ Add price" — preselect that product exactly as if
    // it had been chosen in the select itself.
    const preselectKey = new URLSearchParams(window.location.search).get('product')
    if (preselectKey) {
      const preselectIdx = PRODUCTS.findIndex((p) => p.key === preselectKey)
      if (preselectIdx >= 0) {
        productSel.value = String(preselectIdx)
        applyProduct()
      }
    }

    function showMsg(text, ok) {
      msg.hidden = false
      msg.textContent = text
      msg.style.color = ok ? '#2ecc71' : '#e74c3c'
    }

    // Shop/source display label for the in-page "Seen before" cache — mirrors the
    // server's grouping logic in the frontmatter exactly (japanStore -> shop name,
    // otherwise the typed source name, falling back to a generic label).
    function currentSourceLabel(source) {
      if (source === 'japanStore') {
        const opt = shopSel.options[shopSel.selectedIndex]
        return (opt && opt.value) ? opt.text : 'Shop'
      }
      return sourceNameInput.value.trim() || (source === 'norway' ? 'Norway' : 'Online')
    }

    function rememberSavedPrice(productName, jan, category, priceRow, uploadedImage) {
      const key = productKey(jan, productName)
      const idx = PRODUCTS.findIndex((p) => p.key === key)
      if (idx >= 0) {
        PRODUCTS[idx].prices.unshift(priceRow)
        if (uploadedImage) PRODUCTS[idx].image = uploadedImage
        const optionEl = productSel.querySelector('option[value="' + idx + '"]')
        if (optionEl) {
          const n = PRODUCTS[idx].prices.length
          optionEl.textContent = PRODUCTS[idx].productName + ' (' + n + ' price' + (n === 1 ? '' : 's') + ')'
        }
        return
      }
      PRODUCTS.push({
        key,
        productName,
        productNameJp: nameJpInput.value.trim() || undefined,
        jan: jan || undefined,
        category,
        image: uploadedImage || null,
        prices: [priceRow],
      })
      const newIdx = PRODUCTS.length - 1
      const option = document.createElement('option')
      option.value = String(newIdx)
      option.textContent = productName + ' (1 price)'
      productSel.appendChild(option)
    }

    // Re-renders the on-screen "Seen before" list for whichever product the name/jan
    // currently resolve to — used after a quick "Log" from Find Prices so the new price
    // shows up immediately, since rememberSavedPrice() only mutates the PRODUCTS array
    // and doesn't touch the DOM itself.
    function refreshSeenListForCurrentProduct() {
      const key = productKey(janInput.value.trim(), nameInput.value.trim())
      const idx = PRODUCTS.findIndex((p) => p.key === key)
      if (idx >= 0) renderSeenList(PRODUCTS[idx].prices)
    }

    function showFindPricesMsg(text, ok) {
      findPricesMsg.hidden = false
      findPricesMsg.textContent = text
      findPricesMsg.style.color = ok ? 'var(--muted)' : '#e74c3c'
    }
    function hideFindPricesMsg() {
      findPricesMsg.hidden = true
      findPricesMsg.textContent = ''
    }

    async function logFoundPrice(result, region, btn) {
      const productName = nameInput.value.trim()
      if (!productName || !categorySel.value) return
      btn.disabled = true
      btn.textContent = 'Logging…'
      try {
        const res = await fetch('/api/price-entry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productName,
            productNameJp: nameJpInput.value.trim() || undefined,
            jan: janInput.value.trim() || undefined,
            category: categorySel.value,
            // The region actually searched for this result, not whatever the source
            // radio currently shows — the user could switch Online<->Norway after
            // searching (the results stay visible either way) and tap Log afterward,
            // which would otherwise silently save the wrong sourceType for this result.
            sourceType: region,
            sourceName: result.store,
            url: result.url,
            price: result.price,
            currency: result.currency,
            note: result.note || undefined,
            // Reuse the existing product's photo if one is selected — a quick "Log" from
            // search results never uploads a new photo of its own.
            imageAssetId: (!selectedPhoto && reusedImage) ? reusedImage.assetId : undefined,
          }),
        })
        const data = await res.json().catch(() => null)
        if (!res.ok) {
          btn.disabled = false
          btn.textContent = '➕ Log'
          showFindPricesMsg((data && data.error) || 'Logging failed.', false)
          return
        }
        btn.textContent = 'Logged ✓'
        rememberSavedPrice(
          productName,
          janInput.value.trim(),
          categorySel.value,
          { source: result.store, price: result.price, currency: result.currency, note: result.note },
          null
        )
        refreshSeenListForCurrentProduct()
      } catch (e) {
        btn.disabled = false
        btn.textContent = '➕ Log'
        showFindPricesMsg('Network error.', false)
      }
    }

    function renderFindPricesResults(results, region) {
      findPricesResultsWrap.replaceChildren()

      const note = document.createElement('p')
      note.className = 'ap-find-prices-note'
      note.textContent = 'Prices found by AI search. Check the link before relying on them. Shipping and import VAT not included.'
      findPricesResultsWrap.appendChild(note)

      const list = document.createElement('ul')
      list.className = 'ap-find-prices-list'

      results.forEach((r) => {
        const li = document.createElement('li')
        li.className = 'ap-find-prices-item'

        const main = document.createElement('div')
        main.className = 'ap-find-prices-main'
        const store = document.createElement('span')
        store.className = 'ap-find-prices-store'
        store.textContent = r.store
        const price = document.createElement('span')
        price.className = 'ap-find-prices-price'
        price.textContent = formatPrice(r.price, r.currency)
        main.appendChild(store)
        main.appendChild(price)
        li.appendChild(main)

        const metaBits = []
        if (r.inStock === true) metaBits.push('In stock')
        else if (r.inStock === false) metaBits.push('Out of stock')
        if (r.note) metaBits.push(r.note)
        if (metaBits.length > 0) {
          const meta = document.createElement('div')
          meta.className = 'ap-find-prices-meta'
          meta.textContent = metaBits.join(' · ')
          li.appendChild(meta)
        }

        const link = document.createElement('a')
        link.className = 'ap-find-prices-link'
        link.href = r.url
        link.target = '_blank'
        link.rel = 'noopener noreferrer'
        link.textContent = r.url
        li.appendChild(link)

        const actions = document.createElement('div')
        actions.className = 'ap-find-prices-actions'

        const logBtn = document.createElement('button')
        logBtn.type = 'button'
        logBtn.className = 'ap-find-prices-log-btn'
        logBtn.textContent = '➕ Log'
        logBtn.addEventListener('click', () => logFoundPrice(r, region, logBtn))

        actions.appendChild(logBtn)
        li.appendChild(actions)

        list.appendChild(li)
      })

      findPricesResultsWrap.appendChild(list)
      findPricesResultsWrap.hidden = false
    }

    async function findPrices() {
      hideFindPricesMsg()
      findPricesResultsWrap.replaceChildren()
      findPricesResultsWrap.hidden = true
      findPricesBtn.disabled = true
      findPricesBtn.textContent = 'Searching…'
      showFindPricesMsg('Searching shops… this can take up to a minute.', true)
      // Fixed for this search — if the user flips the source radio afterward (the
      // results stay visible for either Online or Norway), "Log" must still save under
      // the region these specific results were actually found for.
      const region = currentSource()
      try {
        const res = await fetch('/api/find-prices', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productName: nameInput.value.trim(),
            productNameJp: nameJpInput.value.trim() || undefined,
            jan: janInput.value.trim() || undefined,
            category: categorySel.value,
            region,
          }),
        })
        const data = await res.json().catch(() => null)
        if (!res.ok) {
          showFindPricesMsg((data && data.error) || 'Search failed.', false)
          return
        }
        if (!data.results || data.results.length === 0) {
          showFindPricesMsg('No reliable prices found.', false)
          return
        }
        hideFindPricesMsg()
        renderFindPricesResults(data.results, region)
      } catch (e) {
        showFindPricesMsg('Network error.', false)
      } finally {
        findPricesBtn.disabled = false
        findPricesBtn.textContent = '🔎 Find prices'
      }
    }
    findPricesBtn.addEventListener('click', findPrices)

    async function save() {
      const productName = nameInput.value.trim()
      if (!productName) return showMsg('Please enter a product name.', false)
      if (!categorySel.value) return showMsg('Please select a category.', false)
      const priceVal = priceInput.value
      if (priceVal === '' || isNaN(Number(priceVal)) || Number(priceVal) < 0) {
        return showMsg('Please enter a valid price.', false)
      }

      const source = currentSource()
      const jan = janInput.value.trim()
      const category = categorySel.value
      const sourceLabel = currentSourceLabel(source)
      const markingBought = statusSel.value === 'bought'

      if (markingBought) {
        if (!buyerSel.value) return showMsg('Please choose who bought it.', false)
        // Trip is optional — only a familyPurchase (needs a trip) or a collection item
        // (owner only) actually records an amount, so only those cases need JPY/NOK.
        const willCreateSomething = !!tripSel.value || buyerSel.value === buyerSel.dataset.owner
        if (willCreateSomething && currencySel.value !== 'JPY' && currencySel.value !== 'NOK') {
          return showMsg('Mark as Bought requires the price to be in JPY or NOK. Please enter the price in NOK.', false)
        }
      }

      saveBtn.disabled = true
      saveBtn.textContent = 'Saving…'

      try {
        // Always created as Considering — the Bought transition (and the familyPurchase/
        // collection-item side effects it triggers) only ever runs through
        // /api/price-entry-update, so that logic is never duplicated here.
        const res = await fetch('/api/price-entry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productName,
            productNameJp: nameJpInput.value.trim() || undefined,
            jan: jan || undefined,
            category,
            sourceType: source,
            shopId: source === 'japanStore' ? (shopSel.value || undefined) : undefined,
            sourceName: source !== 'japanStore' ? (sourceNameInput.value.trim() || undefined) : undefined,
            url: source !== 'japanStore' ? (urlInput.value.trim() || undefined) : undefined,
            price: priceVal,
            currency: currencySel.value,
            taxIncluded: currencySel.value === 'JPY' ? taxCheckbox.checked : undefined,
            extraCost: extraInput.value || undefined,
            condition: conditionSel.value,
            buyer: buyerSel.value || undefined,
            tripId: tripSel.value || undefined,
            note: noteInput.value.trim() || undefined,
            // A freshly taken photo always wins — only reuse the existing product's
            // photo when no new one was chosen for this entry.
            imageAssetId: (!selectedPhoto && reusedImage) ? reusedImage.assetId : undefined,
          }),
        })
        const data = await res.json()
        if (!res.ok) {
          showMsg(data.error || 'Save failed.', false)
          return
        }

        // Upload the photo (if any) after the entry exists, so a failed upload never
        // costs you the price entry itself. Must happen before the Bought call below,
        // so the familyPurchase/collection item it may create can see the photo too.
        let photoFailed = false
        let uploadedImage = null
        if (selectedPhoto && data.id) {
          saveBtn.textContent = 'Uploading photo…'
          try {
            const form = new FormData()
            form.append('file', selectedPhoto)
            form.append('docId', data.id)
            form.append('field', 'image')
            const upRes = await fetch('/api/upload-image', { method: 'POST', body: form })
            if (!upRes.ok) {
              photoFailed = true
            } else {
              const upData = await upRes.json().catch(() => null)
              if (upData && upData.assetId && upData.url) uploadedImage = { assetId: upData.assetId, url: upData.url }
            }
          } catch (e) {
            photoFailed = true
          }
        }

        let boughtError = null
        if (markingBought && data.id) {
          try {
            const boughtRes = await fetch('/api/price-entry-update', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                id: data.id,
                status: 'bought',
                buyer: buyerSel.value,
                tripId: tripSel.value,
                sourceType: source,
                shopId: source === 'japanStore' ? (shopSel.value || undefined) : undefined,
                sourceName: source !== 'japanStore' ? (sourceNameInput.value.trim() || undefined) : undefined,
                url: source !== 'japanStore' ? (urlInput.value.trim() || undefined) : undefined,
                price: priceVal,
                currency: currencySel.value,
                taxIncluded: currencySel.value === 'JPY' ? taxCheckbox.checked : undefined,
                extraCost: extraInput.value || undefined,
                condition: conditionSel.value,
                note: noteInput.value.trim() || undefined,
              }),
            })
            const boughtData = await boughtRes.json().catch(() => null)
            if (!boughtRes.ok) boughtError = (boughtData && boughtData.error) || 'Unknown error'
          } catch (e) {
            boughtError = 'Network error'
          }
        }

        if (boughtError) {
          showMsg(`Price saved as Considering, but marking it as bought failed: ${boughtError}. Open it from All prices to try again.`, false)
        } else if (photoFailed) {
          showMsg('Price saved, but the photo upload failed — saved without it.', false)
        } else {
          showMsg('Saved ✓ — ready for the next one.', true)
        }

        rememberSavedPrice(
          productName,
          jan,
          category,
          { source: sourceLabel, price: Number(priceVal), currency: currencySel.value, note: noteInput.value.trim() || undefined },
          uploadedImage
        )
        rememberTrip()

        // Keep shop/category/source/currency/condition/buyer/trip selected — logging
        // several prices in a row (often for the same trip/buyer) is the common case.
        // Status resets since "bought" shouldn't carry over to the next item. Only clear
        // the per-item fields otherwise.
        nameInput.value = ''
        nameJpInput.value = ''
        janInput.value = ''
        priceInput.value = ''
        extraInput.value = ''
        noteInput.value = ''
        statusSel.value = 'considering'
        productSel.value = ''
        renderSeenList([])
        resetPhoto()
        hideNameWarning()
        nameInput.focus()
      } catch (e) {
        showMsg('Network error.', false)
      } finally {
        saveBtn.disabled = false
        saveBtn.textContent = 'Save price'
      }
    }

    saveBtn.addEventListener('click', save)
  </script>

