---
import Base from '../layouts/Base.astro'
import { sanity } from '../lib/sanity'

const trips = await sanity.fetch(
  `*[_type == "tripSettings"] | order(_createdAt asc) { _id, label }`
)

const usedAreas: string[] = await sanity.fetch(
  `array::unique(*[_type == "shopNote" && defined(area)].area)`
)
const DEFAULT_AREAS = ['Akihabara', 'Ikebukuro', 'Nakano', 'Shinjuku', 'Shibuya', 'Other']
const areaOptions = [...new Set([...DEFAULT_AREAS, ...(usedAreas || [])])].filter(Boolean).sort()
---
<Base title="Add shop">
  <div class="add-wrap">
    <h1>Add shop</h1>
    <p class="hint">Save a shop with an optional pinned location. Use “Use my location” while you're standing there, or paste coordinates from Google Maps.</p>

    <div class="field">
      <label>Shop / Place *</label>
      <input id="s-name" type="text" placeholder="Shop name" />
    </div>

    <div class="field" id="s-ai-fill-wrap">
      <button id="s-ai-fill-btn" type="button" class="ai-fill-btn">✨ Fill in from web</button>
      <p id="s-ai-fill-msg" class="ai-fill-msg" hidden></p>
      <div id="s-ai-fill-results" class="ai-fill-results" hidden></div>
    </div>

    <div class="field">
      <label>Type</label>
      <select id="s-type">
        <option value="shop">🛍️ Shop</option>
        <option value="restaurant">🍜 Restaurant</option>
        <option value="sight">🗼 Sight to see</option>
        <option value="other">📌 Other</option>
      </select>
    </div>

    {trips.length > 0 && (
      <div class="field">
        <label>Trips</label>
        <div class="trip-checks">
          {trips.map((t: any) => (
            <label class="trip-check">
              <input type="checkbox" class="s-trip" value={t._id} />
              <span>{t.label || 'Trip'}</span>
            </label>
          ))}
        </div>
      </div>
    )}

    <div class="field">
      <label>Area</label>
      <select id="s-area">
        <option value="">Select area…</option>
        {areaOptions.map((a) => <option value={a}>{a}</option>)}
        <option value="__new__">+ New area…</option>
      </select>
      <input id="s-area-new" type="text" placeholder="New area name" hidden style="margin-top:0.5rem" />
    </div>

    <div class="field">
      <label>Opening hours</label>
      <input id="s-hours" type="text" placeholder="e.g. 10:00–20:00, closed Tue (Japan time)" />
    </div>

    <div class="field">
      <label>Note</label>
      <textarea id="s-note" rows="3" placeholder="What's here, what to look for…"></textarea>
    </div>

    <div class="field">
      <label>Priority</label>
      <select id="s-priority">
        <option value="maybe">Worth a look</option>
        <option value="must">Must visit</option>
        <option value="visited">Visited</option>
      </select>
    </div>

    <div class="field">
      <label>Tax-free shop</label>
      <select id="s-taxfree">
        <option value="" selected>Unknown</option>
        <option value="true">Yes</option>
        <option value="false">No</option>
      </select>
    </div>

    <div class="field">
      <label>Website</label>
      <input id="s-website" type="url" placeholder="https://…" />
    </div>

    <div class="field">
      <label>Address / how to find</label>
      <input id="s-address" type="text" placeholder="Floor, landmark, directions…" />
      <a id="s-map-link" class="map-open-btn" href="#" target="_blank" rel="noopener">🗺️ Open in Maps</a>
    </div>

    <div class="field">
      <label>Coordinates</label>
      <div class="coord-paste">
        <input id="s-coord-paste" type="text" placeholder="Paste “lat, lng” from Google Maps" />
        <button id="s-coord-apply" type="button" class="coord-apply-btn">Apply</button>
      </div>
      <div class="coord-fields">
        <input id="s-lat" type="text" inputmode="decimal" placeholder="Latitude" />
        <input id="s-lng" type="text" inputmode="decimal" placeholder="Longitude" />
      </div>
      <button id="s-locate" type="button" class="locate-btn">📍 Use my location</button>
      <p id="s-coords" class="coords" hidden></p>
      <p id="s-locate-msg" class="locate-msg" hidden></p>
    </div>

    <button id="s-save" type="button" class="save-btn">Save shop</button>
    <p id="s-msg" class="save-msg" hidden></p>

    <a href="/notes" class="back-link">← Back to shop notes</a>
  </div>

  <script>
    const nameInput = document.querySelector('#s-name')
    const typeSel = document.querySelector('#s-type')
    const areaSel = document.querySelector('#s-area')
    const areaNewInput = document.querySelector('#s-area-new')
    const hoursInput = document.querySelector('#s-hours')
    const noteInput = document.querySelector('#s-note')
    const prioritySel = document.querySelector('#s-priority')
    const taxFreeSel = document.querySelector('#s-taxfree')
    const websiteInput = document.querySelector('#s-website')
    const addressInput = document.querySelector('#s-address')
    const mapLink = document.querySelector('#s-map-link')
    const coordPaste = document.querySelector('#s-coord-paste')
    const coordApply = document.querySelector('#s-coord-apply')
    const latInput = document.querySelector('#s-lat')
    const lngInput = document.querySelector('#s-lng')
    const locateBtn = document.querySelector('#s-locate')
    const coords = document.querySelector('#s-coords')
    const locateMsg = document.querySelector('#s-locate-msg')
    const saveBtn = document.querySelector('#s-save')
    const msg = document.querySelector('#s-msg')

    let lat = null
    let lng = null

    const isUrl = (s) => typeof s === 'string' && /^https?:\/\//i.test(s.trim())

    // Read lat/lng from the two number fields; returns true if both valid.
    function readCoordFields() {
      const la = parseFloat(latInput.value), lo = parseFloat(lngInput.value)
      if (!isNaN(la) && !isNaN(lo) && la >= -90 && la <= 90 && lo >= -180 && lo <= 180) {
        lat = la; lng = lo; return true
      }
      if (latInput.value.trim() === '' && lngInput.value.trim() === '') { lat = null; lng = null }
      return false
    }

    function setCoords(la, lo) {
      lat = la; lng = lo
      latInput.value = (typeof la === 'number') ? la.toFixed(5) : ''
      lngInput.value = (typeof lo === 'number') ? lo.toFixed(5) : ''
      renderCoords()
      updateMapLink()
    }

    function renderCoords() {
      if (typeof lat === 'number' && typeof lng === 'number') {
        coords.hidden = false
        coords.innerHTML = `📍 ${lat.toFixed(5)}, ${lng.toFixed(5)} · ` +
          `<a href="https://www.google.com/maps?q=${lat},${lng}" target="_blank" rel="noopener">Open in Maps ↗</a>`
      } else {
        coords.hidden = true
      }
    }

    function updateMapLink() {
      if (typeof lat === 'number' && typeof lng === 'number') {
        mapLink.href = `https://www.google.com/maps?q=${lat},${lng}`
      } else {
        const addr = addressInput.value.trim()
        if (isUrl(addr)) {
          mapLink.href = addr
        } else {
          const q = [nameInput.value.trim(), addr, areaSel.value !== '__new__' ? areaSel.value : areaNewInput.value.trim(), 'Japan']
            .filter(Boolean).join(' ')
          mapLink.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`
        }
      }
    }
    updateMapLink()
    addressInput.addEventListener('input', updateMapLink)
    nameInput.addEventListener('input', updateMapLink)

    // Typing directly in the lat/lng fields updates state.
    latInput.addEventListener('input', () => { readCoordFields(); renderCoords(); updateMapLink() })
    lngInput.addEventListener('input', () => { readCoordFields(); renderCoords(); updateMapLink() })

    // Paste "lat, lng" (or "lat lng") to fill both fields at once.
    function applyPaste() {
      const m = /(-?\d+(?:\.\d+)?)\s*[, ]\s*(-?\d+(?:\.\d+)?)/.exec(coordPaste.value || '')
      if (!m) { locateMsg.hidden = false; locateMsg.textContent = 'Paste like: 35.6990, 139.7710'; return }
      const la = parseFloat(m[1]), lo = parseFloat(m[2])
      if (isNaN(la) || isNaN(lo) || la < -90 || la > 90 || lo < -180 || lo > 180) {
        locateMsg.hidden = false; locateMsg.textContent = 'Those don’t look like valid coordinates.'; return
      }
      locateMsg.hidden = true
      coordPaste.value = ''
      setCoords(la, lo)
    }
    coordApply.addEventListener('click', applyPaste)
    coordPaste.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); applyPaste() } })

    areaSel.addEventListener('change', () => {
      if (areaSel.value === '__new__') {
        areaNewInput.hidden = false
        areaNewInput.focus()
      } else {
        areaNewInput.hidden = true
        areaNewInput.value = ''
      }
      updateMapLink()
    })
    function chosenArea() {
      if (areaSel.value === '__new__') return areaNewInput.value.trim()
      return areaSel.value
    }

    function chosenTripIds() {
      return Array.from(document.querySelectorAll('.s-trip'))
        .filter((c) => c.checked)
        .map((c) => c.value)
    }

    function showMsg(text, ok) {
      msg.hidden = false
      msg.textContent = text
      msg.style.color = ok ? '#2ecc71' : '#e74c3c'
    }

    // --- AI "fill in from web" — suggests values, never touches #s-note (that field is
    // the user's own train directions, never read or written here), and never saves
    // anything itself: "Apply selected" only fills the live form fields below, same as
    // picking from a dropdown would. The real save still goes through the Save button. ---
    const aiFillBtn = document.querySelector('#s-ai-fill-btn')
    const aiFillMsg = document.querySelector('#s-ai-fill-msg')
    const aiFillResults = document.querySelector('#s-ai-fill-results')

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#039;')
    }

    function showAiFillMsg(text, ok) {
      aiFillMsg.hidden = false
      aiFillMsg.textContent = text
      aiFillMsg.style.color = ok ? 'var(--muted)' : '#e74c3c'
    }
    function hideAiFillMsg() {
      aiFillMsg.hidden = true
      aiFillMsg.textContent = ''
    }

    function renderAiFillResults(result, sources) {
      aiFillResults.replaceChildren()
      const fields = []

      if (result.openingHours) {
        fields.push({
          key: 'openingHours',
          label: 'Opening hours',
          current: hoursInput.value.trim() || '(empty)',
          suggested: result.openingHours,
          checkedByDefault: !hoursInput.value.trim(),
        })
      }
      if (result.address) {
        fields.push({
          key: 'address',
          label: 'Address',
          current: addressInput.value.trim() || '(empty)',
          suggested: result.address,
          checkedByDefault: !addressInput.value.trim(),
        })
      }
      if (typeof result.latitude === 'number' && typeof result.longitude === 'number') {
        const hasCurrentCoords = readCoordFields() && typeof lat === 'number' && typeof lng === 'number'
        fields.push({
          key: 'coords',
          label: 'Coordinates',
          current: hasCurrentCoords ? `${lat.toFixed(5)}, ${lng.toFixed(5)}` : '(empty)',
          suggested: `${result.latitude.toFixed(5)}, ${result.longitude.toFixed(5)}`,
          checkedByDefault: !hasCurrentCoords,
        })
      }
      if (result.taxFreeShop === true || result.taxFreeShop === false) {
        const currentLabel = taxFreeSel.value === 'true' ? 'Yes' : taxFreeSel.value === 'false' ? 'No' : 'Unknown'
        fields.push({
          key: 'taxFreeShop',
          label: 'Tax-free shop',
          current: currentLabel,
          suggested: result.taxFreeShop ? 'Yes' : 'No',
          checkedByDefault: taxFreeSel.value === '',
        })
      }
      if (result.website) {
        fields.push({
          key: 'website',
          label: 'Website',
          current: websiteInput.value.trim() || '(empty)',
          suggested: result.website,
          checkedByDefault: !websiteInput.value.trim(),
        })
      }

      if (fields.length === 0 && !result.note) {
        aiFillResults.hidden = true
        showAiFillMsg('Nothing reliable found for this shop.', false)
        return
      }
      hideAiFillMsg()

      const card = document.createElement('div')
      card.className = 'as-ai-card'
      let list = null

      if (fields.length > 0) {
        list = document.createElement('ul')
        list.className = 'as-ai-list'
        fields.forEach((f) => {
          const li = document.createElement('li')
          li.className = 'as-ai-item'
          const label = document.createElement('label')
          label.className = 'as-ai-item-label'
          const checkbox = document.createElement('input')
          checkbox.type = 'checkbox'
          checkbox.className = 'as-ai-checkbox'
          checkbox.dataset.field = f.key
          checkbox.checked = f.checkedByDefault
          const text = document.createElement('span')
          text.className = 'as-ai-item-text'
          text.innerHTML = `<strong>${escapeHtml(f.label)}</strong><br>Current: ${escapeHtml(f.current)}<br>Suggested: ${escapeHtml(f.suggested)}`
          label.appendChild(checkbox)
          label.appendChild(text)
          li.appendChild(label)
          list.appendChild(li)
        })
        card.appendChild(list)
      }

      if (result.note) {
        const noteP = document.createElement('p')
        noteP.className = 'as-ai-note'
        noteP.textContent = `Note from search: ${result.note}`
        card.appendChild(noteP)
      }

      if (fields.length > 0) {
        const applyBtn = document.createElement('button')
        applyBtn.type = 'button'
        applyBtn.className = 'as-ai-apply-btn'
        applyBtn.textContent = 'Apply selected'
        applyBtn.addEventListener('click', () => {
          list.querySelectorAll('.as-ai-checkbox').forEach((cb) => {
            if (!cb.checked) return
            const f = fields.find((x) => x.key === cb.dataset.field)
            if (!f) return
            if (f.key === 'openingHours') hoursInput.value = result.openingHours
            else if (f.key === 'address') { addressInput.value = result.address; updateMapLink() }
            else if (f.key === 'coords') setCoords(result.latitude, result.longitude)
            else if (f.key === 'taxFreeShop') taxFreeSel.value = result.taxFreeShop ? 'true' : 'false'
            else if (f.key === 'website') websiteInput.value = result.website
          })
          showAiFillMsg('Applied — review and press Save to keep it.', true)
          aiFillResults.hidden = true
        })
        card.appendChild(applyBtn)
      }

      if (sources && sources.length > 0) {
        const sourcesWrap = document.createElement('p')
        sourcesWrap.className = 'as-ai-sources'
        sourcesWrap.appendChild(document.createTextNode('Sources: '))
        sources.forEach((s, i) => {
          const a = document.createElement('a')
          a.className = 'as-ai-source-link'
          a.href = s.url
          a.target = '_blank'
          a.rel = 'noopener'
          a.textContent = s.title || s.url
          sourcesWrap.appendChild(a)
          if (i < sources.length - 1) sourcesWrap.appendChild(document.createTextNode(' · '))
        })
        card.appendChild(sourcesWrap)
      }

      aiFillResults.appendChild(card)
      aiFillResults.hidden = false
    }

    async function fillFromWeb() {
      if (!nameInput.value.trim()) return showAiFillMsg('Enter a shop name first.', false)
      aiFillResults.hidden = true
      aiFillResults.replaceChildren()
      hideAiFillMsg()
      aiFillBtn.disabled = true
      aiFillBtn.textContent = 'Looking…'
      try {
        const res = await fetch('/api/shop-info', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            shopName: nameInput.value.trim(),
            area: chosenArea() || undefined,
            address: addressInput.value.trim() || undefined,
            openingHours: hoursInput.value.trim() || undefined,
          }),
        })
        const data = await res.json()
        if (!res.ok) {
          showAiFillMsg(data.error || 'Lookup failed.', false)
          return
        }
        renderAiFillResults(data.result || {}, data.sources || [])
      } catch (e) {
        showAiFillMsg('Network error.', false)
      } finally {
        aiFillBtn.disabled = false
        aiFillBtn.textContent = '✨ Fill in from web'
      }
    }
    aiFillBtn.addEventListener('click', fillFromWeb)

    locateBtn.addEventListener('click', () => {
      if (!('geolocation' in navigator)) {
        locateMsg.hidden = false
        locateMsg.textContent = 'Geolocation is not supported by this browser.'
        return
      }
      locateBtn.disabled = true
      locateBtn.textContent = 'Locating…'
      locateMsg.hidden = true

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          setCoords(pos.coords.latitude, pos.coords.longitude)
          locateBtn.disabled = false
          locateBtn.textContent = '📍 Update location'
        },
        (err) => {
          locateMsg.hidden = false
          locateMsg.textContent =
            err.code === 1
              ? 'Location permission denied. Allow location and try again.'
              : 'Could not get location. Try again.'
          locateBtn.disabled = false
          locateBtn.textContent = '📍 Use my location'
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
      )
    })

    async function save() {
      if (!nameInput.value.trim()) return showMsg('Please enter a shop name.', false)
      readCoordFields()

      saveBtn.disabled = true
      saveBtn.textContent = 'Saving…'

      try {
        const res = await fetch('/api/shop-note', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            shopName: nameInput.value.trim(),
            placeType: typeSel.value,
            tripIds: chosenTripIds(),
            area: chosenArea() || undefined,
            openingHours: hoursInput.value.trim() || undefined,
            note: noteInput.value.trim() || undefined,
            priority: prioritySel.value,
            taxFreeShop: taxFreeSel.value === 'true' ? true : taxFreeSel.value === 'false' ? false : undefined,
            website: websiteInput.value.trim() || undefined,
            address: addressInput.value.trim() || undefined,
            latitude: lat,
            longitude: lng,
          }),
        })
        const data = await res.json()
        if (!res.ok) {
          showMsg(data.error || 'Save failed.', false)
          return
        }
        showMsg('Saved ✓', true)

        nameInput.value = ''
        noteInput.value = ''
        addressInput.value = ''
        hoursInput.value = ''
        prioritySel.value = 'maybe'
        taxFreeSel.value = ''
        websiteInput.value = ''
        document.querySelectorAll('.s-trip').forEach((c) => { c.checked = false })
        setCoords(null, null)
        coordPaste.value = ''
        locateBtn.textContent = '📍 Use my location'
        updateMapLink()
        aiFillResults.hidden = true
        aiFillResults.replaceChildren()
        hideAiFillMsg()
        nameInput.focus()
      } catch (e) {
        showMsg('Network error.', false)
      } finally {
        saveBtn.disabled = false
        saveBtn.textContent = 'Save shop'
      }
    }

    saveBtn.addEventListener('click', save)
  </script>

  <style>
    .add-wrap { max-width: 520px; }
    .hint { font-size: 0.9rem; color: var(--muted); margin: 0.25rem 0 1.5rem; }
    .field { margin-bottom: 1rem; }
    .field label { display: block; font-size: 0.8rem; color: var(--muted); margin-bottom: 0.35rem; }
    .field input, .field select, .field textarea {
      width: 100%; background: var(--surface); color: var(--text);
      border: 1px solid var(--border); padding: 0.7rem 0.75rem; border-radius: 8px; font-size: 1rem;
      font-family: inherit; box-sizing: border-box;
    }
    .map-open-btn {
      display: inline-block; margin-top: 0.5rem;
      background: var(--bg); color: var(--text); border: 1px solid var(--accent);
      padding: 0.45rem 0.8rem; border-radius: 6px; text-decoration: none; font-size: 0.85rem;
    }
    .map-open-btn:hover { background: rgba(255,255,255,0.04); }
    .coord-paste { display: flex; gap: 0.5rem; margin-bottom: 0.5rem; }
    .coord-paste input { flex: 1; min-width: 0; }
    .coord-apply-btn {
      flex-shrink: 0; background: var(--surface); color: var(--text); border: 1px solid var(--accent);
      padding: 0 1rem; border-radius: 8px; cursor: pointer; font-size: 0.9rem; white-space: nowrap;
    }
    .coord-apply-btn:hover { background: rgba(255,255,255,0.04); }
    .coord-fields { display: flex; gap: 0.5rem; margin-bottom: 0.5rem; }
    .coord-fields input { flex: 1; min-width: 0; }
    .trip-checks { display: flex; flex-direction: column; gap: 0.5rem; }
    .trip-check { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; }
    .trip-check input { width: auto; margin: 0; }
    .trip-check span { font-size: 0.95rem; }
    .locate-btn {
      width: 100%; background: var(--surface); color: var(--text); border: 1px solid var(--accent);
      padding: 0.7rem; border-radius: 8px; cursor: pointer; font-size: 0.95rem;
    }
    .locate-btn:disabled { opacity: 0.6; cursor: default; }
    .coords { font-size: 0.9rem; margin: 0.6rem 0 0; }
    .coords a { color: var(--accent); }
    .locate-msg { font-size: 0.85rem; color: #e74c3c; margin: 0.5rem 0 0; }
    .save-btn {
      width: 100%; margin-top: 0.5rem; background: var(--accent); color: #fff; border: none;
      padding: 0.9rem; border-radius: 8px; font-size: 1.05rem; font-weight: 600; cursor: pointer;
    }
    .save-btn:disabled { opacity: 0.6; cursor: default; }
    .save-msg { font-size: 0.9rem; margin: 0.75rem 0 0; }
    .back-link { display: inline-block; margin-top: 1.5rem; color: var(--muted); text-decoration: none; font-size: 0.9rem; }
    .back-link:hover { color: var(--accent); }

    .ai-fill-btn {
      width: 100%; background: var(--surface); color: var(--text); border: 1px solid var(--accent);
      padding: 0.7rem; border-radius: 8px; cursor: pointer; font-size: 0.95rem;
    }
    .ai-fill-btn:disabled { opacity: 0.6; cursor: default; }
    .ai-fill-msg { font-size: 0.85rem; margin: 0.6rem 0 0; }
    .ai-fill-msg[hidden] { display: none; }
    .ai-fill-results { margin-top: 0.75rem; }
    .ai-fill-results[hidden] { display: none; }
  </style>

  <!-- Suggestion card content is built with document.createElement/innerHTML in the
       script above, so it never gets Astro's scoped-CSS attribute — these rules have to
       be global. "as-ai-" prefix keeps them from colliding with anything else on the
       page or with edit-store.astro's own (separately duplicated) copy of this feature. -->
  <style is:global>
    .as-ai-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
      padding: 0.9rem; display: flex; flex-direction: column; gap: 0.75rem;
    }
    .as-ai-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
    .as-ai-item { border-bottom: 1px solid var(--border); padding-bottom: 0.6rem; }
    .as-ai-item:last-child { border-bottom: none; padding-bottom: 0; }
    .as-ai-item-label { display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; font-size: 0.85rem; }
    .as-ai-item-label input { width: auto; margin: 0.2rem 0 0; flex-shrink: 0; }
    .as-ai-item-text { line-height: 1.5; overflow-wrap: anywhere; }
    .as-ai-note { font-size: 0.85rem; color: var(--muted); font-style: italic; margin: 0; }
    .as-ai-apply-btn {
      background: var(--accent); color: #fff; border: none; border-radius: 8px;
      padding: 0.6rem; font-size: 0.9rem; font-weight: 600; cursor: pointer;
    }
    .as-ai-sources { font-size: 0.78rem; color: var(--muted); margin: 0; overflow-wrap: anywhere; }
    .as-ai-source-link { color: var(--accent); text-decoration: none; }
    .as-ai-source-link:hover { text-decoration: underline; }
  </style>
</Base>