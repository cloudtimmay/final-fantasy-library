---
import Base from '../../layouts/Base.astro'
import { sanity, SHARED_FIELDS, urlFor } from '../../lib/sanity'
import { ALBUM_GENRES, ALBUM_FORMATS } from '../../lib/collection-fields'

const { id } = Astro.params

const a = await sanity.fetch(
  `*[_type == "album" && _id == $id][0] {
    title, series, artist, composer, year, genre, format, label, publisher, distributor,
    catalogNumber, vgmdbId, vgmdbUrl, externalImageUrl, youtubeMusicUrl, youtubePlaylistId,
    needsInfo, barcode, releaseDate, releasePrice,
    tracklist[]{ disc, trackNumber, title, duration, youtubeId },
    ${SHARED_FIELDS}
  }`,
  { id }
)

if (!a) return Astro.redirect('/albums')

const STATUSES = ['owned', 'wishlist', 'sold', 'lent']

function ytId(raw) {
  if (!raw) return ''
  const s = String(raw).trim()
  const match = s.match(/(?:v=|youtu\.be\/|embed\/)([A-Za-z0-9_-]{11})/)
  if (match) return match[1]
  if (/^[A-Za-z0-9_-]{11}$/.test(s)) return s
  return ''
}

function ytPlaylistId(raw) {
  if (!raw) return ''
  const s = String(raw).trim()
  const listMatch = s.match(/[?&]list=([A-Za-z0-9_-]+)/)
  if (listMatch) return 'list:' + listMatch[1]
  const vid = ytId(s)
  if (vid) return 'video:' + vid
  if (/^PL[A-Za-z0-9_-]+$/.test(s)) return 'list:' + s
  return ''
}

const albumYt = ytPlaylistId(a.youtubePlaylistId)

const tracks = (a.tracklist || []).map((t) => ({ ...t, _yt: ytId(t.youtubeId) }))
const discMap = {}
for (const t of tracks) {
  const d = t.disc || 1
  if (!discMap[d]) discMap[d] = []
  discMap[d].push(t)
}
const discNumbers = Object.keys(discMap).map(Number).sort((x, y) => x - y)
const multiDisc = discNumbers.length > 1
---
<Base title={a.title}>
  <div class="detail">
    <a href="/albums" style="font-size:13px;color:var(--muted)">← Albums</a>
    <br /><br />
    <h1>{a.title}</h1>
    <div class="detail-sub">{a.artist}</div>

    <button id="edit-toggle" class="edit-toggle-btn" type="button">✏️ Edit</button>

    {a.needsInfo && (
      <div class="needsinfo-banner">
        This album is missing information{a.barcode ? <> (barcode: <span class="mono">{a.barcode}</span>)</> : null}. Check the details and fill them in via Studio.
      </div>
    )}

    {a.image
      ? <img class="detail-photo" src={urlFor(a.image).width(640).url()} alt={a.title} />
      : a.externalImageUrl
      ? <img class="detail-photo" src={a.externalImageUrl} alt={a.title} />
      : <div class="detail-photo placeholder">🎵</div>
    }

    <div class="upload-row">
      <label class="upload-btn">
        📷 Take photo
        <input id="img-camera" type="file" accept="image/*" capture="environment" hidden />
      </label>
      <label class="upload-btn">
        🖼️ Choose from gallery
        <input id="img-gallery" type="file" accept="image/*" hidden />
      </label>
      <span id="upload-msg" class="upload-msg" hidden></span>
    </div>

    <div id="view-mode">
      <table class="meta-table">
        {a.series    && <tr><td>Series</td><td>{a.series}</td></tr>}
        {a.composer  && <tr><td>Composer</td><td>{a.composer}</td></tr>}
        {a.year      && <tr><td>Year</td><td>{a.year}</td></tr>}
        {a.genre     && <tr><td>Genre</td><td>{a.genre}</td></tr>}
        {a.format    && <tr><td>Format</td><td>{a.format}</td></tr>}
        {a.label     && <tr><td>Label</td><td>{a.label}</td></tr>}
        {a.publisher && <tr><td>Publisher</td><td>{a.publisher}</td></tr>}
        {a.distributor && <tr><td>Distributor</td><td>{a.distributor}</td></tr>}
        {a.barcode   && <tr><td>Barcode</td><td class="mono">{a.barcode}</td></tr>}
        {a.releaseDate && <tr><td>Release date</td><td>{a.releaseDate}</td></tr>}
        {a.releasePrice && <tr><td>Release price</td><td>{a.releasePrice}</td></tr>}
        {a.status    && <tr><td>Status</td><td>{a.status}</td></tr>}
        {a.rating    && <tr><td>Rating</td><td class="rating">{a.rating} / 10</td></tr>}
        {a.acquiredDate && <tr><td>Acquired</td><td>{a.acquiredDate}</td></tr>}
        {a.catalogNumber && <tr><td>Catalog</td><td>{a.catalogNumber}</td></tr>}
        {a.vgmdbUrl && <tr><td>VGMdb</td><td><a href={a.vgmdbUrl} target="_blank">Open VGMdb</a></td></tr>}
        {a.youtubeMusicUrl && <tr><td>YouTube Music</td><td><a href={a.youtubeMusicUrl} target="_blank" rel="noopener">▶ Spill av i YouTube Music</a></td></tr>}
        {a.purchasePrice && <tr><td>Paid</td><td>{a.purchasePrice} NOK</td></tr>}
      </table>

      {a.tags?.length > 0 && (
        <div style="margin-top:1rem;display:flex;gap:0.5rem;flex-wrap:wrap">
          {a.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      )}
      {a.notes && <div class="notes-block">{a.notes}</div>}
    </div>

    <form id="edit-mode" class="edit-form" hidden>
      <div class="field">
        <label>Title *</label>
        <input id="e-title" type="text" value={a.title} />
      </div>
      <div class="field">
        <label>Artist / Band</label>
        <input id="e-artist" type="text" value={a.artist} />
      </div>
      <div class="field">
        <label>Composer(s)</label>
        <input id="e-composer" type="text" value={a.composer} />
      </div>

      <div class="field ai-fill-field">
        <button id="e-ai-fill-btn" type="button" class="ai-fill-btn">✨ Fill in from web</button>
        <p id="e-ai-fill-msg" class="ai-fill-msg" hidden></p>
        <div id="e-ai-fill-results" class="ai-fill-results" hidden></div>
      </div>

      <div class="field">
        <label>Series</label>
        <input id="e-series" type="text" value={a.series} />
      </div>
      <div class="field">
        <label>Genre</label>
        <select id="e-genre">
          <option value="">Select…</option>
          {ALBUM_GENRES.map((g) => <option value={g} selected={g === a.genre}>{g}</option>)}
        </select>
      </div>
      <div class="field">
        <label>Format</label>
        <select id="e-format">
          <option value="">Select…</option>
          {ALBUM_FORMATS.map((f) => <option value={f.value} selected={f.value === a.format}>{f.label}</option>)}
        </select>
      </div>
      <div class="field-row">
        <div class="field">
          <label>Catalog number</label>
          <input id="e-catalog" type="text" value={a.catalogNumber} />
        </div>
        <div class="field">
          <label>Barcode</label>
          <input id="e-barcode" type="text" value={a.barcode} />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label>Label</label>
          <input id="e-label" type="text" value={a.label} />
        </div>
        <div class="field">
          <label>Distributor</label>
          <input id="e-distributor" type="text" value={a.distributor} />
        </div>
      </div>
      <div class="field">
        <label>Publisher</label>
        <input id="e-publisher" type="text" value={a.publisher} />
      </div>
      <div class="field-row">
        <div class="field">
          <label>Release date</label>
          <input id="e-release-date" type="text" value={a.releaseDate} placeholder="e.g. 2020-03-20" />
        </div>
        <div class="field">
          <label>Release price</label>
          <input id="e-release-price" type="text" value={a.releasePrice} />
        </div>
      </div>
      <div class="field">
        <label>VGMdb ID</label>
        <input id="e-vgmdb-id" type="text" value={a.vgmdbId} />
      </div>
      <div class="field">
        <label>VGMdb URL</label>
        <input id="e-vgmdb-url" type="url" value={a.vgmdbUrl} />
      </div>
      <div class="field">
        <label>YouTube Music URL</label>
        <input id="e-yt-music" type="url" value={a.youtubeMusicUrl} />
      </div>
      <div class="field">
        <label>YouTube playlist/video (ID or URL)</label>
        <input id="e-yt-playlist" type="text" value={a.youtubePlaylistId} />
      </div>
      <div class="field">
        <label>Status</label>
        <select id="e-status">
          {STATUSES.map((s) => <option value={s} selected={s === a.status}>{s}</option>)}
        </select>
      </div>
      <div class="field">
        <label>Acquired date</label>
        <input id="e-acquired" type="date" value={a.acquiredDate} />
      </div>
      <div class="field-row">
        <div class="field">
          <label>Price (JPY)</label>
          <input id="e-price-yen" type="number" inputmode="numeric" value={a.purchasePriceYen} />
        </div>
        <div class="field">
          <label>Price (NOK)</label>
          <input id="e-price-nok" type="number" inputmode="numeric" value={a.purchasePrice} />
        </div>
      </div>
      <div class="field">
        <label>Notes</label>
        <textarea id="e-notes" rows="2">{a.notes}</textarea>
      </div>
      <div class="field checkbox-field">
        <label><input id="e-needs-info" type="checkbox" checked={a.needsInfo === true} /> Missing info</label>
      </div>

      <div class="edit-actions">
        <button id="e-save" type="button" class="save-btn">Save</button>
        <button id="e-cancel" type="button" class="cancel-btn">Cancel</button>
      </div>
      <p id="e-msg" class="save-msg" hidden></p>
    </form>

    {tracks.length > 0 && (
      <section class="tracklist">
        <h2>Tracklist <span class="track-count">{tracks.length} tracks</span></h2>

        <div class="album-play-row">
          {albumYt ? (
            <button class="album-play" data-yt={albumYt} title="Spill av hele albumet">▶ Spill av album</button>
          ) : (
            <a class="album-play" href={`https://www.youtube.com/results?search_query=${encodeURIComponent(a.title + ' ' + a.artist + ' full album')}`} target="_blank" rel="noopener">🔍 Søk album på YouTube</a>
          )}
        </div>

        {discNumbers.map((d) => (
          <div class="disc">
            {multiDisc && <div class="disc-title">Disc {d}</div>}
            <ol class="track-rows">
              {discMap[d].map((t) => (
                <li class="track-row">
                  <span class="track-num">{t.trackNumber}</span>
                  <span class="track-title">{t.title}</span>
                  {t.duration && <span class="track-time">{t.duration}</span>}
                  {t._yt ? (
                    <button class="track-play" data-yt={t._yt} title="Spill av">▶</button>
                  ) : (
                    <a class="track-search" href={`https://www.youtube.com/results?search_query=${encodeURIComponent(a.title + ' ' + t.title)}`} target="_blank" rel="noopener" title="Søk på YouTube">🔍</a>
                  )}
                </li>
              ))}
            </ol>
          </div>
        ))}

        <div id="yt-player" class="yt-player" hidden>
          <div class="yt-player-bar">
            <span id="yt-now"></span>
            <button id="yt-close" title="Lukk">✕</button>
          </div>
          <div class="yt-frame-wrap">
            <iframe id="yt-frame" src="" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
        </div>
      </section>
    )}
  </div>

  <style>
    .detail-photo.placeholder { display: flex; align-items: center; justify-content: center; font-size: 4rem; height: 280px; background: var(--surface); }
    .needsinfo-banner { background: var(--surface); border: 1px solid var(--accent); border-radius: 6px; padding: 0.75rem 1rem; margin: 1rem 0; font-size: 0.9rem; }
    .mono { font-family: monospace; }
    .upload-row { display: flex; align-items: center; gap: 0.5rem; margin: 1rem 0 1.5rem; flex-wrap: wrap; }
    .upload-btn { display: inline-block; background: var(--surface); color: var(--text); border: 1px solid var(--accent); padding: 0.55rem 0.9rem; border-radius: 8px; cursor: pointer; font-size: 0.9rem; }
    .upload-btn:hover { background: #241826; }
    .upload-msg { font-size: 0.85rem; width: 100%; }

    .edit-toggle-btn {
      display: inline-block; margin-bottom: 1rem; background: var(--surface); color: var(--text);
      border: 1px solid var(--accent); padding: 0.45rem 0.8rem; border-radius: 6px; cursor: pointer; font-size: 0.85rem;
    }
    .edit-toggle-btn:hover { background: #241826; }
    .edit-form[hidden] { display: none; }
    .edit-form .field { margin-bottom: 1rem; }
    .edit-form .field-row { display: flex; gap: 1rem; }
    .edit-form .field-row .field { flex: 1; }
    .edit-form .field label { display: block; font-size: 0.8rem; color: var(--muted); margin-bottom: 0.35rem; }
    .edit-form .field input, .edit-form .field select, .edit-form .field textarea {
      width: 100%; background: var(--surface); color: var(--text);
      border: 1px solid var(--border); padding: 0.7rem 0.75rem; border-radius: 8px; font-size: 1rem;
      font-family: inherit; box-sizing: border-box;
    }
    .edit-form .checkbox-field label { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; color: var(--text); }
    .edit-form .checkbox-field input { width: auto; }
    .edit-actions { display: flex; gap: 0.75rem; }
    .save-btn {
      flex: 1; background: var(--accent); color: #fff; border: none;
      padding: 0.8rem; border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer;
    }
    .save-btn:disabled { opacity: 0.6; cursor: default; }
    .cancel-btn {
      background: var(--surface); color: var(--text); border: 1px solid var(--border);
      padding: 0.8rem 1.2rem; border-radius: 8px; font-size: 1rem; cursor: pointer;
    }
    .save-msg { font-size: 0.9rem; margin-top: 0.75rem; }

    .ai-fill-field { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 1rem 0; }
    .ai-fill-btn {
      display: inline-block; background: var(--surface); color: var(--text);
      border: 1px solid var(--accent); padding: 0.55rem 0.9rem; border-radius: 8px; cursor: pointer; font-size: 0.9rem;
    }
    .ai-fill-btn:hover { background: #241826; }
    .ai-fill-btn:disabled { opacity: 0.6; cursor: default; }
    .ai-fill-msg { font-size: 0.85rem; margin: 0.6rem 0 0; }
    .ai-fill-msg[hidden] { display: none; }
    .ai-fill-results[hidden] { display: none; }
    .ai-fill-results { margin-top: 0.75rem; }

    .tracklist { margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 1rem; }
    .tracklist h2 { font-size: 1rem; font-weight: 600; display: flex; align-items: baseline; gap: 0.75rem; }
    .track-count { font-size: 0.8rem; font-weight: 400; color: var(--muted); }
    .album-play-row { margin: 0.75rem 0 0.5rem; }
    .album-play { display: inline-flex; align-items: center; gap: 0.4rem; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 0.5rem 0.9rem; color: var(--text); font-size: 0.85rem; cursor: pointer; text-decoration: none; }
    .album-play:hover { border-color: var(--accent); }
    .disc { margin-top: 1rem; }
    .disc-title { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 0.4rem; }
    .track-rows { list-style: none; margin: 0; padding: 0; }
    .track-row { display: flex; gap: 1rem; padding: 0.4rem 0; border-bottom: 1px solid var(--border); align-items: center; }
    .track-num { flex-shrink: 0; width: 2rem; text-align: right; color: var(--muted); font-variant-numeric: tabular-nums; }
    .track-title { flex: 1; min-width: 0; }
    .track-time { flex-shrink: 0; color: var(--muted); font-variant-numeric: tabular-nums; }
    .track-play, .track-search { flex-shrink: 0; width: 1.9rem; height: 1.9rem; display: flex; align-items: center; justify-content: center; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; color: var(--text); font-size: 0.75rem; cursor: pointer; text-decoration: none; }
    .track-play:hover, .track-search:hover { border-color: var(--accent); }
    .yt-player { margin-top: 1.5rem; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; background: var(--surface); }
    .yt-player-bar { display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.75rem; font-size: 0.85rem; gap: 1rem; }
    #yt-now { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #yt-close { flex-shrink: 0; background: none; border: none; color: var(--muted); cursor: pointer; font-size: 1rem; }
    .yt-frame-wrap { position: relative; width: 100%; aspect-ratio: 16 / 9; }
    #yt-frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  </style>

  <!-- Suggestion card content is built with document.createElement by the shared
       item-info-flow.js module, so it never gets Astro's scoped-CSS attribute — these
       rules have to be global. "aif-" prefix (AI Fill) keeps them from colliding with
       identify-flow.js's own "idf-" classes or anything else on the page; duplicated
       verbatim across all four edit-mode pages since the module is loaded on each one. -->
  <style is:global>
    .aif-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
      padding: 0.9rem; display: flex; flex-direction: column; gap: 0.75rem;
    }
    .aif-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
    .aif-item { border-bottom: 1px solid var(--border); padding-bottom: 0.6rem; }
    .aif-item:last-child { border-bottom: none; padding-bottom: 0; }
    .aif-item-label { display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; font-size: 0.85rem; }
    .aif-item-label input { width: auto; margin: 0.2rem 0 0; flex-shrink: 0; }
    .aif-item-text { line-height: 1.5; overflow-wrap: anywhere; }
    .aif-apply-btn {
      background: var(--accent); color: #fff; border: none; border-radius: 8px;
      padding: 0.6rem; font-size: 0.9rem; font-weight: 600; cursor: pointer;
    }
    .aif-sources { font-size: 0.78rem; color: var(--muted); margin: 0; overflow-wrap: anywhere; }
    .aif-source-link { color: var(--accent); text-decoration: none; }
    .aif-source-link:hover { text-decoration: underline; }
  </style>

  <script is:inline src="/item-info-flow.js"></script>

  <script>
    import { initImageUpload } from '../../scripts/image-upload.js'

    const player = document.querySelector('#yt-player')
    const frame = document.querySelector('#yt-frame')
    const now = document.querySelector('#yt-now')
    const closeBtn = document.querySelector('#yt-close')

    function openPlayer(src, label) {
      frame.src = src
      now.textContent = label
      player.hidden = false
      player.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
    }

    document.querySelectorAll('.track-play').forEach((btn) => {
      btn.addEventListener('click', () => {
        const ytId = btn.dataset.yt
        const row = btn.closest('.track-row')
        const title = row && row.querySelector('.track-title') ? row.querySelector('.track-title').textContent : ''
        openPlayer('https://www.youtube.com/embed/' + ytId + '?autoplay=1', title)
      })
    })

    const albumBtn = document.querySelector('.album-play[data-yt]')
    if (albumBtn) {
      albumBtn.addEventListener('click', () => {
        const val = albumBtn.dataset.yt
        let src = ''
        if (val.startsWith('list:')) {
          src = 'https://www.youtube.com/embed/videoseries?list=' + val.slice(5) + '&autoplay=1'
        } else if (val.startsWith('video:')) {
          src = 'https://www.youtube.com/embed/' + val.slice(6) + '?autoplay=1'
        }
        if (src) openPlayer(src, 'Hele albumet')
      })
    }

    // Only present when the album has a tracklist (tracks.length > 0 in the frontmatter) —
    // without this guard, an album with none (every brand-new album, until Studio adds
    // one) threw here and silently skipped everything below it, including the edit-mode
    // wiring and initImageUpload().
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        frame.src = ''
        player.hidden = true
      })
    }

    initImageUpload()

    const docId = window.location.pathname.split('/').pop()
    const viewMode = document.querySelector('#view-mode')
    const editMode = document.querySelector('#edit-mode')
    const editToggle = document.querySelector('#edit-toggle')
    const cancelBtn = document.querySelector('#e-cancel')
    const saveBtn = document.querySelector('#e-save')
    const msg = document.querySelector('#e-msg')

    function showMsg(text, ok) {
      msg.hidden = false
      msg.textContent = text
      msg.style.color = ok ? '#2ecc71' : '#e74c3c'
    }

    function openEdit() {
      viewMode.hidden = true
      editToggle.hidden = true
      editMode.hidden = false
    }
    editToggle.addEventListener('click', openEdit)
    // Arriving from /missing-info with ?edit=1 — jump straight into edit mode instead of
    // making the user find and tap the Edit button themselves.
    if (new URLSearchParams(window.location.search).get('edit') === '1') openEdit()

    cancelBtn.addEventListener('click', () => {
      editMode.reset()
      editMode.hidden = true
      editToggle.hidden = false
      viewMode.hidden = false
      msg.hidden = true
      document.querySelector('#e-ai-fill-results').hidden = true
      document.querySelector('#e-ai-fill-msg').hidden = true
    })

    window.createItemInfoFlow({
      type: 'album',
      els: {
        btn: document.querySelector('#e-ai-fill-btn'),
        msg: document.querySelector('#e-ai-fill-msg'),
        resultsWrap: document.querySelector('#e-ai-fill-results'),
      },
      getQuery: () => ({
        title: document.querySelector('#e-title').value.trim(),
        creator: document.querySelector('#e-composer').value.trim() || document.querySelector('#e-artist').value.trim(),
        barcode: document.querySelector('#e-barcode').value.trim(),
      }),
      fields: [
        { key: 'artist', label: 'Artist / Band', getCurrent: () => document.querySelector('#e-artist').value, apply: (v) => { document.querySelector('#e-artist').value = v } },
        { key: 'composer', label: 'Composer(s)', getCurrent: () => document.querySelector('#e-composer').value, apply: (v) => { document.querySelector('#e-composer').value = v } },
        { key: 'genre', label: 'Genre', getCurrent: () => document.querySelector('#e-genre').value, apply: (v) => { document.querySelector('#e-genre').value = v } },
        { key: 'format', label: 'Format', getCurrent: () => document.querySelector('#e-format').value, apply: (v) => { document.querySelector('#e-format').value = v } },
        { key: 'catalogNumber', label: 'Catalog number', barcodeLike: true, getCurrent: () => document.querySelector('#e-catalog').value, apply: (v) => { document.querySelector('#e-catalog').value = v } },
        { key: 'barcode', label: 'Barcode', barcodeLike: true, getCurrent: () => document.querySelector('#e-barcode').value, apply: (v) => { document.querySelector('#e-barcode').value = v } },
        { key: 'label', label: 'Label', getCurrent: () => document.querySelector('#e-label').value, apply: (v) => { document.querySelector('#e-label').value = v } },
        { key: 'distributor', label: 'Distributor', getCurrent: () => document.querySelector('#e-distributor').value, apply: (v) => { document.querySelector('#e-distributor').value = v } },
        { key: 'publisher', label: 'Publisher', getCurrent: () => document.querySelector('#e-publisher').value, apply: (v) => { document.querySelector('#e-publisher').value = v } },
        { key: 'releaseDate', label: 'Release date', getCurrent: () => document.querySelector('#e-release-date').value, apply: (v) => { document.querySelector('#e-release-date').value = v } },
        { key: 'releasePrice', label: 'Release price', getCurrent: () => document.querySelector('#e-release-price').value, apply: (v) => { document.querySelector('#e-release-price').value = v } },
        { key: 'vgmdbId', label: 'VGMdb ID', getCurrent: () => document.querySelector('#e-vgmdb-id').value, apply: (v) => { document.querySelector('#e-vgmdb-id').value = v } },
        { key: 'vgmdbUrl', label: 'VGMdb URL', getCurrent: () => document.querySelector('#e-vgmdb-url').value, apply: (v) => { document.querySelector('#e-vgmdb-url').value = v } },
      ],
    })

    saveBtn.addEventListener('click', async () => {
      const title = document.querySelector('#e-title').value.trim()
      if (!title) return showMsg('Please enter a title.', false)
      saveBtn.disabled = true
      saveBtn.textContent = 'Saving…'
      try {
        const res = await fetch('/api/album-update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: docId,
            title,
            artist: document.querySelector('#e-artist').value,
            composer: document.querySelector('#e-composer').value,
            series: document.querySelector('#e-series').value,
            genre: document.querySelector('#e-genre').value,
            format: document.querySelector('#e-format').value,
            catalogNumber: document.querySelector('#e-catalog').value,
            barcode: document.querySelector('#e-barcode').value,
            label: document.querySelector('#e-label').value,
            distributor: document.querySelector('#e-distributor').value,
            publisher: document.querySelector('#e-publisher').value,
            releaseDate: document.querySelector('#e-release-date').value,
            releasePrice: document.querySelector('#e-release-price').value,
            vgmdbId: document.querySelector('#e-vgmdb-id').value,
            vgmdbUrl: document.querySelector('#e-vgmdb-url').value,
            youtubeMusicUrl: document.querySelector('#e-yt-music').value,
            youtubePlaylistId: document.querySelector('#e-yt-playlist').value,
            status: document.querySelector('#e-status').value,
            acquiredDate: document.querySelector('#e-acquired').value,
            purchasePriceYen: document.querySelector('#e-price-yen').value,
            purchasePrice: document.querySelector('#e-price-nok').value,
            notes: document.querySelector('#e-notes').value,
            needsInfo: document.querySelector('#e-needs-info').checked,
          }),
        })
        const data = await res.json().catch(() => null)
        if (!res.ok) {
          showMsg((data && data.error) || 'Save failed.', false)
          return
        }
        window.location.reload()
      } catch (e) {
        showMsg('Network error.', false)
      } finally {
        saveBtn.disabled = false
        saveBtn.textContent = 'Save'
      }
    })
  </script>
</Base>