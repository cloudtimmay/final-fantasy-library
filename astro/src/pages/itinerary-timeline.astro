---
import Base from '../layouts/Base.astro'
import { loadItineraryPageData } from '../lib/itinerary-page-data'
import '../styles/itinerary-shared.css'
import { tokyoNow } from '../lib/trip-dates'

// A calendar-style day view of the same plan as /itinerary: the same data (loadItineraryPageData),
// the same timetable (itinerary-plan.ts computeDayTimes) and the same saved format.
const { BASE, shops, savedState, plan, trip, days, labels, flight } = await loadItineraryPageData(Astro.url)
// ?day=<date>, else today in Tokyo if it's one of the trip's days, else the first.
const requestedDay = Astro.url.searchParams.get('day') || ''
const today = tokyoNow().date
const initialDay = days.includes(requestedDay) ? requestedDay : days.includes(today) ? today : days[0]
const tripQuery = Astro.url.searchParams.get('trip') ? `?trip=${encodeURIComponent(Astro.url.searchParams.get('trip')!)}` : ''
---
<Base title="Timeline">
  <div class="itl-wrap" data-initial-day={initialDay} data-trip-query={tripQuery}>
    <div class="itl-nav">
      <a id="itl-list-link" href={`/itinerary${tripQuery}`} class="itl-nav-link">← List view</a>
      <span id="itl-save-status" class="itl-save-status"></span>
    </div>
    <h1>Timeline <span class="itl-beta">beta</span></h1>

    <div class="itl-tabs" id="itl-tabs" role="tablist">
      {days.map((d) => (
        <button type="button" role="tab" class:list={['itl-tab', { active: d === initialDay }]} data-day={d} aria-selected={d === initialDay ? 'true' : 'false'}>{labels[d]}</button>
      ))}
    </div>

    <div class="itl-toolbar">
      <p class="itl-hint">Tap an empty spot to add a stop there.</p>
      <div class="itl-zoom" role="group" aria-label="Zoom">
        <button id="itl-zoom-out" type="button" aria-label="Zoom out">−</button>
        <button id="itl-zoom-in" type="button" aria-label="Zoom in">+</button>
      </div>
    </div>

    <div class="itl-daybar">
      <label class="itl-start">🕗 Start <input id="itl-start" type="time" /></label>
      <button id="itl-check-btn" type="button" class="itl-daybtn">🔍 Check day</button>
      <button id="itl-route-btn" type="button" class="itl-daybtn">🧭 Suggest route</button>
      <span id="itl-dayroute" class="itl-dayroute"></span>
    </div>
    <details id="itl-map-section" class="itl-map-section">
      <summary>🗺️ Map</summary>
      <div id="itl-map" class="day-map itl-map"></div>
    </details>
    <div id="itl-check-results" class="itl-panel" hidden></div>
    <div id="itl-route-results" class="itl-panel" hidden></div>
    <div id="itl-travel-editor" class="itl-travel-editor" hidden>
      <div class="itl-travel-editor-head">
        <strong id="itl-travel-editor-title"></strong>
        <button id="itl-travel-editor-close" type="button" aria-label="Close">✕</button>
      </div>
      <div id="itl-travel-edit" class="itn-travel-edit"></div>
    </div>

    <form id="itl-add" class="itl-add" hidden>
      <p class="itl-add-title">Add a stop around <strong id="itl-add-time"></strong></p>
      <select id="itl-add-shop" aria-label="Shop"></select>
      <div id="itl-add-custom" class="itl-add-custom" hidden>
        <input id="itl-add-name" type="text" placeholder="Name *" />
        <input id="itl-add-hours" type="text" placeholder="Info (optional)" />
      </div>
      <label class="itl-add-dur">Duration <input id="itl-add-dur" type="number" min="5" step="5" value="45" /> min</label>
      <p class="itl-add-note">It goes after the stops that start before this time; the day is recalculated, so its time may move.</p>
      <div class="itl-add-actions">
        <button id="itl-add-save" type="submit">Add</button>
        <button id="itl-add-cancel" type="button">Cancel</button>
      </div>
    </form>

    <div id="itl-detail" class="itl-detail" hidden>
      <div class="itl-detail-head">
        <strong id="itl-detail-name"></strong>
        <button id="itl-detail-close" type="button" aria-label="Close">✕</button>
      </div>
      <ul id="itl-detail-lines" class="itl-detail-lines"></ul>
      <a id="itl-detail-edit" class="itl-detail-edit" href="/itinerary">Edit in list →</a>
    </div>

    <div id="itl-day" class="itl-day"></div>
  </div>

  <script type="application/json" id="itl-data" set:html={JSON.stringify({ plan, days, labels, flight, base: BASE, shops, savedState })}></script>

  <script>
    import {
      buildPlanState, serializePlan, normalizeSavedPlan, computeDayTimes, resolveStop, looksClosed,
      shopOptionGroups, shopStopFrom, customStopFrom, dayRouteUrls, checkDayRequestBody, optimizerInput,
      legFromKey, manualTravelFor, DEFAULT_START, type PlanDay, type PlanShop,
    } from '../lib/itinerary-plan'
    import {
      loadLeaflet, drawDayMap, travelEditorInnerHtml, bindTravelEditor, runCheckDay,
      renderRouteSuggestion, renderRouteApplied, renderNoStopsToReorder,
    } from '../lib/itinerary-ui'
    import { optimizeRoute } from '../lib/route-optimizer'
    import { timelineRange, layoutTimeline, offsetFor, minutesAtOffset, insertIndexForTime, ZOOM_LEVELS, DEFAULT_ZOOM_INDEX, CHIP_PX } from '../lib/itinerary-timeline'
    import { latestEndForFlight, formatClock } from '../lib/itinerary-review-helpers'
    import { tokyoNow } from '../lib/trip-dates'

    const DATA = JSON.parse(document.querySelector('#itl-data')?.textContent || '{}')
    const { plan, days, labels, flight, base, shops, savedState } = DATA
    const shopById = new Map<string, PlanShop>((shops || []).map((s: PlanShop) => [s._id, s]))
    const wrap = document.querySelector('.itl-wrap') as HTMLElement
    const dayEl = document.querySelector('#itl-day') as HTMLElement
    const esc = (s: unknown) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!)

    // The same load as /itinerary: the server's saved plan, else this browser's copy.
    const STORE_KEY = 'ff-itinerary-v12' // must match itinerary.astro
    function loadSaved() {
      if (savedState) { try { const p = normalizeSavedPlan(JSON.parse(savedState), plan); if (p) return p } catch (e) {} }
      try { const s = localStorage.getItem(STORE_KEY); return s ? normalizeSavedPlan(JSON.parse(s), plan) : null } catch { return null }
    }
    const built = buildPlanState(plan, days, labels, loadSaved() || {})
    let state: PlanDay[] = built.state
    const extraDays = built.extraDays
    let currentDay: string = wrap.dataset.initialDay || days[0]

    // Zoom (pixels per minute), remembered in this browser — storage can be unavailable (private
    // mode, blocked), so every access is guarded and the default is used then.
    const ZOOM_KEY = 'ff-timeline-zoom'
    let zoomIndex = DEFAULT_ZOOM_INDEX
    try {
      const saved = Number(localStorage.getItem(ZOOM_KEY))
      if (Number.isInteger(saved) && saved >= 0 && saved < ZOOM_LEVELS.length && localStorage.getItem(ZOOM_KEY) !== null) zoomIndex = saved
    } catch (e) {}
    const zoomOut = document.querySelector('#itl-zoom-out') as HTMLButtonElement
    const zoomIn = document.querySelector('#itl-zoom-in') as HTMLButtonElement
    function setZoom(i: number) {
      zoomIndex = Math.max(0, Math.min(ZOOM_LEVELS.length - 1, i))
      try { localStorage.setItem(ZOOM_KEY, String(zoomIndex)) } catch (e) {}
      render()
    }
    zoomOut.addEventListener('click', () => setZoom(zoomIndex - 1))
    zoomIn.addEventListener('click', () => setZoom(zoomIndex + 1))

    // Saving: the same as /itinerary — the whole plan in its { v: 2, days } form
    // (serializePlan), in this browser and, a second later, to /api/itinerary-save.
    const saveStatus = document.querySelector('#itl-save-status') as HTMLElement
    let saveTimer: ReturnType<typeof setTimeout> | undefined
    function saveState() {
      const payload = serializePlan(state, extraDays)
      try { localStorage.setItem(STORE_KEY, payload) } catch {}
      saveStatus.textContent = 'Lagrer…'
      clearTimeout(saveTimer)
      saveTimer = setTimeout(async () => {
        try {
          const res = await fetch('/api/itinerary-save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ data: payload }) })
          saveStatus.textContent = res.ok ? 'Lagret ✓' : 'Lagring feilet'
        } catch (e) {
          saveStatus.textContent = 'Lagret lokalt (ingen nett)'
        }
      }, 1000)
    }

    // Stops the last "Check day" had something to say about: index -> 'warning' | 'tip'. Cleared
    // when the day or the plan changes (indices would no longer match).
    let checkMarks: Record<number, string> = {}

    function render() {
      const di = state.findIndex((d) => d.day === currentDay)
      const day = state[di]
      dayEl.replaceChildren()
      if (!day) return
      renderDayBar(day)
      const { sched, inputs } = computeDayTimes(day, base, shopById)
      const range = timelineRange(sched)
      const px = ZOOM_LEVELS[zoomIndex]
      zoomOut.disabled = zoomIndex === 0
      zoomIn.disabled = zoomIndex === ZOOM_LEVELS.length - 1
      const grid = document.createElement('div')
      grid.className = 'itl-grid'
      grid.style.height = `${offsetFor(range.end, range, px)}px`
      grid.dataset.start = String(range.start)
      grid.dataset.px = String(px)
      grid.dataset.end = String(range.end)

      for (let m = range.start; m <= range.end; m += 60) {
        const hour = document.createElement('div')
        hour.className = 'itl-hour'
        hour.style.top = `${offsetFor(m, range, px)}px`
        hour.textContent = formatClock(m)
        grid.appendChild(hour)
      }

      // Travel in its own lane on the right (lib/itinerary-timeline.ts layoutTimeline): a striped
      // band with the label inside, or a small chip when the leg is too short for it.
      const layout = layoutTimeline(sched, range, px)
      layout.travel.forEach((tr) => {
        const el = document.createElement('div')
        el.className = 'itl-travel' + (tr.chip ? ' itl-travel-chip' : '')
        el.setAttribute('role', 'button')
        el.title = 'Travel time'
        el.style.top = `${tr.chip ? tr.chipTop : tr.top}px`
        el.style.height = `${tr.chip ? CHIP_PX : tr.height}px`
        el.dataset.index = String(tr.index)
        el.textContent = `${tr.mode === 'walk' ? '🚶' : '🚆'} ${tr.minutes} min`
        grid.appendChild(el)
      })

      // Stops: side by side in columns where they overlap (layoutTimeline).
      layout.stops.forEach((item) => {
        const el = document.createElement('div')
        el.style.top = `${item.top}px`
        el.style.height = `${item.height}px`
        el.style.left = `calc(var(--itl-gap) + var(--itl-cols-w) * ${item.col} / ${item.cols})`
        el.style.width = `calc(var(--itl-cols-w) / ${item.cols} - var(--itl-gap))`
        el.dataset.index = String(item.index)
        el.dataset.col = String(item.col)
        el.dataset.cols = String(item.cols)
        const x = sched.stops[item.index]
        const s = day.stops[item.index]
        const r = resolveStop(s, shopById)
        const closed = looksClosed(s.hours, x.start)
        const warnings: string[] = []
        if (x.doesntFit) warnings.push(`⚠️ Doesn't fit before ${formatClock(x.doesntFit.anchorTime)} (${x.doesntFit.shortMin} min short)`)
        else if (x.leaveEarlierMin) warnings.push(`⚠️ Leave ${x.leaveEarlierMin} min earlier`)
        if (closed) warnings.push(`⚠️ Closed ~${formatClock(x.start)}?`)
        el.className = 'itl-block' + (x.fixed ? ' itl-fixed' : '') + (x.doesntFit ? ' itl-warn-fit' : x.leaveEarlierMin ? ' itl-warn-leave' : closed ? ' itl-warn-closed' : '')
          + (checkMarks[item.index] ? ` itl-ir-${checkMarks[item.index]}` : '')
        if (checkMarks[item.index]) warnings.push(checkMarks[item.index] === 'warning' ? '🔍 See Check day' : '🔍 Tip in Check day')
        el.dataset.start = String(item.start)
        el.dataset.dur = String(inputs[item.index].durationMin)
        const time = x.fixed
          ? `📌 ${formatClock(x.start)}${x.arrival !== x.start ? ` (arrive ${formatClock(x.arrival)})` : ''}`
          : `${formatClock(x.start)}–${formatClock(x.end)}`
        // First line "name · time" (the name only ever shortens with an ellipsis), then the
        // opening hours, then any warnings.
        el.innerHTML = `
          <span class="itl-first"><span class="itl-name">${esc(r.name)}</span><span class="itl-sep"> · </span><span class="itl-time">${esc(time)}</span></span>
          ${s.hours ? `<span class="itl-hours">${esc(s.hours)}</span>` : ''}
          ${warnings.map((w) => `<span class="itl-badge">${esc(w)}</span>`).join('')}`
        grid.appendChild(el)
      })

      // The flight home: the latest the day's last stop can end (lib/itinerary-review-helpers.ts).
      if (flight && flight.date === day.day) {
        const latest = latestEndForFlight(flight)
        const line = document.createElement('div')
        line.className = 'itl-flight'
        line.style.top = `${offsetFor(latest, range, px)}px`
        line.textContent = `✈️ Leave for ${flight.airport} by ${formatClock(latest)} (${flight.line.replace('✈️ ', '')})`
        grid.appendChild(line)
      }

      const now = document.createElement('div')
      now.className = 'itl-now'
      now.hidden = true
      grid.appendChild(now)
      dayEl.appendChild(grid)
      // Room at the end so the last hour scrolls fully into view above the fixed bottom nav on
      // mobile: the nav's own height (0 where it's hidden, on wider screens) plus the safe area.
      const end = document.createElement('div')
      end.className = 'itl-end'
      const nav = document.querySelector('.bottom-nav') as HTMLElement | null
      end.style.setProperty('--itl-nav-h', `${nav ? nav.offsetHeight : 0}px`)
      dayEl.appendChild(end)
      updateNow()
    }

    // The red "now" line: Tokyo time (lib/trip-dates.ts tokyoNow), whatever the phone's timezone;
    // shown only on today's date in Tokyo, moved just after each minute starts.
    function updateNow() {
      const line = dayEl.querySelector('.itl-now') as HTMLElement | null
      const grid = dayEl.querySelector('.itl-grid') as HTMLElement | null
      if (!line || !grid) return
      const t = tokyoNow()
      const start = Number(grid.dataset.start)
      const top = (t.minutes - start) * Number(grid.dataset.px)
      const show = t.date === currentDay && top >= 0 && top <= grid.offsetHeight
      line.hidden = !show
      if (show) { line.style.top = `${Math.round(top)}px`; line.dataset.minutes = String(t.minutes) }
    }
    function tickEveryMinute() {
      setTimeout(() => { updateNow(); tickEveryMinute() }, 60000 - (Date.now() % 60000) + 50)
    }
    tickEveryMinute()

    // --- The day toolbar: start time, Check day, Suggest route, the day's route ----------------
    const startInput = document.querySelector('#itl-start') as HTMLInputElement
    const checkBtn = document.querySelector('#itl-check-btn') as HTMLButtonElement
    const routeBtn = document.querySelector('#itl-route-btn') as HTMLButtonElement
    const dayRouteEl = document.querySelector('#itl-dayroute') as HTMLElement
    const checkPanel = document.querySelector('#itl-check-results') as HTMLElement
    const routePanel = document.querySelector('#itl-route-results') as HTMLElement
    const mapSection = document.querySelector('#itl-map-section') as HTMLDetailsElement
    const mapEl = document.querySelector('#itl-map') as HTMLElement
    let mapInstance: any = null
    const currentDayPlan = () => state.find((d) => d.day === currentDay)!

    // "🗺️ Route for the day": Google Maps through the stops in order, base first and last
    // (itinerary-plan.ts dayRouteUrls — the list's own links; more than 10 points come in parts).
    function renderDayBar(day: PlanDay) {
      startInput.value = day.startTime
      const urls = dayRouteUrls(day.stops.map((s) => resolveStop(s, shopById)), base)
      dayRouteEl.innerHTML = urls
        .map((u, i) => `<a class="itl-dayroute-link" href="${esc(u)}" target="_blank" rel="noopener">🗺️ ${urls.length > 1 ? `Route part ${i + 1}` : 'Route for the day'}</a>`)
        .join('')
      if (mapSection.open) drawMap(day)
    }

    // The map (closed by default): the same as /itinerary's (itinerary-ui.ts drawDayMap).
    function drawMap(day: PlanDay) {
      if (mapInstance) { try { mapInstance.remove() } catch (e) {} mapInstance = null }
      loadLeaflet().then((ok) => {
        if (!ok || !mapSection.open || currentDayPlan() !== day) return
        if (mapInstance) { try { mapInstance.remove() } catch (e) {} }
        mapInstance = drawDayMap(mapEl, day, base, shopById)
      })
    }
    mapSection.addEventListener('toggle', () => { if (mapSection.open) drawMap(currentDayPlan()) })

    startInput.addEventListener('change', () => {
      currentDayPlan().startTime = startInput.value || DEFAULT_START
      checkMarks = {}
      saveState(); render()
    })

    // "🔍 Check day": the same request and results as the list (itinerary-ui.ts runCheckDay);
    // a stop's item also marks its block, and tapping the item scrolls to it.
    function scrollToBlock(i: number) {
      const block = dayEl.querySelector(`.itl-block[data-index="${i}"]`) as HTMLElement | null
      if (!block) return
      block.scrollIntoView({ behavior: 'smooth', block: 'center' })
      block.classList.add('itl-flash')
      setTimeout(() => block.classList.remove('itl-flash'), 1600)
    }
    checkBtn.addEventListener('click', async () => {
      const day = currentDayPlan()
      const items = await runCheckDay(checkBtn, checkPanel, checkDayRequestBody(day, { base, shopById, flight }), {
        stopName: (i) => (day.stops[i] ? resolveStop(day.stops[i], shopById).name : `Stop ${i + 1}`),
        onStopClick: (i) => scrollToBlock(i),
      })
      checkMarks = {}
      ;(items || []).forEach((it) => {
        if (typeof it.stopIndex !== 'number') return
        if (checkMarks[it.stopIndex] !== 'warning') checkMarks[it.stopIndex] = it.severity === 'warning' ? 'warning' : 'tip'
      })
      render()
    })

    // "🧭 Suggest route": the same optimizer and preview as the list; Apply and Undo save the
    // same way (state -> saveState -> render).
    const undoByDay: Record<string, PlanDay['stops']> = {}
    routeBtn.addEventListener('click', () => {
      const day = currentDayPlan()
      if (!day.stops.length) { renderNoStopsToReorder(routePanel); return }
      const input = optimizerInput(day, { base, shopById })
      const result = optimizeRoute(input.stops, input.startTime, input.start)
      renderRouteSuggestion(routePanel, result, {
        stopName: (origIdx) => resolveStop(day.stops[origIdx], shopById).name,
        fmt: formatClock,
        onApply: () => {
          undoByDay[day.day] = day.stops.slice()
          day.stops = result.order.map((i) => day.stops[i])
          checkMarks = {}
          saveState(); render()
          renderRouteApplied(routePanel, () => {
            day.stops = undoByDay[day.day]
            delete undoByDay[day.day]
            checkMarks = {}
            saveState(); render()
            routePanel.hidden = true
          })
        },
      })
    })

    // --- Tap a travel chip or band: the same travel time editor as the list ------------------
    const travelEditor = document.querySelector('#itl-travel-editor') as HTMLElement
    const travelEdit = document.querySelector('#itl-travel-edit') as HTMLElement
    document.querySelector('#itl-travel-editor-close')!.addEventListener('click', () => { travelEditor.hidden = true })
    function openTravelEditor(idx: number) {
      const day = currentDayPlan()
      if (!day.stops[idx]) return
      const { sched } = computeDayTimes(day, base, shopById)
      const from = idx === 0 ? { name: 'Base', lat: base.lat, lng: base.lng } : resolveStop(day.stops[idx - 1], shopById)
      const to = resolveStop(day.stops[idx], shopById)
      ;(document.querySelector('#itl-travel-editor-title') as HTMLElement).textContent = `${from.name} → ${to.name}`
      travelEdit.innerHTML = travelEditorInnerHtml({ manual: manualTravelFor(day, idx, shopById), placeholder: sched.stops[idx].travelIn.minutes, from, to })
      bindTravelEditor(travelEdit, (minutes) => {
        const s = day.stops[idx]
        if (minutes == null) { delete s.travelMin; delete s.travelFrom }
        else { s.travelMin = minutes; s.travelFrom = legFromKey(day, idx, shopById) }
        travelEditor.hidden = true
        saveState(); render()
      })
      travelEditor.hidden = false
      travelEditor.scrollIntoView({ block: 'nearest' })
    }
    dayEl.addEventListener('click', (e) => {
      const travel = (e.target as HTMLElement).closest('.itl-travel') as HTMLElement | null
      if (travel) openTravelEditor(Number(travel.dataset.index))
    })

    // --- Tap a block: its details, and "Edit in list" (read-only here) -------------------------
    const detail = document.querySelector('#itl-detail') as HTMLElement
    document.querySelector('#itl-detail-close')!.addEventListener('click', () => { detail.hidden = true })
    function showDetails(idx: number) {
      const day = state.find((d) => d.day === currentDay)
      if (!day || !day.stops[idx]) return
      const { sched, inputs } = computeDayTimes(day, base, shopById)
      const x = sched.stops[idx]
      const s = day.stops[idx]
      const lines: string[] = []
      lines.push(x.fixed ? `📌 ${formatClock(x.start)}–${formatClock(x.end)}${x.arrival !== x.start ? ` · arrive by ${formatClock(x.arrival)}` : ''}` : `${formatClock(x.start)}–${formatClock(x.end)} (${inputs[idx].durationMin} min)`)
      if (s.hours) lines.push(`Opening hours: ${s.hours}`)
      if (x.leaveBy != null) lines.push(`Leave by ${formatClock(x.leaveBy)}`)
      if (x.stayUntil != null) lines.push(`You can stay until ${formatClock(x.stayUntil)}`)
      if (x.doesntFit) lines.push(`⚠️ Doesn't fit before ${resolveStop(day.stops[x.doesntFit.anchorIndex], shopById).name} ${formatClock(x.doesntFit.anchorTime)} (${x.doesntFit.shortMin} min short)`)
      else if (x.leaveEarlierMin) lines.push(`⚠️ Leave ${x.leaveEarlierMin} min earlier`)
      if (looksClosed(s.hours, x.start)) lines.push(`⚠️ Closed ~${formatClock(x.start)}?`)
      ;(document.querySelector('#itl-detail-name') as HTMLElement).textContent = resolveStop(s, shopById).name
      ;(document.querySelector('#itl-detail-lines') as HTMLElement).innerHTML = lines.map((l) => `<li>${esc(l)}</li>`).join('')
      // /itinerary opens with this day and stop in view (?day=&stop=).
      const params = new URLSearchParams(wrap.dataset.tripQuery ? wrap.dataset.tripQuery.slice(1) : '')
      params.set('day', currentDay)
      params.set('stop', String(idx))
      ;(document.querySelector('#itl-detail-edit') as HTMLAnchorElement).href = `/itinerary?${params.toString()}`
      detail.hidden = false
      detail.scrollIntoView({ block: 'nearest' })
    }
    dayEl.addEventListener('click', (e) => {
      const block = (e.target as HTMLElement).closest('.itl-block') as HTMLElement | null
      if (block) showDetails(Number(block.dataset.index))
    })

    // --- Tap an empty spot: add a stop there ---------------------------------------------------
    const addForm = document.querySelector('#itl-add') as HTMLFormElement
    const addTime = document.querySelector('#itl-add-time') as HTMLElement
    const addShop = document.querySelector('#itl-add-shop') as HTMLSelectElement
    const addCustom = document.querySelector('#itl-add-custom') as HTMLElement
    const addName = document.querySelector('#itl-add-name') as HTMLInputElement
    const addHours = document.querySelector('#itl-add-hours') as HTMLInputElement
    const addDur = document.querySelector('#itl-add-dur') as HTMLInputElement
    let addMinutes = 0
    // The same grouped list as /itinerary's add-stop (shopOptionGroups), then "write it yourself".
    addShop.innerHTML = '<option value="">Choose a place…</option>' +
      shopOptionGroups(shops || []).map(({ area, items }) =>
        `<optgroup label="${esc(area)}">${items.map(({ i, name, hasCoord }) => `<option value="${i}">${esc(name)}${hasCoord ? '' : ' (uten koord.)'}</option>`).join('')}</optgroup>`
      ).join('') + '<option value="__custom__">✏️ Write it yourself</option>'
    addShop.addEventListener('change', () => { addCustom.hidden = addShop.value !== '__custom__' })

    dayEl.addEventListener('click', (e) => {
      const target = e.target as HTMLElement
      const grid = dayEl.querySelector('.itl-grid') as HTMLElement | null
      if (!grid || (target !== grid && !target.classList.contains('itl-hour'))) return
      const range = { start: Number(grid.dataset.start), end: Number(grid.dataset.end) }
      addMinutes = minutesAtOffset(e.clientY - grid.getBoundingClientRect().top, range, Number(grid.dataset.px))
      addTime.textContent = formatClock(addMinutes)
      addShop.value = ''; addCustom.hidden = true; addName.value = ''; addHours.value = ''; addDur.value = '45'
      addForm.hidden = false
      addForm.scrollIntoView({ block: 'nearest' })
    })
    document.querySelector('#itl-add-cancel')!.addEventListener('click', () => { addForm.hidden = true })
    addForm.addEventListener('submit', (e) => {
      e.preventDefault()
      const day = state.find((d) => d.day === currentDay)
      if (!day) return
      let stop
      if (addShop.value === '__custom__') {
        const name = addName.value.trim()
        if (!name) { addName.focus(); return }
        stop = customStopFrom(name, addHours.value.trim())
      } else if (addShop.value !== '') {
        const shop = (shops || [])[+addShop.value]
        if (!shop) return
        stop = shopStopFrom(shop)
      } else return
      const dur = parseInt(addDur.value, 10)
      if (!isNaN(dur) && dur > 0) stop.dur = dur
      // In the order after the last stop starting at or before the tapped time — not pinned to it.
      const { times } = computeDayTimes(day, base, shopById)
      const at = insertIndexForTime(times, addMinutes)
      day.stops.splice(at, 0, stop)
      addForm.hidden = true
      saveState()
      render()
      const added = dayEl.querySelector(`.itl-block[data-index="${at}"]`)
      if (added) { added.classList.add('itl-new'); added.scrollIntoView({ block: 'nearest' }) }
    })

    document.querySelectorAll<HTMLButtonElement>('.itl-tab').forEach((tab) => tab.addEventListener('click', () => {
      currentDay = tab.dataset.day!
      checkMarks = {}
      checkPanel.hidden = true; routePanel.hidden = true; travelEditor.hidden = true
      document.querySelectorAll<HTMLButtonElement>('.itl-tab').forEach((t) => {
        t.classList.toggle('active', t === tab)
        t.setAttribute('aria-selected', t === tab ? 'true' : 'false')
      })
      try {
        const url = new URL(window.location.href)
        url.searchParams.set('day', currentDay)
        history.replaceState(null, '', url.toString())
      } catch (e) {}
      render()
    }))

    render()
    // Exposed for tests and the later steps (insert / details) of this page.
    Object.assign(window, { __itl: { get state() { return state }, extraDays, render, serializePlan } })
  </script>

