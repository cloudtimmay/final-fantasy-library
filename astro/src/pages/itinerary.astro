  'Shinjuku': 15,
  'Ikebukuro': 15,
  'Shibuya': 20,
  'Harajuku': 22,
  'Tokyo Station': 5,
  'Nakano': 25,
  'Yokohama': 45,
  'Shinagawa': 12,
