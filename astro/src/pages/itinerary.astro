      if (!sheetStop) return
      ;(document.querySelector('#itl-ed-coord-msg') as HTMLElement).hidden = true
      fillSheet()
      detail.hidden = false
    }
    // Any change: save, redraw, and refresh the sheet on the same stop.
    function changed() { checkMarks = {}; saveState(); render(); if (sheetStop) fillSheet() }
    const withStop = (fn: (s: PlanStop, idx: number, day: PlanDay) => void) => () => {
      const idx = sheetIdx()
      if (idx >= 0) fn(sheetStop!, idx, sheetDay())
    }
    ed('dur').addEventListener('change', withStop((s) => { setStopDuration(s, ed('dur').value); changed() }))
    ed('time').addEventListener('change', withStop((s, idx, day) => { setFixedTime(day, idx, ed('time').value, base, shopById); changed() }))
    ed('leaveat').addEventListener('change', withStop((s) => { setLeaveAt(s, ed('leaveat').value); changed() }))
    document.querySelector('#itl-ed-leaveat-clear')!.addEventListener('click', withStop((s) => { setLeaveAt(s, ''); changed() }))
    document.querySelector('#itl-ed-until-close')!.addEventListener('click', withStop((s) => {
      setLeaveAt(s, (document.querySelector('#itl-ed-until-close') as HTMLElement).dataset.time || '')
      changed()
    }))
    ed('early').addEventListener('change', withStop((s) => { setArriveEarly(s, ed('early').value); changed() }))
    ed('tag').addEventListener('change', withStop((s) => { const v = ed('tag').value.trim(); s.tag = v; changed() }))
    document.querySelector('#itl-ed-note')!.addEventListener('change', withStop((s) => {
