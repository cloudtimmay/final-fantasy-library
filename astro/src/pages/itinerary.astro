---
<Base title="Itinerary">
  <div class="page-header">
    <h1>Shopping-plan</h1>
    <span class="count">1.–7. des · base Akihabara</span>
  </div>

  <div class="plan-tip">
    <span>Kartet viser rekkefølgen: <strong>🏠 base → 1 → 2 → …→ 🏠</strong>. Bruk <strong>▲▼</strong> for å flytte · <strong>✕</strong> fjerne · <strong>+</strong> legge til · <strong>🗺️</strong> åpner ruten i Google Maps.</span>
    <button id="reset-btn" class="reset-btn" type="button">↺ Tilbakestill</button>
  </div>

  <div id="days"></div>

  <script type="application/json" id="plan-data" set:html={JSON.stringify({ plan: PLAN, areaMin: AREA_MIN_FROM_AKIB, base: BASE })}></script>

  <script is:inline>
    // Load Leaflet (free, no key) then build the page.
    function loadLeaflet() {
      return new Promise((resolve) => {
        if (window.L) return resolve()
        const css = document.createElement('link')
        css.rel = 'stylesheet'
        css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'
        document.head.appendChild(css)
        const js = document.createElement('script')
        js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'
        js.onload = () => resolve()
        js.onerror = () => resolve() // fail gracefully; list still works
        document.head.appendChild(js)
      })
    }

    const STORE_KEY = 'ff-itinerary-v7'
    const raw = document.querySelector('#plan-data')?.textContent || '{}'
    const { plan, areaMin, base } = JSON.parse(raw)
    const daysEl = document.querySelector('#days')
    const resetBtn = document.querySelector('#reset-btn')

    let mapInstances = []

    function loadSaved() {
      try { const s = localStorage.getItem(STORE_KEY); return s ? JSON.parse(s) : null } catch { return null }
    }
    function saveState() {
      try { localStorage.setItem(STORE_KEY, JSON.stringify(state.map((d) => d.stops))) } catch {}
    }
    function buildState() {
      const saved = loadSaved()
      return plan.map((day, di) => ({
        date: day.date, area: day.area,
        stops: (saved && saved[di]) ? saved[di] : day.stops.slice(),
      }))
    }
    let state = buildState()

    function distM(a, b) {
      const R = 6371000, toRad = (d) => d * Math.PI / 180
      const dLat = toRad(b.lat - a.lat), dLng = toRad(b.lng - a.lng)
      const x = Math.sin(dLat/2)**2 + Math.cos(toRad(a.lat))*Math.cos(toRad(b.lat))*Math.sin(dLng/2)**2
      return 2 * R * Math.asin(Math.sqrt(x))
    }
    function walkText(a, b) {
      if (!a || !b || a.lat == null || b.lat == null) return ''
      const walkM = distM(a, b) * 1.4
      if (walkM > 2500) return `🚃 ~${Math.round(walkM/1000*3)} min (ta tog)`
      return `🚶 ~${Math.max(1, Math.round(walkM/80))} min · ${Math.round(walkM)} m`
    }
    function travelBadge(area) {
      const key = Object.keys(areaMin).find((k) => area.includes(k))
      const min = key != null ? areaMin[key] : null
      if (min == null) return ''
      if (min === 0) return '🏠 base'
      return `🚃 ~${min} min fra base`
    }
    function dayRouteUrl(day) {
      const pts = day.stops.filter((s) => s.lat != null && s.lng != null).map((s) => `${s.lat},${s.lng}`)
      const baseP = `${base.lat},${base.lng}`
      const all = [baseP, ...pts, baseP]
      if (all.length < 2) return ''
      const origin = all[0], destination = all[all.length - 1]
      const waypoints = all.slice(1, -1).join('|')
      let url = `https://www.google.com/maps/dir/?api=1&origin=${origin}&destination=${destination}&travelmode=walking`
      if (waypoints) url += `&waypoints=${encodeURIComponent(waypoints)}`
      return url
    }

    function baseRow(label) {
      return `
        <li class="stop is-base">
          <div class="move-col"><span class="base-icon">🏠</span></div>
          <span class="stop-body"><span class="stop-name">${label}</span></span>
        </li>`
    }

    function initMap(di, day) {
      if (!window.L) return
      const el = document.getElementById(`map-${di}`)
      if (!el) return
      const pts = day.stops.filter((s) => s.lat != null && s.lng != null)
      const map = L.map(el, { scrollWheelZoom: false, attributionControl: true })
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19, attribution: '© OpenStreetMap'
      }).addTo(map)

      const latlngs = []
      // Base marker (start + end).
      const baseIcon = L.divIcon({ className: '', html: '<div class="pin base">🏠</div>', iconSize: [28,28], iconAnchor: [14,14] })
      L.marker([base.lat, base.lng], { icon: baseIcon }).addTo(map).bindPopup('Base (start/slutt)')
      latlngs.push([base.lat, base.lng])

      // Numbered stop markers.
      pts.forEach((s, i) => {
        const icon = L.divIcon({ className: '', html: `<div class="pin ${s.tag === 'mat' ? 'food' : s.tag === 'MUST' ? 'must' : ''}">${i+1}</div>`, iconSize: [26,26], iconAnchor: [13,13] })
        L.marker([s.lat, s.lng], { icon }).addTo(map).bindPopup(`${i+1}. ${s.name}`)
        latlngs.push([s.lat, s.lng])
      })
      latlngs.push([base.lat, base.lng]) // back to base

      // Route line base → stops → base.
      L.polyline(latlngs, { color: '#f4a24c', weight: 3, opacity: 0.8, dashArray: '6 6' }).addTo(map)
      map.fitBounds(latlngs, { padding: [30, 30] })
      // Ensure correct sizing after layout.
      setTimeout(() => map.invalidateSize(), 100)
      mapInstances.push(map)
    }

    function render() {
      // Clean up old maps.
      mapInstances.forEach((m) => { try { m.remove() } catch {} })
      mapInstances = []
      daysEl.innerHTML = ''

      state.forEach((day, di) => {
        const card = document.createElement('div')
        card.className = 'day-card'
        const routeUrl = dayRouteUrl(day)
        card.innerHTML = `
          <div class="day-head">
            <div>
              <div class="day-title">${day.date}</div>
              <div class="day-area">${day.area}</div>
            </div>
            <div class="day-travel">${travelBadge(day.area)}</div>
          </div>
          <div id="map-${di}" class="day-map"></div>
          ${routeUrl ? `<a class="route-btn" href="${routeUrl}" target="_blank" rel="noopener">🗺️ Åpne ruten i Google Maps</a>` : ''}
          <ul class="stop-list" data-day="${di}"></ul>
          <button class="add-stop-btn" data-day="${di}" type="button">+ Legg til stopp</button>
          <div class="add-form" data-day="${di}" hidden>
            <input class="af-name" type="text" placeholder="Navn på stopp *" />
            <input class="af-hours" type="text" placeholder="Åpningstider (valgfritt)" />
            <div class="af-row">
              <button class="af-save" type="button">Legg til</button>
              <button class="af-cancel" type="button">Avbryt</button>
            </div>
          </div>
        `
        const ul = card.querySelector('.stop-list')

        ul.insertAdjacentHTML('beforeend', baseRow('Start: base'))
        const firstStop = day.stops[0]
        if (firstStop) {
          const wt = walkText(base, firstStop)
          if (wt) ul.insertAdjacentHTML('beforeend', `<li class="walk-row"><span class="walk-line">${wt} →</span></li>`)
        }

        day.stops.forEach((s, si) => {
          const li = document.createElement('li')
          li.className = 'stop' + (s.tag === 'mat' ? ' is-food' : '')
          const tagHtml = s.tag
            ? `<span class="stop-tag ${s.tag === 'MUST' ? 'must' : s.tag === 'mat' ? 'food' : 'note'}">${s.tag}</span>`
            : ''
          const gmap = (s.lat != null) ? `https://www.google.com/maps?q=${s.lat},${s.lng}` : ''
          li.innerHTML = `
            <div class="move-col">
              <button class="mv up" data-day="${di}" data-idx="${si}" ${si === 0 ? 'disabled' : ''} title="Opp">▲</button>
              <span class="stop-num">${si + 1}</span>
              <button class="mv down" data-day="${di}" data-idx="${si}" ${si === day.stops.length - 1 ? 'disabled' : ''} title="Ned">▼</button>
            </div>
            <span class="stop-body">
              <span class="stop-name">${gmap ? `<a href="${gmap}" target="_blank" rel="noopener">${s.name}</a>` : s.name}</span>
              ${s.hours ? `<span class="stop-hours">${s.hours}</span>` : ''}
            </span>
            ${tagHtml}
            <button class="remove-btn" data-day="${di}" data-idx="${si}" title="Fjern">✕</button>
          `
          ul.appendChild(li)
          const next = day.stops[si + 1]
          if (next) {
            const wt = walkText(s, next)
            if (wt) ul.insertAdjacentHTML('beforeend', `<li class="walk-row"><span class="walk-line">${wt} →</span></li>`)
          }
        })

        const lastStop = day.stops[day.stops.length - 1]
        if (lastStop) {
          const wt = walkText(lastStop, base)
          if (wt) ul.insertAdjacentHTML('beforeend', `<li class="walk-row"><span class="walk-line">${wt} →</span></li>`)
        }
        ul.insertAdjacentHTML('beforeend', baseRow('Tilbake til base'))

        daysEl.appendChild(card)
      })

      // Init maps after DOM is in place.
      state.forEach((day, di) => initMap(di, day))
      attachEvents()
    }

    function move(di, idx, delta) {
      const arr = state[di].stops
      const ni = idx + delta
      if (ni < 0 || ni >= arr.length) return
      ;[arr[idx], arr[ni]] = [arr[ni], arr[idx]]
      saveState(); render()
    }

    function attachEvents() {
      document.querySelectorAll('.mv.up').forEach((b) =>
        b.addEventListener('click', () => move(+b.dataset.day, +b.dataset.idx, -1)))
      document.querySelectorAll('.mv.down').forEach((b) =>
        b.addEventListener('click', () => move(+b.dataset.day, +b.dataset.idx, +1)))
      document.querySelectorAll('.remove-btn').forEach((btn) =>
        btn.addEventListener('click', () => {
          state[+btn.dataset.day].stops.splice(+btn.dataset.idx, 1)
          saveState(); render()
        }))
      document.querySelectorAll('.add-stop-btn').forEach((btn) =>
        btn.addEventListener('click', () => {
          const form = daysEl.querySelector(`.add-form[data-day="${btn.dataset.day}"]`)
          if (form) { form.hidden = false; form.querySelector('.af-name').focus() }
        }))
      document.querySelectorAll('.add-form').forEach((form) => {
        const di = +form.dataset.day
        form.querySelector('.af-cancel').addEventListener('click', () => {
          form.hidden = true; form.querySelector('.af-name').value = ''; form.querySelector('.af-hours').value = ''
        })
        form.querySelector('.af-save').addEventListener('click', () => {
          const name = form.querySelector('.af-name').value.trim()
          if (!name) return
          const hours = form.querySelector('.af-hours').value.trim()
          state[di].stops.push({ name, hours, tag: '', lat: null, lng: null })
          saveState(); render()
        })
      })
    }

    resetBtn.addEventListener('click', () => {
      if (!confirm('Tilbakestille hele planen? Dine endringer forsvinner.')) return
      try { localStorage.removeItem(STORE_KEY) } catch {}
      state = plan.map((d) => ({ date: d.date, area: d.area, stops: d.stops.slice() }))
      render()
    })

    loadLeaflet().then(render)
  </script>

  <style is:global>
    .pin {
      display: flex; align-items: center; justify-content: center;
      width: 100%; height: 100%; border-radius: 50%;
      background: #f4a24c; color: #2a1a04; font-weight: 700; font-size: 12px;
      border: 2px solid #fff; box-shadow: 0 1px 4px rgba(0,0,0,0.5);
      font-family: 'IBM Plex Mono', monospace;
    }
    .pin.must { background: #e74c3c; color: #fff; }
    .pin.food { background: #f5c542; color: #2a1a04; }
    .pin.base { background: #1c1420; color: #f4a24c; border-color: #f4a24c; font-size: 14px; }
  </style>

  <style>
    .plan-tip {
      font-size: 0.85rem; color: var(--muted); margin: 0 0 1.5rem; max-width: 680px;
      background: rgba(244,162,76,0.08); border: 1px solid rgba(244,162,76,0.25);
      border-radius: 8px; padding: 0.7rem 0.9rem;
      display: flex; gap: 0.75rem; justify-content: space-between; align-items: center; flex-wrap: wrap;
    }
    .plan-tip strong { color: var(--accent); }
    .reset-btn {
      background: var(--surface); color: var(--text); border: 1px solid var(--border);
      padding: 0.3rem 0.7rem; border-radius: 6px; cursor: pointer; font-size: 0.8rem; white-space: nowrap;
    }
    .reset-btn:hover { border-color: var(--accent); }

    #days { display: flex; flex-direction: column; gap: 1.5rem; max-width: 680px; }
    .day-card {
      background: var(--surface); border: 1px solid rgba(176,30,52,0.25);
      border-radius: 10px; padding: 1rem; overflow: hidden; max-width: 100%; box-sizing: border-box;
    }
    .day-head {
      display: flex; justify-content: space-between; align-items: flex-start;
      gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.75rem;
      padding-bottom: 0.6rem; border-bottom: 1px solid rgba(176,30,52,0.2);
    }
    .day-title {
      font-family: 'IBM Plex Mono', monospace; font-weight: 600; font-size: 1.05rem;
      color: var(--accent); text-shadow: 0 0 10px rgba(244,162,76,0.3);
    }
    .day-area { font-size: 0.9rem; color: var(--text); margin-top: 0.15rem; }
    .day-travel { font-size: 0.72rem; color: var(--muted); font-family: 'IBM Plex Mono', monospace; text-align: right; }

    .day-map {
      height: 240px; border: 1px solid var(--border); border-radius: 8px;
      overflow: hidden; margin-bottom: 0.6rem; max-width: 100%; background: #1a1a1a;
    }
    .route-btn {
      display: block; text-align: center; background: var(--bg); color: var(--text);
      border: 1px solid var(--accent); padding: 0.55rem; border-radius: 8px;
      text-decoration: none; font-size: 0.88rem; font-weight: 600; margin-bottom: 0.9rem;
    }
    .route-btn:hover { background: rgba(244,162,76,0.1); }

    .stop-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.3rem; }
    .stop {
      display: flex; align-items: center; gap: 0.5rem;
      background: rgba(26,12,18,0.5); border: 1px solid var(--border);
      border-radius: 8px; padding: 0.5rem 0.55rem;
