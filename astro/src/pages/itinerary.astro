      // "No shop photos yet" (with a link to the shop page) for a linked shop without photos.
      const shop = s.shopId ? shopById.get(s.shopId) : undefined
      const strip = shopPhotoStripHtml(shop)
      const photosEl = document.querySelector('#itl-ed-photos') as HTMLElement
      photosEl.innerHTML = strip ? `<p class="itl-strip-title">📷 Shop photos</p>${strip}` : ''
      photosEl.hidden = !strip
      ;(document.querySelector('#itl-ed-photos-empty') as HTMLElement).hidden = !shop || !!strip
      if (shop) (document.querySelector('#itl-ed-photos-add') as HTMLAnchorElement).href = shopPageUrl(shop._id, '#shop-photos')
      const foundStrip = shop ? foundStripHtml(foundByShop[shop._id], foundRate, backQuery()) : ''
      const foundEl = document.querySelector('#itl-ed-found') as HTMLElement
      foundEl.innerHTML = foundStrip ? `<p class="itl-strip-title">🔎 Found here</p>${foundStrip}` : ''
      foundEl.hidden = !foundStrip
      const place = resolveStop(s, shopById)
      ;(document.querySelector('#itl-ed-gmaps') as HTMLAnchorElement).href = googleMapsPlaceUrl({
        name: place.name, lat: place.lat, lng: place.lng, address: shop?.address, area: shop?.area,
      })
      ;(document.querySelector('#itl-detail-lines') as HTMLElement).innerHTML = lines.map((l) => `<li>${typeof l === 'string' ? esc(l) : l.html}</li>`).join('')
      const now = nowButtons(day, x)
      ed('here').hidden = !now.here
      ed('leave').hidden = !now.leave
      ;(document.querySelector('#itl-ed-now') as HTMLElement).hidden = !now.here && !now.leave
      // "🚪 Leave at": while it's set the visit's length follows from it (shown, not editable).
      ed('dur').value = String(s.leaveAt ? x.end - x.start : inputs[idx].durationMin)
      ed('dur').disabled = !!s.leaveAt
      ed('leaveat').value = s.leaveAt || ''
      // "🔗 Link to shop" for a stop without one (or whose shop is gone).
      const unlinked = !s.shopId || !shopById.has(s.shopId)
      ;(document.querySelector('#itl-ed-link') as HTMLElement).hidden = !unlinked
      if (unlinked) (document.querySelector('#itl-ed-link-shop') as HTMLSelectElement).innerHTML = shopPickerOptions(suggestShop(s.name, shops || [])?.shop._id || null)
      ;(document.querySelector('#itl-ed-leaveat-clear') as HTMLButtonElement).hidden = !s.leaveAt
      // "Until closing": the shop's closing time that day (hidden when unknown or open 24 hours).
      const closes = closingTimeFor(s, shopById, day.day, x.start)
      const untilBtn = document.querySelector('#itl-ed-until-close') as HTMLButtonElement
