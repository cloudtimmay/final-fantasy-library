      ed('time').value = s.fixedTime || ''
      ed('early').value = typeof s.arriveEarly === 'number' ? String(s.arriveEarly) : ''
      ;(document.querySelector('#itl-ed-early-label') as HTMLElement).hidden = !s.fixedTime
      ed('tag').value = s.tag || ''
      ;(document.querySelector('#itl-ed-note') as HTMLTextAreaElement).value = typeof s.note === 'string' ? s.note : ''
      ;(document.querySelector('#itl-ed-up') as HTMLButtonElement).disabled = idx === 0
      ;(document.querySelector('#itl-ed-down') as HTMLButtonElement).disabled = idx === day.stops.length - 1
      const move = document.querySelector('#itl-ed-move') as HTMLSelectElement
      move.innerHTML = '<option value="">—</option>' + state.filter((d) => d !== day).map((d) => `<option value="${esc(d.day)}">${esc(d.date)}</option>`).join('')
      ed('coord').value = s.lat != null && s.lng != null ? `${s.lat}, ${s.lng}` : ''
      ;(document.querySelector('#itl-ed-coord-fetch') as HTMLButtonElement).hidden = !s.shopId
