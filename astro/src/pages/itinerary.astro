---
import Base from '../layouts/Base.astro'
import { sanity } from '../lib/sanity'

const BASE = { name: 'Base (overnatting)', lat: 35.697999, lng: 139.770830 }

const AREA_MIN_FROM_AKIB: Record<string, number> = {
