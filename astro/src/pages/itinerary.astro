      if (v) s.note = v; else delete s.note
      changed()
    }))
    document.querySelector('#itl-ed-up')!.addEventListener('click', withStop((s, idx, day) => { if (moveStopBy(day, idx, -1)) changed() }))
    document.querySelector('#itl-ed-down')!.addEventListener('click', withStop((s, idx, day) => { if (moveStopBy(day, idx, +1)) changed() }))
    document.querySelector('#itl-ed-move')!.addEventListener('change', withStop((s, idx, day) => {
