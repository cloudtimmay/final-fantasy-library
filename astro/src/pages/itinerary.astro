      { name: 'SURUGA-YA Marui Annex', hours: '11:00–21:00', tag: 'MUST' },
      { name: 'ONE PIECE Base Shop', hours: '11:00–20:00', tag: '' },
      { name: 'Bic Camera Shinjuku West', hours: '10:00–22:00', tag: '' },
      { name: 'BOOKOFF Shinjuku West', hours: '10:00–22:00', tag: '' },
      { name: 'Book-Off Shinjuku', hours: '10:00–22:00', tag: '' },
      { name: 'DAISO', hours: '10:00–21:00', tag: '' },
      { name: 'Hard Off Marui Men', hours: '11:00–20:00', tag: '' },
      { name: 'Yellow Submarine Shinjuku', hours: '12:00–20:00', tag: '' },
