    }))
    const coordCb = () => {
      const msg = document.querySelector('#itl-ed-coord-msg') as HTMLElement
      return {
        save: saveState,
        msg: (text: string, color: string) => { msg.hidden = false; msg.textContent = text; msg.style.color = color },
        done: () => { render(); if (sheetStop) fillSheet() },
      }
    }
    document.querySelector('#itl-ed-coord-save')!.addEventListener('click', withStop((s) => { saveStopCoords(s, ed('coord').value, coordCb()) }))
    document.querySelector('#itl-ed-coord-fetch')!.addEventListener('click', withStop((s) => { fetchStopCoordsFromShop(s, coordCb()) }))
    ed('here').addEventListener('click', withStop((s, idx, day) => { markNow('here', day, idx); fillSheet() }))
    ed('leave').addEventListener('click', withStop((s, idx, day) => { markNow('leave', day, idx); fillSheet() }))
    // --- "✅ Bought" on a find in the strip ---------------------------------------------------
    // /edit-price's defaults: buyer the entry's (else the owner), trip the entry's, else the last
    // one used (shared with /add-price and /edit-price), else this itinerary's trip — kept only
    // if the buyer has a budget on it (public/trip-select.js); passport the owner's (Shop in Japan
    // only); "Add to" from the category (owner only; fixed once something was created). Then
    // the same checks and /api/price-entry-update bought save as /edit-price, with the entry's
    // other fields unchanged. On success the find shows ✅ Bought; on an error it stays.
    const PRICE_TRIPS = DATA.priceTrips || []
    const LAST_TRIP_KEY = 'ff-last-trip' // the same as /add-price and /edit-price
    const bought = document.querySelector('#itl-bought') as HTMLElement
    const bEl = (id: string) => document.querySelector(`#itl-bought-${id}`) as HTMLSelectElement
    let boughtItem: FoundItem | null = null
    function boughtMsg(text: string) {
      const m = document.querySelector('#itl-bought-msg') as HTMLElement
      m.hidden = !text
      m.textContent = text
    }
    function updateBoughtFields() {
      ;(document.querySelector('#itl-bought-addto-field') as HTMLElement).hidden = bEl('buyer').value !== OWNER
      ;(document.querySelector('#itl-bought-passport-field') as HTMLElement).hidden = priceEntryFormValues(boughtItem?.entry || {}).sourceType !== 'japanStore'
    }
    function openBought(item: FoundItem) {
      const e = item.entry!
      boughtItem = item
      ;(document.querySelector('#itl-bought-name') as HTMLElement).textContent = item.name
      bEl('buyer').value = e.buyer || OWNER
      let lastTrip = ''
      try { lastTrip = localStorage.getItem(LAST_TRIP_KEY) || '' } catch (err) {}
      ;(window as any).applyBuyerTripFilter(bEl('trip'), PRICE_TRIPS, bEl('buyer').value, document.querySelector('#itl-bought-no-trip'), e.tripId || lastTrip || DATA.pageTripId || '')
      bEl('addto').value = e.createdItemType ? (e.createdItemType === 'familyItem' ? 'other' : 'collection') : defaultAddTo(e.category)
      bEl('addto').disabled = !!e.createdItemType
      bEl('passport').value = OWNER
      updateBoughtFields()
      boughtMsg('')
      bought.hidden = false
      bought.scrollIntoView({ block: 'nearest' })
    }
    bEl('buyer').addEventListener('change', () => {
      ;(window as any).applyBuyerTripFilter(bEl('trip'), PRICE_TRIPS, bEl('buyer').value, document.querySelector('#itl-bought-no-trip'))
      updateBoughtFields()
    })
    document.querySelector('#itl-bought-cancel')!.addEventListener('click', () => { bought.hidden = true; boughtItem = null })
    const confirmBtn = document.querySelector('#itl-bought-confirm') as HTMLButtonElement
    confirmBtn.addEventListener('click', async () => {
      const item = boughtItem
      if (!item || !item.entry) return
      const e = item.entry
      const form = priceEntryFormValues(e)
      const buyer = bEl('buyer').value
      const tripId = bEl('trip').value
      const addTo = bEl('addto').value
      const problem = boughtPreCheck({ buyer, tripId, addTo, currency: form.currency })
      if (problem) { boughtMsg(problem); return }
      confirmBtn.disabled = true
      try {
        const res = await fetch('/api/price-entry-update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(priceEntryUpdateBody({
            id: item.id, status: 'bought', buyer, addTo, tripId, passportHolder: bEl('passport').value,
            sourceType: form.sourceType, shopId: e.shopId, sourceName: e.sourceName, url: e.url,
            price: e.price ?? '', currency: form.currency, taxIncluded: form.taxIncluded,
            extraCost: e.extraCost, condition: form.condition, note: e.note,
          })),
        })
        const data = await res.json().catch(() => ({}))
        if (!res.ok) { boughtMsg(data.error || 'Not saved.'); return }
        try { localStorage.setItem(LAST_TRIP_KEY, tripId) } catch (err) {}
        // This page's copy of the find, so the strip shows it bought without a reload.
        item.status = 'bought'
        e.buyer = buyer
        e.tripId = tripId || null
        bought.hidden = true
        boughtItem = null
        if (sheetStop) fillSheet()
      } catch (err) {
        boughtMsg('Network error — not saved.')
      } finally {
        confirmBtn.disabled = false
      }
    })
    detail.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest('.found-buy') as HTMLElement | null
      if (!btn) return
      const shopId = sheetStop?.shopId
      const item = shopId ? (foundByShop[shopId] || []).find((f) => f.id === btn.dataset.id) : undefined
      if (item && item.kind === 'price' && item.status === 'considering') openBought(item)
    })

    // --- Linking stops to shops (lib/stop-linking.ts) ----------------------------------------------
    // The shop picker: every shop by area (the add-stop picker's grouping), value = its _id.
    function shopPickerOptions(selected: string | null): string {
      return '<option value="">— leave unlinked —</option>' + shopOptionGroups(shops || []).map(({ area, items }) =>
        `<optgroup label="${esc(area)}">${items.map(({ i, name }) => {
          const id = (shops || [])[i]._id
          return `<option value="${esc(id)}"${id === selected ? ' selected' : ''}>${esc(name)}</option>`
        }).join('')}</optgroup>`).join('')
    }
    const linkPanel = document.querySelector('#itl-link') as HTMLElement
    const linkList = document.querySelector('#itl-link-list') as HTMLUListElement
    const linkMsg = document.querySelector('#itl-link-msg') as HTMLElement
    const shopArea = (id: string) => (id ? shopById.get(id)?.area || '' : '')
    function openLinking() {
      const rows = linkSuggestions(state, shops || [])
      linkList.innerHTML = rows.map((r) => {
        const id = r.suggestion?.shop._id || ''
        return `<li class="itl-link-row" data-day="${esc(r.day)}" data-index="${r.index}">
          <label class="itl-link-stop"><input type="checkbox" class="itl-link-check"${r.suggestion?.kind === 'exact' ? ' checked' : ''} />
            <span><span class="itl-link-day">${esc(formatDayShortEn(r.day))}</span> · <span class="itl-link-name">${esc(r.name || '(no name)')}</span></span></label>
          <span class="itl-link-to">→ <select class="itl-link-shop" aria-label="Shop">${shopPickerOptions(id)}</select>
            <span class="itl-link-kind">${r.suggestion ? (r.suggestion.kind === 'exact' ? 'exact' : 'close') : ''}</span>
            <span class="itl-link-area">${shopArea(id) ? `📍 ${esc(shopArea(id))}` : ''}</span></span>
        </li>`
      }).join('')
      ;(document.querySelector('#itl-link-empty') as HTMLElement).hidden = rows.length > 0
      ;(document.querySelector('#itl-link-save') as HTMLElement).hidden = rows.length === 0
      linkMsg.hidden = true
      linkPanel.hidden = false
      linkPanel.scrollIntoView({ block: 'nearest' })
    }
    document.querySelector('#itl-link-btn')!.addEventListener('click', () => { if (linkPanel.hidden) openLinking(); else linkPanel.hidden = true })
    document.querySelector('#itl-link-close')!.addEventListener('click', () => { linkPanel.hidden = true })
    // Choosing a shop ticks the row; "leave unlinked" unticks it.
    linkList.addEventListener('change', (e) => {
      const sel = (e.target as HTMLElement).closest('.itl-link-shop') as HTMLSelectElement | null
      if (!sel) return
      const row = sel.closest('.itl-link-row') as HTMLElement
      ;(row.querySelector('.itl-link-check') as HTMLInputElement).checked = !!sel.value
      ;(row.querySelector('.itl-link-kind') as HTMLElement).textContent = ''
      ;(row.querySelector('.itl-link-area') as HTMLElement).textContent = shopArea(sel.value) ? `📍 ${shopArea(sel.value)}` : ''
    })
    // "Link selected": shopId on the ticked stops (their own fields stay), then the usual save.
    document.querySelector('#itl-link-save')!.addEventListener('click', () => {
      let n = 0
      linkList.querySelectorAll<HTMLElement>('.itl-link-row').forEach((row) => {
        const shopId = (row.querySelector('.itl-link-shop') as HTMLSelectElement).value
        if (!(row.querySelector('.itl-link-check') as HTMLInputElement).checked || !shopId) return
        const stop = state.find((d) => d.day === row.dataset.day)?.stops[Number(row.dataset.index)]
        if (stop) { stop.shopId = shopId; n++ }
      })
      if (!n) { linkMsg.hidden = false; linkMsg.textContent = 'Nothing selected.'; return }
      changed()
      openLinking()
      linkMsg.hidden = false
      linkMsg.textContent = `Linked ${n} stop${n === 1 ? '' : 's'} ✓`
    })
    // The sheet: one unlinked stop, the same picker with its suggestion.
    document.querySelector('#itl-ed-link-save')!.addEventListener('click', withStop((s) => {
      const shopId = (document.querySelector('#itl-ed-link-shop') as HTMLSelectElement).value
      if (!shopId) return
      s.shopId = shopId
      changed()
    }))

    document.querySelector('#itl-ed-delete')!.addEventListener('click', withStop((s, idx, day) => {
      if (!confirm(`Delete "${resolveStop(s, shopById).name}" from ${day.date}?`)) return
      removeStop(day, idx)
      closeSheet(); changed()
    }))
    dayEl.addEventListener('click', (e) => {
      const target = e.target as HTMLElement
      const block = target.closest('.itl-block') as HTMLElement | null
      if (!block || target.closest('.itn-reminder')) return
      const idx = Number(block.dataset.index)
      if (target.closest('.itl-train-line')) { openTravelEditor(idx); return }
      if (target.closest('.itl-here')) { markNow('here', currentDayPlan(), idx); return }
      if (target.closest('.itl-leave')) { markNow('leave', currentDayPlan(), idx); return }
