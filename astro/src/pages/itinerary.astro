---
import Base from '../layouts/Base.astro'
import { loadItineraryPageData } from '../lib/itinerary-page-data'

// The default plan, the trip and its days, the flight home, the shops and the saved plan —
// shared with /itinerary-timeline (src/lib/itinerary-page-data.ts).
const { BASE, AREA_MIN_FROM_AKIB, shops, savedState, plan, trip, usingTripDays, days, rangeLabel, flight, labels } = await loadItineraryPageData(Astro.url)
const tripParam = Astro.url.searchParams.get('trip')
const tripQuery = tripParam ? `?trip=${encodeURIComponent(tripParam)}` : ''
---
<Base title="Itinerary">
  <div class="page-header">
    <h1>Shopping-plan</h1>
    <span class="count">{rangeLabel} · base Akihabara</span>
    <a id="itn-timeline-link" class="itn-timeline-link" href={`/itinerary-timeline${tripQuery}`}>🗓️ Timeline (beta)</a>
  </div>
  {!usingTripDays && (
    <p class="plan-days-hint">Days from the plan's own dates. Set "First day in Tokyo" and "Last day in Tokyo" in Trip Settings{trip?.label ? ` (${trip.label})` : ''} to show the trip's days.</p>
  )}

  <div class="plan-tip">
    <span>Endringer lagres automatisk og synkes mellom enhetene dine. Mangler et stopp koordinater, lim inn «lat, lng» fra Google Maps i <strong>⋯</strong>. <strong>▲▼</strong> flytt · <strong>✕</strong> fjern · <strong>+</strong> legg til · <strong>🗺️</strong> rute.</span>
    <div class="tip-actions">
      <span id="save-status" class="save-status"></span>
      <button id="reset-btn" class="reset-btn" type="button">↺ Tilbakestill</button>
    </div>
  </div>

  <p id="itn-next" class="itn-next" role="status" hidden></p>

  <div id="days"></div>

  <script type="application/json" id="plan-data" set:html={JSON.stringify({ plan, days, labels, flight, areaMin: AREA_MIN_FROM_AKIB, base: BASE, shops, savedState })}></script>

  <!-- The main script below is is:inline (left untouched — far too large/load-bearing to
       safely convert to a module) and so can't use `import`. This tiny module script
       imports the shared itinerary code from src/lib and exposes it on window for that
       script; module scripts run after it, so its first render waits for the
       "itinerary-lib-ready" event this one sends. -->
  <script>
    import { optimizeRoute, estimateLeg, extractNoteTravelMinutes } from '../lib/route-optimizer'
    import { scheduleDay, transitRouteUrl, leaveReminderIcs, nextLeave, LEAVE_BUFFER_MIN } from '../lib/itinerary-schedule'
    import * as itineraryPlan from '../lib/itinerary-plan'
    window.__routeOptimizer = { ...itineraryPlan, optimizeRoute, estimateLeg, extractNoteTravelMinutes, scheduleDay, transitRouteUrl, leaveReminderIcs, nextLeave, LEAVE_BUFFER_MIN }
    // The inline script's first render waits for this (see itineraryLibReady there).
    window.dispatchEvent(new Event('itinerary-lib-ready'))
  </script>

  <script is:inline>
    function loadLeaflet() {
      return new Promise((resolve) => {
        if (window.L) return resolve(true)
        const css = document.createElement('link')
        css.rel = 'stylesheet'; css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'
        document.head.appendChild(css)
        const js = document.createElement('script')
        js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'
        js.onload = () => resolve(true); js.onerror = () => resolve(false)
        document.head.appendChild(js)
      })
    }

    const STORE_KEY = 'ff-itinerary-v12'
    const DEFAULT_START = '08:00'
    const raw = document.querySelector('#plan-data')?.textContent || '{}'
    // `days`: the dates shown, in order; `labels`: "1. des (tir)" for every date the page knows
    // (computed on the server by lib/trip-dates.ts — this script never works out a weekday).
    const { plan, days, labels, flight, areaMin, base, shops, savedState } = JSON.parse(raw)
    const templateByDay = new Map(plan.map((d) => [d.day, d]))
    const shopById = new Map((shops || []).map((sh) => [sh._id, sh]))
    const daysEl = document.querySelector('#days')
    const resetBtn = document.querySelector('#reset-btn')
    const saveStatusEl = document.querySelector('#save-status')

    let mapInstances = []
    let leafletOk = false
    // Per-day previous stop order, kept only in memory (not saved/synced) — lets "Undo"
    // restore the order from right before the most recent "Apply", until the page reloads.
    let undoByDay = {}

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]))
    }

    // The shop picker: shops grouped by area (src/lib/itinerary-plan.ts, shared with the timeline).
    // Built at startup, once that module has loaded.
    function buildShopOptions() {
      if (!shops || !shops.length) return ''
      let html = ''
      window.__routeOptimizer.shopOptionGroups(shops).forEach(({ area, items }) => {
        html += `<optgroup label="${esc(area)}">`
        items.forEach(({ i, name, hasCoord }) => { html += `<option value="${i}">${esc(name)}${hasCoord ? '' : ' (uten koord.)'}</option>` })
        html += `</optgroup>`
      })
      return html
    }
    let SHOP_OPTIONS = ''

    // The saved plan, as { "YYYY-MM-DD": { startTime, stops } }. Saved as { v: 2, days }; an
    // older save is an array with one entry per plan day in the plan's order (1.–7. des), so
    // entry i is read as the plan's i-th date.
    // The plan's load/save rules live in src/lib/itinerary-plan.ts (shared with /itinerary-timeline).
    const LIB = () => window.__routeOptimizer
    function normalizeSaved(p) { return LIB().normalizeSavedPlan(p, plan) }
    // Prefer server-synced state; fall back to local cache.
    function loadSaved() {
      if (savedState) { try { const p = normalizeSaved(JSON.parse(savedState)); if (p) return p } catch (e) {} }
      try { const s = localStorage.getItem(STORE_KEY); return s ? normalizeSaved(JSON.parse(s)) : null } catch { return null }
    }

    function setStatus(text, color) {
      if (!saveStatusEl) return
      saveStatusEl.textContent = text
      saveStatusEl.style.color = color || 'var(--muted)'
    }

    let saveTimer = null
    function scheduleRemoteSave(payload) {
      setStatus('Lagrer…', 'var(--muted)')
      clearTimeout(saveTimer)
      saveTimer = setTimeout(async () => {
        try {
          const res = await fetch('/api/itinerary-save', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ data: payload }),
          })
          setStatus(res.ok ? 'Lagret ✓' : 'Lagring feilet', res.ok ? '#2ecc71' : '#e74c3c')
        } catch (e) {
          setStatus('Lagret lokalt (ingen nett)', '#e0a04c')
        }
      }, 1000)
    }

    // Saves every date, the "Not scheduled" ones (extraDays) included — a stop is only ever
    // removed by the user, never by the trip's days changing.
    function saveState() {
      const payload = LIB().serializePlan(state, extraDays)
      try { localStorage.setItem(STORE_KEY, payload) } catch {}
      scheduleRemoteSave(payload)
    }

    // One date's day: its saved version, else the plan's default for that date, else empty.
    function dayEntry(iso, s) { return LIB().planDayEntry(iso, s, templateByDay, labels) }
    // `state`: the trip's days, in order. `extraDays`: every other date with a plan (saved or
    // default) — their stops are shown under "Not scheduled" until moved to a day. Built once the
    // shared module has loaded (see the startup at the end), before the first render.
    let extraDays = {}
    function buildState() {
      const built = LIB().buildPlanState(plan, days, labels, loadSaved() || {})
      extraDays = built.extraDays
      return built.state
    }
    let state = []

    function moveUnscheduled(iso, idx, dj) {
      const [s] = extraDays[iso].stops.splice(idx, 1)
      if (s) state[dj].stops.push(s)
      saveState(); render()
    }

    function renderUnscheduled() {
      const unscheduled = Object.values(extraDays).filter((d) => d.stops.length).sort((a, b) => a.day.localeCompare(b.day))
      if (!unscheduled.length) return
      const card = document.createElement('div')
      card.className = 'day-card unscheduled-card'
      const options = state.map((d, dj) => `<option value="${dj}">${esc(d.date)}</option>`).join('')
      card.innerHTML = `
        <div class="day-head"><div><div class="day-title">Not scheduled</div>
        <div class="day-area">Stops from a day that isn't in the trip any more. Nothing is deleted — move them to a day.</div></div></div>
        <ul class="unscheduled-list"></ul>`
      const ul = card.querySelector('.unscheduled-list')
      unscheduled.forEach((d) => d.stops.forEach((s, si) => {
        const li = document.createElement('li')
        li.className = 'unscheduled-stop'
        li.innerHTML = `
          <span class="stop-body"><span class="stop-name">${esc(resolveStop(s).name)}</span>
          <span class="stop-sub">from ${esc(d.date)}</span></span>
          <select class="us-move" data-key="${esc(d.day)}" data-idx="${si}" aria-label="Move to day"><option value="">Move to day…</option>${options}</select>`
        ul.appendChild(li)
      }))
      ul.querySelectorAll('.us-move').forEach((sel) => sel.addEventListener('change', () => {
        if (sel.value !== '') moveUnscheduled(sel.dataset.key, +sel.dataset.idx, +sel.value)
      }))
      daysEl.appendChild(card)
    }

    const pad = (n) => String(n).padStart(2, '0')
    function fmt(mins) { mins = ((Math.round(mins) % 1440) + 1440) % 1440; return `${pad(Math.floor(mins/60))}:${pad(mins%60)}` }
    function parseT(s) { const m = /^(\d{1,2}):(\d{2})$/.exec(s || ''); return m ? (+m[1])*60 + (+m[2]) : null }

    function parseLatLng(str) {
      const m = /(-?\d+(?:\.\d+)?)\s*[, ]\s*(-?\d+(?:\.\d+)?)/.exec(str || '')
      if (!m) return null
      const lat = parseFloat(m[1]), lng = parseFloat(m[2])
      if (isNaN(lat) || isNaN(lng) || lat < -90 || lat > 90 || lng < -180 || lng > 180) return null
      return { lat, lng }
    }

    // Shared with /itinerary-timeline (src/lib/itinerary-plan.ts): the stop's effective
    // name/coordinates (a linked shop's win), opening hours, and default visit lengths.
    function resolveStop(s) { return LIB().resolveStop(s, shopById) }
    function parseOpeningHours(text) { return LIB().parseOpeningHours(text) }
    function looksClosed(hoursText, plannedMinutes) { return LIB().looksClosed(hoursText, plannedMinutes) }
    function defaultDur(s) { return LIB().defaultDurationMin(s) }

    function distM(a, b) {
      const R = 6371000, toRad = (d) => d * Math.PI / 180
      const dLat = toRad(b.lat - a.lat), dLng = toRad(b.lng - a.lng)
      const x = Math.sin(dLat/2)**2 + Math.cos(toRad(a.lat))*Math.cos(toRad(b.lat))*Math.sin(dLng/2)**2
      return 2 * R * Math.asin(Math.sqrt(x))
    }
    // Travel between two points: the shared estimate (src/lib/route-optimizer.ts estimateLeg —
    // walking for short hops, a Tokyo-rail train estimate beyond that).
    function walkMin(a, b) {
      if (!a || !b) return 0
      const leg = window.__routeOptimizer.estimateLeg(a, b)
      return leg ? leg.minutes : 0
    }
    function walkText(a, b) {
      if (!a || !b) return ''
      const leg = window.__routeOptimizer.estimateLeg(a, b)
      if (!leg) return ''
      if (leg.mode === 'train') return `🚃 ~${leg.minutes} min (estimate)`
      return `🚶 ~${leg.minutes} min · ${Math.round(distM(a, b) * 1.4)} m`
    }
    function travelBadge(area) {
      const key = Object.keys(areaMin).find((k) => area.includes(k))
      const min = key != null ? areaMin[key] : null
      if (min == null) return ''
      if (min === 0) return '🏠 base'
      return `🚃 ~${min} min fra base`
    }

    // The leg's own travel time (only while it's still the same leg) and the day's timetable —
    // src/lib/itinerary-plan.ts, the same code /itinerary-timeline uses.
    function legFromKey(day, si) { return LIB().legFromKey(day, si, shopById) }
    function manualTravelFor(day, si) { return LIB().manualTravelFor(day, si, shopById) }
    function computeTimes(day) { return LIB().computeDayTimes(day, base, shopById) }

    // The travel line into stop si, tappable: "🚃 ~45 min (estimate)" etc., opening an editor
    // for the leg's own minutes and a Google Maps transit link.
    function travelRowHtml(di, si, day, sched) {
      const leg = sched.stops[si].travelIn
      const from = si === 0 ? { name: 'Base', lat: base.lat, lng: base.lng } : resolveStop(day.stops[si - 1])
      const to = resolveStop(day.stops[si])
      let text
      if (leg.source === 'manual') text = `🕒 ${leg.minutes} min (your time)`
      else if (leg.source === 'note') text = `🚃 ~${leg.minutes} min (from the shop note)`
      else if (leg.mode === 'train') text = `🚃 ~${leg.minutes} min (estimate)`
      else if (leg.mode === 'walk') text = `🚶 ~${leg.minutes} min (estimate)`
      else text = '➕ Travel time?'
      const manual = manualTravelFor(day, si)
      const routeUrl = window.__routeOptimizer.transitRouteUrl(from, to)
      return `<li class="walk-row"><button type="button" class="itn-travel" data-day="${di}" data-idx="${si}">${esc(text)} →</button></li>
        <li class="itn-travel-edit" data-day="${di}" data-idx="${si}" hidden>
          <label>Travel time <input type="number" class="itn-travel-min" min="0" step="1" value="${manual != null ? manual : ''}" placeholder="${leg.minutes}" /> min</label>
          <button type="button" class="itn-travel-save">Save</button>
          ${manual != null ? '<button type="button" class="itn-travel-clear">Use estimate</button>' : ''}
          <a class="itn-route" href="${esc(routeUrl)}" target="_blank" rel="noopener">🗺️ Route</a>
        </li>`
    }

    // "Next: leave <stop> by HH:MM (in N min)" during the trip — today's next leave-by time in
    // Tokyo (src/lib/itinerary-schedule.ts nextLeave), refreshed by render() and every minute.
    const nextEl = document.querySelector('#itn-next')
    function updateNextBanner() {
      if (!nextEl || !window.__routeOptimizer) return
      const entries = []
      state.forEach((day) => {
        if (!day.day) return
        const { sched } = computeTimes(day)
        sched.stops.forEach((x, si) => {
          if (x.leaveBy == null || !day.stops[si + 1]) return
          entries.push({ date: day.day, from: resolveStop(day.stops[si]).name, to: resolveStop(day.stops[si + 1]).name, leaveBy: x.leaveBy })
        })
      })
      const next = window.__routeOptimizer.nextLeave(entries)
      nextEl.hidden = !next
      if (next) nextEl.textContent = `Next: leave ${next.from} by ${fmt(next.leaveBy)} (${next.inMin === 0 ? 'now' : `in ${next.inMin} min`})`
    }
    // Refreshed just after each minute starts (Japan's offset is whole hours, so the phone's
    // minutes are Tokyo's minutes) — a plain 60 s interval could lag the clock by up to a minute.
    function tickEveryMinute() {
      setTimeout(() => { updateNextBanner(); tickEveryMinute() }, 60000 - (Date.now() % 60000) + 50)
    }
    tickEveryMinute()

    // "⏰ Reminder": an .ics calendar event at the leave-by time (src/lib/itinerary-schedule.ts
    // leaveReminderIcs, Asia/Tokyo), as a data: link the phone's calendar opens.
    function reminderLinkHtml(day, si, leaveBy) {
      if (!day.day || !day.stops[si + 1]) return ''
      const lib = window.__routeOptimizer
      const from = resolveStop(day.stops[si]), to = resolveStop(day.stops[si + 1])
      const ics = lib.leaveReminderIcs({ date: day.day, leaveBy, from: from.name, to: to.name, routeUrl: lib.transitRouteUrl(from, to) })
      const file = `leave-${day.day}-${fmt(leaveBy).replace(':', '')}.ics`
      return ` <a class="itn-reminder" href="data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}" download="${file}">⏰ Reminder</a>`
    }

    // Once per segment that runs over, just above the travel line into its anchor: how much
    // too long the stops before it are, and the longest visits that could give.
    function segmentHtml(day, sched, anchorIdx) {
      const seg = sched.segments.find((g) => g.anchorIndex === anchorIdx)
      if (!seg) return ''
      const anchorName = resolveStop(day.stops[anchorIdx]).name
      const tips = seg.suggestions.length
        ? `<span class="itn-segment-tips">Longest visits: ${seg.suggestions.map((g) => `${esc(g.name)} (${g.durationMin} min)`).join(', ')}</span>`
        : ''
      return `<li class="itn-segment">⚠️ The stops before ${esc(anchorName)} ${fmt(seg.anchorTime)} need ${seg.overrunMin} min more than available. Shorten a visit or remove a stop.${tips}</li>`
    }

    // Under a stop: when to leave it, and any timing problem.
    function scheduleLinesHtml(day, sched, si) {
      const x = sched.stops[si]
      const lines = []
      if (x.doesntFit) {
        const anchorName = resolveStop(day.stops[x.doesntFit.anchorIndex]).name
        lines.push(`<span class="itn-warn">⚠️ Doesn't fit before ${esc(anchorName)} ${fmt(x.doesntFit.anchorTime)} (${x.doesntFit.shortMin} min short)</span>`)
      } else if (x.leaveEarlierMin) {
        lines.push(`<span class="itn-warn">⚠️ Leave ${x.leaveEarlierMin} min earlier</span>`)
      }
      if (x.stayUntil != null) lines.push(`<span class="itn-stay">You can stay until ${fmt(x.stayUntil)}</span>`)
      if (x.leaveBy != null) lines.push(`<span class="itn-leave">Leave by ${fmt(x.leaveBy)}${reminderLinkHtml(day, si, x.leaveBy)}</span>`)
      return lines.length ? `<span class="itn-lines">${lines.join('')}</span>` : ''
    }

    // What time would a not-yet-added stop land at, if appended to the end of this day?
    // Reuses computeTimes itself (on a throwaway copy of the day) rather than
    // re-deriving the arrival-time math separately.
    function previewArrivalTime(di, tentativeStop) {
      const day = state[di]
      const projected = { ...day, stops: [...day.stops, tentativeStop] }
      const { times } = computeTimes(projected)
      return times[times.length - 1]
    }

    function resortDay(di) {
      const day = state[di]
      const { times } = computeTimes(day)
      const withT = day.stops.map((s, i) => ({
        s, orig: i,
        t: (s.fixedTime && parseT(s.fixedTime) != null) ? parseT(s.fixedTime) : times[i],
      }))
      withT.sort((a, b) => (a.t - b.t) || (a.orig - b.orig))
      day.stops = withT.map((x) => x.s)
    }

    function dayRouteUrls(day) {
      const pts = day.stops.map(resolveStop).filter((s) => s.lat != null && s.lng != null).map((s) => `${s.lat},${s.lng}`)
      const baseP = `${base.lat},${base.lng}`
      const full = [baseP, ...pts, baseP]
      if (full.length < 2) return []
      const MAX = 10, segs = []
      if (full.length <= MAX) segs.push(full)
      else { let i = 0; while (i < full.length - 1) { segs.push(full.slice(i, i + MAX)); i += MAX - 1 } }
      return segs.map((seg) => {
        const origin = seg[0], destination = seg[seg.length - 1]
        const waypoints = seg.slice(1, -1).join('|')
        let url = `https://www.google.com/maps/dir/?api=1&origin=${origin}&destination=${destination}&travelmode=walking`
        if (waypoints) url += `&waypoints=${encodeURIComponent(waypoints)}`
        return url
      })
    }
    function baseRow(label, time) {
      return `<li class="stop is-base"><span class="stop-time">${time}</span><div class="move-col"><span class="base-icon">🏠</span></div>
        <span class="stop-body"><span class="stop-name">${label}</span></span></li>`
    }
    function dayOptions(exceptDi) {
      return state.map((d, dj) => dj === exceptDi ? '' : `<option value="${dj}">${d.date}</option>`).join('')
    }
    function slotBadge(slot) {
      if (slot === 'kveld') return '<span class="slot-badge kveld">🌙 kveld</span>'
      if (slot === 'dagtid') return '<span class="slot-badge dagtid">☀️ dagtid</span>'
      return ''
    }

    function initMap(di, day) {
      if (!leafletOk || !window.L) return
      const el = document.getElementById(`map-${di}`)
      if (!el) return
      const map = L.map(el, { scrollWheelZoom: false })
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap' }).addTo(map)
      const latlngs = [[base.lat, base.lng]]
      const baseIcon = L.divIcon({ className: '', html: '<div class="pin base">🏠</div>', iconSize: [28,28], iconAnchor: [14,14] })
      L.marker([base.lat, base.lng], { icon: baseIcon }).addTo(map).bindPopup('Base')
      day.stops.forEach((s, i) => {
        const r = resolveStop(s)
        if (r.lat == null || r.lng == null) return
        const icon = L.divIcon({ className: '', html: `<div class="pin ${s.tag === 'mat' ? 'food' : s.tag === 'MUST' ? 'must' : ''}">${i+1}</div>`, iconSize: [26,26], iconAnchor: [13,13] })
        L.marker([r.lat, r.lng], { icon }).addTo(map).bindPopup(`${i+1}. ${r.name}`)
        latlngs.push([r.lat, r.lng])
      })
      latlngs.push([base.lat, base.lng])
      L.polyline(latlngs, { color: '#f4a24c', weight: 3, opacity: 0.85, dashArray: '6 6' }).addTo(map)
      map.fitBounds(latlngs, { padding: [30, 30] })
      setTimeout(() => map.invalidateSize(), 120)
      mapInstances.push(map)
    }

    function render() {
      mapInstances.forEach((m) => { try { m.remove() } catch {} })
      mapInstances = []
      daysEl.innerHTML = ''

      state.forEach((day, di) => {
        const { baseStart, times, baseEnd, sched } = computeTimes(day)
        const card = document.createElement('div')
        card.className = 'day-card'
        const urls = dayRouteUrls(day)
        let routeBtns = ''
        if (urls.length === 1) routeBtns = `<a class="route-btn" href="${urls[0]}" target="_blank" rel="noopener">🗺️ Åpne ruten i Google Maps</a>`
        else if (urls.length > 1) routeBtns = '<div class="route-parts">' + urls.map((u, i) => `<a class="route-btn" href="${u}" target="_blank" rel="noopener">🗺️ Rute del ${i+1}</a>`).join('') + '</div>'

        const shopSelectHtml = SHOP_OPTIONS
          ? `<select class="af-shop"><option value="">Velg sted fra butikklista…</option>${SHOP_OPTIONS}<option value="__custom__">✏️ Annet (skriv selv)</option></select>`
          : `<select class="af-shop"><option value="__custom__" selected>✏️ Skriv selv</option></select>`

        card.innerHTML = `
          <div class="day-head">
            <div>
              <div class="day-title">${day.date}</div>
              <div class="day-area">${day.area}</div>
              ${flight && flight.date === day.day ? `<div class="day-flight">${esc(flight.line)} · last stop should end by ~${esc(flight.latestEnd)}</div>` : ''}
            </div>
            <div class="day-travel">${travelBadge(day.area)}<br>slutt ~${fmt(baseEnd)}</div>
          </div>
          <div class="day-check-row">
            <button class="day-check-btn" data-day="${di}" type="button">🔍 Check day</button>
            <button class="day-route-btn" data-day="${di}" type="button">🧭 Suggest route</button>
            <div class="day-check-results" data-day="${di}" hidden></div>
            <div class="day-route-results" data-day="${di}" hidden></div>
          </div>
          <div class="day-startrow">
            <label>🕗 Dagen starter <input type="time" class="day-start-input" data-day="${di}" value="${day.startTime}" /></label>
          </div>
          ${day.note ? `<div class="day-note">${day.note}</div>` : ''}
          ${leafletOk ? `<div id="map-${di}" class="day-map"></div>` : ''}
          ${routeBtns}
          <ul class="stop-list" data-day="${di}"></ul>
          <button class="add-stop-btn" data-day="${di}" type="button">+ Legg til stopp</button>
          <div class="add-form" data-day="${di}" hidden>
            ${shopSelectHtml}
            <div class="af-custom" hidden>
              <input class="af-name" type="text" placeholder="Navn på stopp *" />
              <input class="af-hours" type="text" placeholder="Info (valgfritt)" />
            </div>
            <div class="af-row"><button class="af-save" type="button">Legg til</button><button class="af-cancel" type="button">Avbryt</button></div>
          </div>
        `
        const ul = card.querySelector('.stop-list')
        ul.insertAdjacentHTML('beforeend', baseRow('Start: base', fmt(baseStart)))
        if (day.stops[0]) ul.insertAdjacentHTML('beforeend', travelRowHtml(di, 0, day, sched))

        day.stops.forEach((s, si) => {
          const r = resolveStop(s)
          const t = times[si]
          const noCoord = (r.lat == null || r.lng == null)
          const li = document.createElement('li')
          li.className = 'stop' + (s.tag === 'mat' ? ' is-food' : '')
          li.dataset.day = di
          li.dataset.idx = si
          const tagCls = s.tag === 'MUST' ? 'must' : s.tag === 'mat' ? 'food' : 'note'
          const tagHtml = s.tag ? `<span class="stop-tag ${tagCls}">${s.tag}</span>` : ''
          const gmap = (r.lat != null) ? `https://www.google.com/maps?q=${r.lat},${r.lng}` : ''
          const editUrl = s.shopId ? `/edit-store?id=${esc(encodeURIComponent(s.shopId))}` : ''
          const durVal = (s.dur != null ? s.dur : defaultDur(s))
          li.innerHTML = `
            <span class="stop-time">${fmt(t)}${s.fixedTime ? ' 📌' : ''}${sched.stops[si].arrival !== sched.stops[si].start ? `<span class="itn-arrive">(arrive ${fmt(sched.stops[si].arrival)})</span>` : ''}</span>
            <div class="move-col">
              <button class="mv up" data-day="${di}" data-idx="${si}" ${si === 0 ? 'disabled' : ''} title="Opp">▲</button>
              <span class="stop-num">${si + 1}</span>
              <button class="mv down" data-day="${di}" data-idx="${si}" ${si === day.stops.length - 1 ? 'disabled' : ''} title="Ned">▼</button>
            </div>
            <span class="stop-body">
              <span class="stop-name">${
                editUrl ? `<a href="${editUrl}">${r.name}</a>`
                : gmap ? `<a href="${gmap}" target="_blank" rel="noopener">${r.name}</a>`
                : r.name
              }</span>
              <span class="stop-sub">
                ${s.hours ? `<span class="stop-hours">${s.hours}</span>` : ''}
                ${slotBadge(s.slot)}
                ${noCoord ? '<span class="nocoord">📍 mangler koordinater</span>' : ''}
                ${looksClosed(s.hours, t) ? `<span class="closed-warn">⚠️ stengt ~${fmt(t)}?</span>` : ''}
                ${scheduleLinesHtml(day, sched, si)}
              </span>
            </span>
            ${tagHtml}
            <div class="stop-actions">
              <button class="more-btn" data-day="${di}" data-idx="${si}" title="Tid / koordinater / flytt / kopier">⋯</button>
              <button class="remove-btn" data-day="${di}" data-idx="${si}" title="Fjern">✕</button>
            </div>
          `
          ul.appendChild(li)
          const panel = document.createElement('li')
          panel.className = 'mc-panel'; panel.dataset.day = di; panel.dataset.idx = si
          panel.innerHTML = `
            ${noCoord ? `
              <div class="mc-coord-row">
                <label>📍 Koordinater <input type="text" class="mc-coord" placeholder="lat, lng (fra Google Maps)" /></label>
                <button class="mc-coord-save" type="button">Lagre</button>
                ${s.shopId ? `<button class="mc-coord-fetch" type="button">🔄 Hent koordinater fra butikken</button>` : ''}
              </div>
              <p class="mc-coord-msg" hidden></p>
            ` : ''}
            <div class="mc-time-row">
              <label>🕐 Tid <input type="time" class="mc-time" value="${s.fixedTime || ''}" /></label>
              <label>⏱ Varighet <input type="number" class="mc-dur" min="5" step="5" value="${durVal}" /> min</label>
              <label class="mc-early-label" ${s.fixedTime ? '' : 'hidden'}>Arrive <input type="number" class="mc-early" min="0" step="5" value="${typeof s.arriveEarly === 'number' ? s.arriveEarly : ''}" /> min early</label>
            </div>
            <label>Flytt til <select class="mc-move"><option value="">—</option>${dayOptions(di)}</select></label>
            <label>Kopier til <select class="mc-copy"><option value="">—</option>${dayOptions(di)}</select></label>
          `
          ul.appendChild(panel)

          if (day.stops[si + 1]) ul.insertAdjacentHTML('beforeend', segmentHtml(day, sched, si + 1) + travelRowHtml(di, si + 1, day, sched))
        })

        const lastStop = day.stops.length ? resolveStop(day.stops[day.stops.length - 1]) : null
        if (lastStop) { const wt = walkText(lastStop, base); if (wt) ul.insertAdjacentHTML('beforeend', `<li class="walk-row"><span class="walk-line">${wt} →</span></li>`) }
        ul.insertAdjacentHTML('beforeend', baseRow('Tilbake til base', fmt(baseEnd)))
        daysEl.appendChild(card)
      })

      renderUnscheduled()
      updateNextBanner()
      state.forEach((day, di) => initMap(di, day))
      state.forEach((day, di) => renderUndoAffordance(di))
      attachEvents()
    }

    function move(di, idx, delta) {
      const arr = state[di].stops, ni = idx + delta
      if (ni < 0 || ni >= arr.length) return
      ;[arr[idx], arr[ni]] = [arr[ni], arr[idx]]
      saveState(); render()
    }
    function moveToDay(di, idx, dj) { const [s] = state[di].stops.splice(idx, 1); state[dj].stops.push(s); saveState(); render() }
    function copyToDay(di, idx, dj) { state[dj].stops.push({ ...state[di].stops[idx] }); saveState(); render() }

    function addShopStop(di, shopIdx) {
      const shop = shops[shopIdx]
      if (!shop) return
      state[di].stops.push(LIB().shopStopFrom(shop)) // the same shape the timeline adds
      saveState(); render()
    }
    function addCustomStop(di, name, hours) {
      state[di].stops.push(LIB().customStopFrom(name, hours))
      saveState(); render()
    }

    function coordMsg(el, text, color) { el.hidden = false; el.textContent = text; el.style.color = color }

    async function saveCoords(di, idx, panel) {
      const s = state[di].stops[idx]
      const inp = panel.querySelector('.mc-coord')
      const msg = panel.querySelector('.mc-coord-msg')
      const parsed = parseLatLng(inp.value)
      if (!parsed) { coordMsg(msg, 'Skriv «lat, lng» — f.eks. 35.6990, 139.7710', '#e74c3c'); return }
      s.lat = parsed.lat; s.lng = parsed.lng
      saveState()
      if (s.shopId) {
        coordMsg(msg, 'Lagrer til butikken…', 'var(--muted)')
        try {
          const res = await fetch('/api/shop-coords', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: s.shopId, latitude: parsed.lat, longitude: parsed.lng }),
          })
          coordMsg(msg, res.ok ? 'Lagret ✓ — også til butikken i Sanity' : 'Lagret lokalt, men Sanity-lagring feilet', res.ok ? '#2ecc71' : '#e74c3c')
        } catch (e) { coordMsg(msg, 'Lagret lokalt (ingen nett til Sanity)', '#e74c3c') }
      } else {
        coordMsg(msg, 'Lagret ✓ (ikke koblet til en butikk)', '#2ecc71')
      }
      setTimeout(render, 1400)
    }

    async function fetchShopCoords(di, idx, panel) {
      const s = state[di].stops[idx]
      const msg = panel.querySelector('.mc-coord-msg')
      if (!s.shopId) return
      coordMsg(msg, 'Henter fra butikken…', 'var(--muted)')
      try {
        const res = await fetch('/api/shop-coords?id=' + encodeURIComponent(s.shopId))
        const data = await res.json()
        if (!res.ok || !data.ok) { coordMsg(msg, 'Henting feilet.', '#e74c3c'); return }
        if (!data.found) { coordMsg(msg, 'Fant ikke butikken i Sanity.', '#e74c3c'); return }
        if (!data.hasCoords) { coordMsg(msg, 'Butikken har ingen koordinater ennå.', '#e74c3c'); return }
        s.lat = data.latitude; s.lng = data.longitude
        saveState()
        coordMsg(msg, 'Hentet ✓ — koordinater satt fra butikken', '#2ecc71')
        setTimeout(render, 1400)
      } catch (e) {
        coordMsg(msg, 'Nettverksfeil ved henting.', '#e74c3c')
      }
    }

    // --- "Check day" AI review — read-only: never touches state/saveState, so the plan
    // itself is never changed by a review, only ever read to build the request. ---
    function stopNote(s) { return LIB().stopNote(s, shopById) }

    function renderCheckError(resultsEl, text) {
      resultsEl.replaceChildren()
      const p = document.createElement('p')
      p.className = 'ir-error'
      p.textContent = text
      resultsEl.appendChild(p)
      resultsEl.hidden = false
    }

    function renderCheckResults(resultsEl, di, items) {
      resultsEl.replaceChildren()
      if (!items.length) {
        const p = document.createElement('p')
        p.className = 'ir-good'
        p.textContent = '✓ Looks good.'
        resultsEl.appendChild(p)
        resultsEl.hidden = false
        return
      }

      const list = document.createElement('ul')
      list.className = 'ir-list'
      items.forEach((item) => {
        const li = document.createElement('li')
        li.className = 'ir-item ' + (item.severity === 'warning' ? 'ir-warning' : 'ir-tip')

        if (typeof item.stopIndex === 'number') {
          const stopLi = daysEl.querySelector(`.stop[data-day="${di}"][data-idx="${item.stopIndex}"]`)
          const nameEl = stopLi ? stopLi.querySelector('.stop-name') : null
          const stopName = nameEl ? nameEl.textContent : `Stop ${item.stopIndex + 1}`
          const link = document.createElement('button')
          link.type = 'button'
          link.className = 'ir-item-stop-link'
          link.textContent = `Stop ${item.stopIndex + 1}: ${stopName}`
          link.addEventListener('click', () => {
            if (!stopLi) return
            stopLi.scrollIntoView({ behavior: 'smooth', block: 'center' })
            stopLi.classList.add('ir-highlight')
            setTimeout(() => stopLi.classList.remove('ir-highlight'), 1600)
          })
          li.appendChild(link)
        }

        const msg = document.createElement('p')
        msg.className = 'ir-item-message'
        msg.textContent = item.message
        li.appendChild(msg)

        if (item.suggestion) {
          const sug = document.createElement('p')
          sug.className = 'ir-item-suggestion'
          sug.textContent = `Suggestion: ${item.suggestion}`
          li.appendChild(sug)
        }

        list.appendChild(li)
      })
      resultsEl.appendChild(list)
      resultsEl.hidden = false
    }

    async function checkDay(di, btn) {
      const day = state[di]
      const { times } = computeTimes(day)
      const resultsEl = daysEl.querySelector(`.day-check-results[data-day="${di}"]`)
      const stopsPayload = day.stops.map((s, si) => {
        const r = resolveStop(s)
        return {
          name: r.name,
          plannedTime: times[si],
          durationMin: (s.dur != null ? s.dur : defaultDur(s)),
          lat: r.lat,
          lng: r.lng,
          openingHours: s.hours || null,
          note: stopNote(s),
          // The review recomputes the timetable from these (src/lib/itinerary-schedule.ts).
          fixedTime: s.fixedTime || null,
          arriveEarlyMin: s.fixedTime && typeof s.arriveEarly === 'number' ? s.arriveEarly : null,
          manualTravelMin: manualTravelFor(day, si),
          must: s.tag === 'MUST',
        }
      })

      btn.disabled = true
      const originalText = btn.textContent
      btn.textContent = 'Checking…'
      resultsEl.hidden = true
      resultsEl.replaceChildren()

      try {
        const res = await fetch('/api/itinerary-review', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            dayDate: day.day,
            dayLabel: day.date,
            dayArea: day.area,
            dayStartTime: day.startTime,
            base: { lat: base.lat, lng: base.lng },
            // Only on the day the flight home leaves — the review checks the day against it.
            flight: flight && flight.date === day.day ? { time: flight.time, airport: flight.airport, terminal: flight.terminal } : undefined,
            stops: stopsPayload,
          }),
        })
        const data = await res.json()
        if (!res.ok) {
          renderCheckError(resultsEl, data.error || 'Check failed.')
          return
        }
        renderCheckResults(resultsEl, di, data.items || [])
      } catch (e) {
        renderCheckError(resultsEl, 'Network error.')
      } finally {
        btn.disabled = false
        btn.textContent = originalText
      }
    }

    // --- "Suggest route" — a deterministic optimizer (src/lib/route-optimizer.ts via
    // window.__routeOptimizer), never the AI. Computing/showing a suggestion never
    // touches state/saveState; only clicking "Apply" does, through the same
    // state[di].stops/saveState()/render() path every other edit on this page uses, so it
    // behaves exactly like a manual reorder for sync/undo-on-reload purposes alike. ---
    function renderUndoAffordance(di) {
      const el = daysEl.querySelector(`.day-route-results[data-day="${di}"]`)
      if (!el || undoByDay[di] === undefined) return
      el.replaceChildren()
      const p = document.createElement('p')
      p.className = 'ir-good'
      p.textContent = 'Route applied ✓'
      const undoBtn = document.createElement('button')
      undoBtn.type = 'button'
      undoBtn.className = 'rt-undo-btn'
      undoBtn.textContent = 'Undo'
      undoBtn.addEventListener('click', () => {
        state[di].stops = undoByDay[di]
        delete undoByDay[di]
        saveState(); render()
      })
      el.appendChild(p)
      el.appendChild(undoBtn)
      el.hidden = false
    }

    function renderRouteResults(resultsEl, di, day, result) {
      resultsEl.replaceChildren()

      const summary = document.createElement('p')
      summary.className = 'rt-summary'
      if (result.improved) {
        const savedMin = Math.round(result.current.score - result.suggested.score)
        summary.textContent = `Saves ~${savedMin} min travel.`
      } else {
        summary.textContent = 'Current order is already best.'
      }
      resultsEl.appendChild(summary)

      if (result.usedFirstStopAsStart) {
        const note = document.createElement('p')
        note.className = 'rt-note'
        note.textContent = 'No start location set for this day — using the first stop as the starting point.'
        resultsEl.appendChild(note)
      }

      function buildColumn(title, order, schedule) {
        const col = document.createElement('div')
        col.className = 'rt-column'
        const h = document.createElement('p')
        h.className = 'rt-column-title'
        h.textContent = title
        col.appendChild(h)
        const list = document.createElement('ol')
        list.className = 'rt-list'
        order.forEach((origIdx, pos) => {
          const li = document.createElement('li')
          li.className = 'rt-list-item'
          const r = resolveStop(day.stops[origIdx])
          li.textContent = `${fmt(schedule.times[pos])} ${r.name}`
          list.appendChild(li)
        })
        col.appendChild(list)
        return col
      }

      const cols = document.createElement('div')
      cols.className = 'rt-columns'
      cols.appendChild(buildColumn('Current', result.currentOrder, result.current))
      cols.appendChild(buildColumn('Suggested', result.order, result.suggested))
      resultsEl.appendChild(cols)

      if (result.improved) {
        const applyBtn = document.createElement('button')
        applyBtn.type = 'button'
        applyBtn.className = 'rt-apply-btn'
        applyBtn.textContent = 'Apply'
        applyBtn.addEventListener('click', () => {
          undoByDay[di] = day.stops.slice()
          state[di].stops = result.order.map((i) => day.stops[i])
          saveState(); render()
        })
        resultsEl.appendChild(applyBtn)
      }

      resultsEl.hidden = false
    }

    function suggestRoute(di) {
      const day = state[di]
      const resultsEl = daysEl.querySelector(`.day-route-results[data-day="${di}"]`)
      if (!day.stops.length) {
        resultsEl.replaceChildren()
        const p = document.createElement('p')
        p.className = 'ir-error'
        p.textContent = 'No stops to reorder.'
        resultsEl.appendChild(p)
        resultsEl.hidden = false
        return
      }
      const startTime = parseT(day.startTime)
      const start = (typeof base.lat === 'number' && typeof base.lng === 'number') ? { lat: base.lat, lng: base.lng } : null
      const stops = day.stops.map((s) => {
        const r = resolveStop(s)
        return {
          lat: r.lat,
          lng: r.lng,
          durationMin: (s.dur != null ? s.dur : defaultDur(s)),
          fixedTime: s.fixedTime ? parseT(s.fixedTime) : null,
          openingHours: s.hours || null,
          note: stopNote(s),
        }
      })
      const result = window.__routeOptimizer.optimizeRoute(stops, startTime != null ? startTime : parseT(DEFAULT_START), start)
      renderRouteResults(resultsEl, di, day, result)
    }

    function attachEvents() {
      document.querySelectorAll('.day-check-btn').forEach((btn) => btn.addEventListener('click', () => checkDay(+btn.dataset.day, btn)))
      document.querySelectorAll('.day-route-btn').forEach((btn) => btn.addEventListener('click', () => suggestRoute(+btn.dataset.day)))
      document.querySelectorAll('.day-start-input').forEach((inp) => inp.addEventListener('change', () => {
        state[+inp.dataset.day].startTime = inp.value || DEFAULT_START; saveState(); render()
      }))
      document.querySelectorAll('.mv.up').forEach((b) => b.addEventListener('click', () => move(+b.dataset.day, +b.dataset.idx, -1)))
      document.querySelectorAll('.mv.down').forEach((b) => b.addEventListener('click', () => move(+b.dataset.day, +b.dataset.idx, +1)))
      document.querySelectorAll('.remove-btn').forEach((btn) => btn.addEventListener('click', () => {
        state[+btn.dataset.day].stops.splice(+btn.dataset.idx, 1); saveState(); render()
      }))
      document.querySelectorAll('.more-btn').forEach((btn) => btn.addEventListener('click', () => {
        const panel = daysEl.querySelector(`.mc-panel[data-day="${btn.dataset.day}"][data-idx="${btn.dataset.idx}"]`)
        if (panel) panel.classList.toggle('open')
      }))
      document.querySelectorAll('.mc-coord-save').forEach((btn) => btn.addEventListener('click', () => {
        const panel = btn.closest('.mc-panel')
        saveCoords(+panel.dataset.day, +panel.dataset.idx, panel)
      }))
      document.querySelectorAll('.mc-coord-fetch').forEach((btn) => btn.addEventListener('click', () => {
        const panel = btn.closest('.mc-panel')
        fetchShopCoords(+panel.dataset.day, +panel.dataset.idx, panel)
      }))
      document.querySelectorAll('.mc-time').forEach((inp) => inp.addEventListener('change', () => {
        const panel = inp.closest('.mc-panel'); const di = +panel.dataset.day
        const s = state[di].stops[+panel.dataset.idx]
        s.fixedTime = inp.value || null
        resortDay(di)
        saveState(); render()
      }))
      // Arrive early (fixed-time stops): the anchor for travel becomes time − minutes.
      document.querySelectorAll('.mc-early').forEach((inp) => inp.addEventListener('change', () => {
        const panel = inp.closest('.mc-panel'); const s = state[+panel.dataset.day].stops[+panel.dataset.idx]
        const v = parseInt(inp.value, 10)
        if (isNaN(v) || v <= 0) delete s.arriveEarly; else s.arriveEarly = v
        saveState(); render()
      }))
      // The travel line: tap to enter minutes for this leg, or go back to the estimate.
      document.querySelectorAll('.itn-travel').forEach((btn) => btn.addEventListener('click', () => {
        const ed = daysEl.querySelector(`.itn-travel-edit[data-day="${btn.dataset.day}"][data-idx="${btn.dataset.idx}"]`)
        if (ed) ed.hidden = !ed.hidden
      }))
      document.querySelectorAll('.itn-travel-edit').forEach((ed) => {
        const di = +ed.dataset.day, si = +ed.dataset.idx
        ed.querySelector('.itn-travel-save').addEventListener('click', () => {
          const v = parseInt(ed.querySelector('.itn-travel-min').value, 10)
          const s = state[di].stops[si]
          if (isNaN(v) || v < 0) { delete s.travelMin; delete s.travelFrom }
          else { s.travelMin = v; s.travelFrom = legFromKey(state[di], si) }
          saveState(); render()
        })
        const clear = ed.querySelector('.itn-travel-clear')
        if (clear) clear.addEventListener('click', () => {
          const s = state[di].stops[si]
          delete s.travelMin; delete s.travelFrom
          saveState(); render()
        })
      })
      document.querySelectorAll('.mc-dur').forEach((inp) => inp.addEventListener('change', () => {
        const panel = inp.closest('.mc-panel'); const s = state[+panel.dataset.day].stops[+panel.dataset.idx]
        const v = parseInt(inp.value, 10); s.dur = isNaN(v) ? null : v; saveState(); render()
      }))
      document.querySelectorAll('.mc-move').forEach((sel) => sel.addEventListener('change', () => {
        const panel = sel.closest('.mc-panel')
        if (sel.value !== '') moveToDay(+panel.dataset.day, +panel.dataset.idx, +sel.value)
      }))
      document.querySelectorAll('.mc-copy').forEach((sel) => sel.addEventListener('change', () => {
        const panel = sel.closest('.mc-panel')
        if (sel.value !== '') copyToDay(+panel.dataset.day, +panel.dataset.idx, +sel.value)
      }))
      document.querySelectorAll('.add-stop-btn').forEach((btn) => btn.addEventListener('click', () => {
        const form = daysEl.querySelector(`.add-form[data-day="${btn.dataset.day}"]`)
        if (form) { form.hidden = false; const sel = form.querySelector('.af-shop'); if (sel) sel.focus() }
      }))
      document.querySelectorAll('.add-form').forEach((form) => {
        const di = +form.dataset.day
        const shopSel = form.querySelector('.af-shop')
        const custom = form.querySelector('.af-custom')
        function syncCustom() { custom.hidden = shopSel.value !== '__custom__' }
        shopSel.addEventListener('change', syncCustom)
        syncCustom()
        form.querySelector('.af-cancel').addEventListener('click', () => {
          form.hidden = true; shopSel.value = ''; custom.hidden = true
          form.querySelector('.af-name').value = ''; form.querySelector('.af-hours').value = ''
        })
        form.querySelector('.af-save').addEventListener('click', () => {
          const val = shopSel.value
          if (val === '__custom__') {
            const name = form.querySelector('.af-name').value.trim()
            if (!name) return
            const hours = form.querySelector('.af-hours').value.trim()
            const arrival = previewArrivalTime(di, { name, hours, tag: '', slot: '', lat: null, lng: null })
            if (looksClosed(hours, arrival) && !confirm(`Dette stedet ser ut til å være stengt rundt ${fmt(arrival)}. Legg til likevel?`)) return
            addCustomStop(di, name, hours)
          } else if (val !== '') {
            const shopIdx = +val
            const shop = shops[shopIdx]
            if (shop) {
              const hours = shop.openingHours || ''
              const tentative = {
                name: shop.shopName, hours, tag: shop.placeType === 'restaurant' ? 'mat' : '', slot: '',
                lat: (typeof shop.latitude === 'number') ? shop.latitude : null,
                lng: (typeof shop.longitude === 'number') ? shop.longitude : null,
              }
              const arrival = previewArrivalTime(di, tentative)
              if (looksClosed(hours, arrival) && !confirm(`Dette stedet ser ut til å være stengt rundt ${fmt(arrival)}. Legg til likevel?`)) return
            }
            addShopStop(di, shopIdx)
          }
        })
      })
    }

    resetBtn.addEventListener('click', () => {
      if (!confirm('Tilbakestille hele planen på alle enheter? Dine endringer forsvinner.')) return
      // Back to the plan's defaults. A date that only exists in the saved plan (not in the
      // default plan) keeps its stops under "Not scheduled" — they're not the plan's to reset.
      state = days.map((iso) => dayEntry(iso, null))
      const keep = {}
      Object.keys(extraDays).forEach((iso) => { if (!templateByDay.has(iso)) keep[iso] = extraDays[iso] })
      plan.forEach((t) => { if (!days.includes(t.day)) keep[t.day] = dayEntry(t.day, null) })
      extraDays = keep
      saveState(); render()
    })

    // The travel estimate and schedule live in src/lib, reached through the module script above
