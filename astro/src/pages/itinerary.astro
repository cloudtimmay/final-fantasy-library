}

let shops: any[] = []
try {
  shops = await sanity.fetch(`
    *[_type == "shopNote" && !(_id in path("drafts.**")) && defined(shopName)]{
      _id, shopName, area, placeType, openingHours, latitude, longitude
    } | order(area asc, shopName asc)
