---
<Base title="Itinerary">
  <div class="page-header">
    <h1>Shopping-plan</h1>
    <span class="count">1.–7. des · base Akihabara</span>
  </div>

  <div class="plan-tip">
    <span>✋ Dra i <strong>⠿</strong>-håndtaket for å endre rekkefølge · trykk <strong>✕</strong> for å fjerne · <strong>+ Legg til stopp</strong> nederst på hver dag.</span>
    <button id="reset-btn" class="reset-btn" type="button">↺ Tilbakestill alt</button>
  </div>

  <div id="days"></div>

  <script type="application/json" id="plan-data" set:html={JSON.stringify({ plan: PLAN, areaMin: AREA_MIN_FROM_AKIB })}></script>

  <script>
    const STORE_KEY = 'ff-itinerary-v4'
    const raw = document.querySelector('#plan-data')?.textContent || '{}'
    const { plan, areaMin } = JSON.parse(raw)
    const daysEl = document.querySelector('#days')
    const resetBtn = document.querySelector('#reset-btn')

    // Saved state: per-day array of full stop objects (reflects order + adds + removes).
    // A day with no saved entry falls back to the base plan.
    function loadSaved() {
      try { const s = localStorage.getItem(STORE_KEY); return s ? JSON.parse(s) : null } catch { return null }
    }
    function saveState() {
      try {
        const out = state.map((d) => d.stops)
        localStorage.setItem(STORE_KEY, JSON.stringify(out))
      } catch {}
    }

    function buildState() {
      const saved = loadSaved()
      return plan.map((day, di) => {
        const stops = (saved && saved[di]) ? saved[di] : day.stops.slice()
        return { date: day.date, area: day.area, stops }
      })
    }

    let state = buildState()

    function distM(a, b) {
      const R = 6371000, toRad = (d) => d * Math.PI / 180
      const dLat = toRad(b.lat - a.lat), dLng = toRad(b.lng - a.lng)
      const lat1 = toRad(a.lat), lat2 = toRad(b.lat)
      const x = Math.sin(dLat/2)**2 + Math.cos(lat1)*Math.cos(lat2)*Math.sin(dLng/2)**2
      return 2 * R * Math.asin(Math.sqrt(x))
    }
    function walkText(a, b) {
      if (!a || !b || a.lat == null || b.lat == null) return ''
      const walkM = distM(a, b) * 1.4
      if (walkM > 2500) return `🚃 ~${Math.round(walkM/1000*3)} min (ta tog)`
      return `🚶 ~${Math.max(1, Math.round(walkM/80))} min · ${Math.round(walkM)} m`
    }
    function travelBadge(area) {
      const key = Object.keys(areaMin).find((k) => area.includes(k))
      const min = key != null ? areaMin[key] : null
      if (min == null) return ''
      if (min === 0) return '<span class="travel">🏠 base</span>'
      return `<span class="travel">🚃 ~${min} min fra Akihabara</span>`
    }

    function render() {
      daysEl.innerHTML = ''
      state.forEach((day, di) => {
        const card = document.createElement('div')
        card.className = 'day-card'
        card.innerHTML = `
          <div class="day-head">
            <div class="day-title">${day.date}</div>
            <div class="day-area">${day.area} ${travelBadge(day.area)}</div>
          </div>
          <ul class="stop-list" data-day="${di}"></ul>
          <button class="add-stop-btn" data-day="${di}" type="button">+ Legg til stopp</button>
          <div class="add-form" data-day="${di}" hidden>
            <input class="af-name" type="text" placeholder="Navn på stopp *" />
            <input class="af-hours" type="text" placeholder="Åpningstider (valgfritt)" />
            <div class="af-row">
              <button class="af-save" type="button">Legg til</button>
              <button class="af-cancel" type="button">Avbryt</button>
            </div>
          </div>
        `
        const ul = card.querySelector('.stop-list')
        day.stops.forEach((s, si) => {
          const li = document.createElement('li')
          li.className = 'stop' + (s.tag === 'mat' ? ' is-food' : '')
          li.draggable = true
          li.dataset.day = di
          li.dataset.idx = si
          const tagHtml = s.tag
            ? `<span class="stop-tag ${s.tag === 'MUST' ? 'must' : s.tag === 'mat' ? 'food' : 'note'}">${s.tag}</span>`
            : ''
          li.innerHTML = `
            <span class="drag-handle" title="Dra for å flytte">⠿</span>
            <span class="stop-num">${si + 1}</span>
            <span class="stop-body">
              <span class="stop-name">${s.name}</span>
              ${s.hours ? `<span class="stop-hours">${s.hours}</span>` : ''}
            </span>
            ${tagHtml}
            <button class="remove-btn" data-day="${di}" data-idx="${si}" title="Fjern">✕</button>
          `
          ul.appendChild(li)
          const next = day.stops[si + 1]
          if (next) {
            const wt = walkText(s, next)
            if (wt) {
              const walk = document.createElement('li')
              walk.className = 'walk-row'
              walk.innerHTML = `<span class="walk-line">${wt} →</span>`
              ul.appendChild(walk)
            }
          }
        })
        daysEl.appendChild(card)
      })
      attachEvents()
    }

    let dragEl = null
    function attachEvents() {
      document.querySelectorAll('.stop').forEach((li) => {
        li.addEventListener('dragstart', () => { dragEl = li; li.classList.add('dragging') })
        li.addEventListener('dragend', () => { li.classList.remove('dragging'); dragEl = null; syncFromDom() })
      })
      document.querySelectorAll('.stop-list').forEach((ul) => {
        ul.addEventListener('dragover', (e) => {
          e.preventDefault()
          if (!dragEl || dragEl.dataset.day !== ul.dataset.day) return
          const after = getAfter(ul, e.clientY)
          if (after == null) ul.appendChild(dragEl)
          else ul.insertBefore(dragEl, after)
        })
      })
      document.querySelectorAll('.remove-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const di = +btn.dataset.day, idx = +btn.dataset.idx
          state[di].stops.splice(idx, 1)
          saveState(); render()
        })
      })
      document.querySelectorAll('.add-stop-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const form = daysEl.querySelector(`.add-form[data-day="${btn.dataset.day}"]`)
          if (form) { form.hidden = false; form.querySelector('.af-name').focus() }
        })
      })
      document.querySelectorAll('.add-form').forEach((form) => {
        const di = +form.dataset.day
        form.querySelector('.af-cancel').addEventListener('click', () => {
          form.hidden = true; form.querySelector('.af-name').value = ''; form.querySelector('.af-hours').value = ''
        })
        form.querySelector('.af-save').addEventListener('click', () => {
          const name = form.querySelector('.af-name').value.trim()
          if (!name) return
          const hours = form.querySelector('.af-hours').value.trim()
          state[di].stops.push({ name, hours, tag: '', lat: null, lng: null })
          saveState(); render()
        })
      })
    }
    function getAfter(ul, y) {
      const els = [...ul.querySelectorAll('.stop:not(.dragging)')]
      return els.reduce((closest, child) => {
        const box = child.getBoundingClientRect()
        const offset = y - box.top - box.height / 2
        if (offset < 0 && offset > closest.offset) return { offset, element: child }
        return closest
      }, { offset: -Infinity, element: null }).element
    }
    function syncFromDom() {
      state.forEach((day, di) => {
        const ul = daysEl.querySelector(`.stop-list[data-day="${di}"]`)
        const names = [...ul.querySelectorAll('.stop-name')].map((n) => n.textContent)
        const byName = new Map(day.stops.map((s) => [s.name, s]))
        day.stops = names.map((nm) => byName.get(nm)).filter(Boolean)
      })
      saveState(); render()
    }

    resetBtn.addEventListener('click', () => {
      if (!confirm('Tilbakestille hele planen til utgangspunktet? Dine endringer forsvinner.')) return
      try { localStorage.removeItem(STORE_KEY) } catch {}
      state = plan.map((d) => ({ date: d.date, area: d.area, stops: d.stops.slice() }))
      render()
    })

    render()
  </script>

  <style>
    .plan-tip {
      font-size: 0.85rem; color: var(--muted); margin: 0 0 1.5rem; max-width: 640px;
      background: rgba(244,162,76,0.08); border: 1px solid rgba(244,162,76,0.25);
      border-radius: 8px; padding: 0.7rem 0.9rem;
      display: flex; gap: 0.75rem; justify-content: space-between; align-items: center; flex-wrap: wrap;
    }
    .plan-tip strong { color: var(--accent); }
    .reset-btn {
      background: var(--surface); color: var(--text); border: 1px solid var(--border);
      padding: 0.3rem 0.7rem; border-radius: 6px; cursor: pointer; font-size: 0.8rem; white-space: nowrap;
    }
    .reset-btn:hover { border-color: var(--accent); }

    #days { display: flex; flex-direction: column; gap: 1.25rem; max-width: 640px; }
    .day-card {
      background: var(--surface); border: 1px solid rgba(176,30,52,0.25);
      border-radius: 10px; padding: 1rem; overflow: hidden;
    }
    .day-head {
      display: flex; justify-content: space-between; align-items: baseline;
      gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.75rem;
      padding-bottom: 0.6rem; border-bottom: 1px solid rgba(176,30,52,0.2);
    }
    .day-title {
      font-family: 'IBM Plex Mono', monospace; font-weight: 600; font-size: 1rem;
      color: var(--accent); text-shadow: 0 0 10px rgba(244,162,76,0.3);
    }
    .day-area { font-size: 0.85rem; color: var(--text); display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .travel { font-size: 0.72rem; color: var(--muted); font-family: 'IBM Plex Mono', monospace; }

    .stop-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.3rem; }
    .stop {
      display: flex; align-items: center; gap: 0.5rem;
      background: rgba(26,12,18,0.5); border: 1px solid var(--border);
      border-radius: 8px; padding: 0.6rem 0.6rem; cursor: grab;
    }
    .stop.is-food { background: rgba(40,26,8,0.5); border-color: rgba(243,156,18,0.35); }
    .stop.dragging { opacity: 0.5; border-color: var(--accent); }
    .drag-handle {
      color: var(--accent); font-size: 1.25rem; cursor: grab; flex-shrink: 0;
      touch-action: none; opacity: 0.7; line-height: 1;
    }
    .stop-num {
      flex-shrink: 0; width: 20px; height: 20px; border-radius: 50%;
      background: var(--border); color: var(--text); font-size: 0.7rem; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      font-family: 'IBM Plex Mono', monospace;
    }
    .stop-body { display: flex; flex-direction: column; gap: 0.15rem; flex: 1; min-width: 0; }
    .stop-name { font-weight: 600; font-size: 0.92rem; overflow-wrap: anywhere; }
    .stop-hours { font-size: 0.75rem; color: var(--muted); font-family: 'IBM Plex Mono', monospace; overflow-wrap: anywhere; }
    .stop-tag {
      flex-shrink: 0; font-size: 0.68rem; font-weight: 700; padding: 0.2rem 0.5rem;
      border-radius: 4px; font-family: 'IBM Plex Mono', monospace; letter-spacing: 0.03em;
    }
    .stop-tag.must { background: #e74c3c; color: #fff; }
    .stop-tag.food { background: #f39c12; color: #2a1a04; }
    .stop-tag.note { background: var(--border); color: var(--text); }
    .remove-btn {
      flex-shrink: 0; background: none; border: none; color: var(--muted);
      font-size: 0.95rem; cursor: pointer; padding: 0.2rem 0.35rem; line-height: 1; border-radius: 4px;
    }
    .remove-btn:hover { color: #e74c3c; background: rgba(231,76,60,0.12); }

    .walk-row { padding: 0.05rem 0 0.05rem 2rem; }
    .walk-line { font-size: 0.72rem; color: var(--muted); font-family: 'IBM Plex Mono', monospace; }

    .add-stop-btn {
      margin-top: 0.6rem; width: 100%; background: rgba(244,162,76,0.08);
      color: var(--accent); border: 1px dashed rgba(244,162,76,0.4);
      padding: 0.55rem; border-radius: 8px; cursor: pointer; font-size: 0.85rem; font-weight: 600;
    }
    .add-stop-btn:hover { background: rgba(244,162,76,0.15); }
    .add-form { margin-top: 0.6rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .add-form input {
      background: var(--bg); color: var(--text); border: 1px solid var(--border);
      padding: 0.6rem 0.7rem; border-radius: 8px; font-size: 0.9rem; font-family: inherit;
    }
    .af-row { display: flex; gap: 0.5rem; }
    .af-save {
      flex: 1; background: var(--accent); color: #fff; border: none;
      padding: 0.55rem; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 0.85rem;
    }
    .af-cancel {
      background: var(--surface); color: var(--muted); border: 1px solid var(--border);
      padding: 0.55rem 0.9rem; border-radius: 8px; cursor: pointer; font-size: 0.85rem;
    }
  </style>
</Base>