      { name: 'Kamikaze Style Akihabara', hours: '10:00–21:00', tag: '' },
      { name: 'Tokyo Hobby Center', hours: '11:00–22:00', tag: '' },
      { name: 'Darumanome Akihabara', hours: '10:30–22:00', tag: 'mat' },
    ],
