    document.querySelector('#itl-detail-close')!.addEventListener('click', closeSheet)

    // Pages opened from the sheet (the shop's /edit-store, a find's /edit-price) get "← Back to
    // timeline" to this day and trip (lib/timeline-back.ts).
    const backQuery = () => fromTimelineQuery(currentDay, new URLSearchParams(wrap.dataset.tripQuery ? wrap.dataset.tripQuery.slice(1) : '').get('trip'))
    function shopPageUrl(shopId: string, hash = '') {
      return `/edit-store?id=${encodeURIComponent(shopId)}&${backQuery()}${hash}`
    }
    function fillSheet() {
      const day = sheetDay()
      const idx = sheetIdx()
      if (idx < 0) { closeSheet(); return }
      const { sched, inputs } = computeDayTimes(day, base, shopById)
      const x = sched.stops[idx]
      const s = day.stops[idx]
      const lines: (string | { html: string })[] = [] // text, escaped below — or ready HTML
      lines.push(x.fixed ? `📌 ${formatClock(x.start)}–${formatClock(x.end)}${x.arrival !== x.start ? ` · arrive by ${formatClock(x.arrival)}` : ''}` : `${formatClock(x.start)}–${formatClock(x.end)} (${inputs[idx].durationMin} min)`)
      if (s.hours) lines.push(`Opening hours: ${s.hours}`)
      // "Leave by" with the list's "⏰ Reminder" link (itinerary-ui.ts reminderLinkHtml).
      if (x.leaveBy != null) lines.push({ html: `Leave by ${formatClock(x.leaveBy)}${reminderLinkHtml(day, idx, x.leaveBy, shopById)}` })
      if (x.stayUntil != null) lines.push(`You can stay until ${formatClock(x.stayUntil)}`)
      if (x.doesntFit) lines.push(`⚠️ Doesn't fit before ${resolveStop(day.stops[x.doesntFit.anchorIndex], shopById).name} ${formatClock(x.doesntFit.anchorTime)} (${x.doesntFit.shortMin} min short)`)
      else if (x.leaveEarlierMin) lines.push(`⚠️ Leave ${x.leaveEarlierMin} min earlier`)
      if (x.arrivesAfterLeave != null) lines.push(`⚠️ Arrives after your leave time (${formatClock(x.arrivesAfterLeave)})`)
      const hoursWarning = stopHoursWarning(s, shopById, day.day, x.start, x.end)
      if (hoursWarning) lines.push(hoursWarning.note ? hoursWarning.message : `⚠️ ${hoursWarning.message}`)
      if (afterMidnight(x)) lines.push(`⚠️ After midnight (${formatClock(x.start)})`)
      const trains = lastTrainLegs(sched)
      const into = trains.find((l) => l.index === idx)
      if (into) lines.push(`⚠️ The train here at ${formatClock(into.departs)}: ${LAST_TRAIN_MESSAGE}`)
      const backLeg = idx === day.stops.length - 1 ? trains.find((l) => l.index === day.stops.length) : undefined
      if (backLeg) lines.push(`⚠️ The train back to the base at ${formatClock(backLeg.departs)}: ${LAST_TRAIN_MESSAGE}`)
      // The name opens the linked shop's page, which links back to this day.
      const nameEl = document.querySelector('#itl-detail-name') as HTMLElement
      const stopName = resolveStop(s, shopById).name
      if (s.shopId && shopById.has(s.shopId)) nameEl.innerHTML = `<a id="itl-detail-shop" href="${esc(shopPageUrl(s.shopId))}">${esc(stopName)}</a>`
      else nameEl.textContent = stopName
