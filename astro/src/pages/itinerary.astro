    stops: [
      { name: 'animate Flagship Store', hours: '10:00–21:00', tag: '' },
      { name: 'Gashapon Main Store', hours: '10:00–21:00', tag: '' },
      { name: 'Donguri (Ghibli) Ikebukuro', hours: '10:00–20:00', tag: '' },
