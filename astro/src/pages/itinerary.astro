    function focusFromUrl() {
      const params = new URLSearchParams(window.location.search)
      const di = state.findIndex((d) => d.day === params.get('day'))
      const idx = params.get('stop')
      if (di < 0 || idx == null) return
      const li = daysEl.querySelector(`.stop[data-day="${di}"][data-idx="${+idx}"]`)
      if (!li) return
      li.classList.add('itn-focus')
      li.scrollIntoView({ block: 'center' })
