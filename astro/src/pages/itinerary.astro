---
import Base from '../layouts/Base.astro'
import { loadItineraryPageData, loadShopFinds } from '../lib/itinerary-page-data'
import { fetchTrips } from '../lib/price-products'
import { PEOPLE_LIST, OWNER } from '../lib/price-entry-fields'
import '../styles/itinerary-shared.css'
import { tokyoNow, parseTokyoDateTime } from '../lib/trip-dates'

// The itinerary: a calendar-style day view of the plan. The same plan as the list
// (/itinerary-list): the same data (loadItineraryPageData),
// the same timetable (itinerary-plan.ts computeDayTimes) and the same saved format.
const { BASE, shops, savedState, plan, trip, days, labels, flight } = await loadItineraryPageData(Astro.url)
// "Found here" per shop, for the edit sheet (the shop page's list).
const { found, rate: foundRate } = await loadShopFinds()
// "✅ Bought" in that strip: the same choices as /edit-price — who buys it, and the trips (with
// who has a budget on each, for public/trip-select.js).
let priceTrips: Awaited<ReturnType<typeof fetchTrips>> = []
try { priceTrips = await fetchTrips() } catch (e) { priceTrips = [] }
// ?day=<date>, else today in Tokyo if it's one of the trip's days, else the first.
const requestedDay = Astro.url.searchParams.get('day') || ''
// ?now=YYYY-MM-DDTHH:MM (Tokyo time) stands in for the clock on this page — to try "I'm here
// now" before the trip. Shown as "Test time" whenever it's used.
const testNow = parseTokyoDateTime(Astro.url.searchParams.get('now'))
const today = (testNow || tokyoNow()).date
const initialDay = days.includes(requestedDay) ? requestedDay : days.includes(today) ? today : days[0]
const tripQuery = Astro.url.searchParams.get('trip') ? `?trip=${encodeURIComponent(Astro.url.searchParams.get('trip')!)}` : ''
---
<Base title="Timeline">
  <div class="itl-wrap" data-initial-day={initialDay} data-trip-query={tripQuery}>
    <div class="itl-nav">
      <a id="itl-list-link" href={`/itinerary-list${tripQuery}`} class="itl-nav-link">📋 List view</a>
      <span id="itl-save-status" class="itl-save-status"></span>
    </div>
    <h1>Timeline <span class="itl-beta">beta</span></h1>
    <!-- Shown while a test time is set (?now=, or the "🧪 Test time" control below). -->
    <p id="itl-test-time" class="itl-test-time" data-date={testNow ? testNow.date : ''} data-minutes={testNow ? testNow.minutes : ''} hidden={!testNow}>
      🧪 Test time: <span id="itl-test-time-text">{testNow ? `${testNow.date} ${String(Math.floor(testNow.minutes / 60)).padStart(2, '0')}:${String(testNow.minutes % 60).padStart(2, '0')}` : ''}</span> (Tokyo) — "Clear test time" to use the real clock
    </p>

    <div class="itl-tabs" id="itl-tabs" role="tablist">
      {days.map((d) => (
        <button type="button" role="tab" class:list={['itl-tab', { active: d === initialDay }]} data-day={d} aria-selected={d === initialDay ? 'true' : 'false'}>{labels[d]}</button>
      ))}
    </div>
    <!-- The day's areas in visiting order (itinerary-plan.ts dayAreas). -->
    <p id="itl-day-areas" class="itl-day-areas" hidden></p>

    <div class="itl-toolbar">
      <p class="itl-hint">Tap an empty spot to add a stop there.</p>
      <div class="itl-zoom" role="group" aria-label="Zoom">
        <button id="itl-zoom-out" type="button" aria-label="Zoom out">−</button>
        <button id="itl-zoom-in" type="button" aria-label="Zoom in">+</button>
      </div>
    </div>

    <div class="itl-daybar">
      <label class="itl-start">🕗 Start <input id="itl-start" type="time" /></label>
      <button id="itl-check-btn" type="button" class="itl-daybtn">🔍 Check day</button>
      <button id="itl-route-btn" type="button" class="itl-daybtn">🧭 Suggest route</button>
      <span id="itl-dayroute" class="itl-dayroute"></span>
      <button id="itl-reset-day" type="button" class="itl-daybtn" hidden>↺ Reset day</button>
      <button id="itl-rem-btn" type="button" class="itl-daybtn">⏰ Reminders for this day</button>
      <button id="itl-link-btn" type="button" class="itl-daybtn">🔗 Link stops to shops</button>
      <button id="itl-test-btn" type="button" class="itl-daybtn">🧪 Test time</button>
      <button id="itl-test-clear" type="button" class="itl-daybtn" hidden={!testNow}>Clear test time</button>
    </div>
    <!-- "🧪 Test time": pretend it's this date and time in Tokyo — the same as ?now=. -->
    <form id="itl-test-form" class="itl-test-form" hidden>
      <select id="itl-test-date" aria-label="Test date">
        {days.map((d) => <option value={d}>{labels[d]}</option>)}
      </select>
      <input id="itl-test-clock" type="time" aria-label="Test time of day" required />
      <button id="itl-test-set" type="submit" class="itl-daybtn">Set</button>
      <button id="itl-test-cancel" type="button" class="itl-daybtn">Cancel</button>
    </form>
    <details id="itl-map-section" class="itl-map-section">
      <summary>🗺️ Map</summary>
      <div id="itl-map" class="day-map itl-map"></div>
    </details>
    <div id="itl-check-results" class="itl-panel" hidden></div>
    <!-- "⏰ Reminders for this day": every leave-by time, checked by default, in one .ics file
         (itinerary-ui.ts dayReminders / remindersHref). The items are built in the script. -->
    <!-- "🔗 Link stops to shops": the unlinked stops of every day with a suggested shop
         (lib/stop-linking.ts); nothing is saved until "Link selected". Rows built in the script. -->
    <div id="itl-link" class="itl-panel itl-link" hidden>
      <div class="itl-rem-head">
        <strong>🔗 Link stops to shops</strong>
        <button id="itl-link-close" type="button" aria-label="Close">✕</button>
      </div>
      <p class="itl-rem-note">A linked stop shows the shop's area, hours, photos and finds. Exact name matches are ticked; check the close ones.</p>
      <ul id="itl-link-list" class="itl-link-list"></ul>
      <p id="itl-link-empty" class="itl-rem-empty" hidden>Every stop is linked to a shop.</p>
      <button id="itl-link-save" type="button" class="itl-daybtn">Link selected</button>
      <p id="itl-link-msg" class="itl-rem-note" hidden></p>
    </div>
    <div id="itl-reminders" class="itl-panel itl-reminders" hidden>
      <div class="itl-rem-head">
        <strong>⏰ Reminders for this day</strong>
        <button id="itl-rem-close" type="button" aria-label="Close">✕</button>
      </div>
      <div class="itl-rem-tools">
        <button id="itl-rem-all" type="button">Select all</button>
        <button id="itl-rem-none" type="button">Select none</button>
      </div>
      <ul id="itl-rem-list" class="itl-rem-list"></ul>
      <p id="itl-rem-empty" class="itl-rem-empty" hidden>No leave-by times on this day.</p>
      <a id="itl-rem-add" class="itl-daybtn itl-rem-add" href="#" download="leave-reminders.ics">📅 Add to calendar</a>
      <p class="itl-rem-note">If you change the plan later, add the reminders again. Old ones stay in your calendar.</p>
    </div>
    <div id="itl-route-results" class="itl-panel" hidden></div>
    <div id="itl-travel-editor" class="itl-travel-editor" hidden>
      <div class="itl-travel-editor-head">
        <strong id="itl-travel-editor-title"></strong>
        <button id="itl-travel-editor-close" type="button" aria-label="Close">✕</button>
      </div>
      <div id="itl-travel-edit" class="itn-travel-edit"></div>
      <!-- "🚆 Plan train" (legs over TRAIN_PLAN_MIN_LEG minutes, or with a train): look it up in
           Google Maps, then add it by hand or from a screenshot (lib/train-plan.ts). -->
      <div id="itl-train" class="itl-train" hidden>
        <p class="itl-train-head">🚆 Plan train</p>
        <p id="itl-train-summary" class="itl-train-summary" hidden></p>
        <div class="itl-train-actions">
          <a id="itl-train-maps" class="itl-train-btn" href="https://www.google.com/maps" target="_blank" rel="noopener">🗺️ Transit in Google Maps</a>
          <button id="itl-train-manual" type="button" class="itl-train-btn">✏️ Enter train</button>
          <button id="itl-train-remove" type="button" class="itl-train-btn itl-train-remove" hidden>🗑️ Remove train</button>
        </div>
        <form id="itl-train-form" class="itl-train-form" hidden>
          <div class="itl-train-grid">
            <label>Line <input id="itl-tr-line" type="text" maxlength="60" placeholder="Tokaido Line" /></label>
            <label>Train <input id="itl-tr-train" type="text" maxlength="60" placeholder="Rapid 1234" /></label>
            <label>From station <input id="itl-tr-from" type="text" maxlength="60" /></label>
            <label>Departs <input id="itl-tr-dep" type="time" required /></label>
            <label>Platform <input id="itl-tr-platform" type="text" maxlength="60" /></label>
            <label>Walk to station <span><input id="itl-tr-walk" type="number" min="0" max="60" step="1" /> min</span></label>
            <label>To station <input id="itl-tr-to" type="text" maxlength="60" /></label>
            <label>Arrives <input id="itl-tr-arr" type="time" required /></label>
          </div>
          <div id="itl-tr-transfers" class="itl-tr-transfers"></div>
          <button id="itl-tr-add-transfer" type="button" class="itl-train-btn">＋ Transfer</button>
          <p id="itl-tr-error" class="itl-train-error" hidden></p>
          <div class="itl-train-actions">
            <button id="itl-tr-save" type="submit" class="itl-train-btn itl-train-save">Save train</button>
            <button id="itl-tr-cancel" type="button" class="itl-train-btn">Cancel</button>
          </div>
        </form>
      </div>
    </div>

    <form id="itl-add" class="itl-add" hidden>
      <p class="itl-add-title">Add a stop around <strong id="itl-add-time"></strong></p>
      <select id="itl-add-shop" aria-label="Shop"></select>
      <div id="itl-add-custom" class="itl-add-custom" hidden>
        <input id="itl-add-name" type="text" placeholder="Name *" />
        <input id="itl-add-hours" type="text" placeholder="Info (optional)" />
      </div>
      <label class="itl-add-dur">Duration <input id="itl-add-dur" type="number" min="5" step="5" value="45" /> min</label>
      <p class="itl-add-note">It goes after the stops that start before this time; the day is recalculated, so its time may move.</p>
      <div class="itl-add-actions">
        <button id="itl-add-save" type="submit">Add</button>
        <button id="itl-add-cancel" type="button">Cancel</button>
      </div>
    </form>

    <!-- Tap a block: this bottom sheet, with everything the list's ⋯ menu offers (plus tag and
         note). Fixed to the bottom of the screen above the nav; no sticky, no backdrop-filter. -->
    <div id="itl-detail" class="itl-detail itl-sheet" role="dialog" aria-label="Edit stop" hidden>
      <div class="itl-detail-head">
        <strong id="itl-detail-name"></strong>
        <button id="itl-detail-close" type="button" aria-label="Close">✕</button>
      </div>
      <ul id="itl-detail-lines" class="itl-detail-lines"></ul>
      <!-- The linked shop's photos (itinerary-ui.ts shopPhotoStripHtml) — or, when it has none, a
           link to add some on its page — and what was found there (foundStripHtml). -->
      <div id="itl-ed-photos" hidden></div>
      <div id="itl-ed-link" class="itl-sheet-row" hidden>
        <label>🔗 Link to shop <select id="itl-ed-link-shop"></select></label>
        <button id="itl-ed-link-save" type="button">Link</button>
      </div>
      <p id="itl-ed-photos-empty" class="itl-sheet-empty" hidden>No shop photos yet — <a id="itl-ed-photos-add" href="/notes">add them on the shop page</a></p>
      <div id="itl-ed-found" hidden></div>
      <!-- Opens Maps in a new tab to browse the place's photos there (lib/shop-maps.ts). -->
      <!-- "✅ Bought" on a price in the strip: /edit-price's choices with its defaults, then the
           same /api/price-entry-update bought save (lib/price-entry-fields.ts). -->
      <div id="itl-bought" class="itl-bought" hidden>
        <p class="itl-bought-title">Mark <strong id="itl-bought-name"></strong> as bought</p>
        <div class="itl-sheet-grid">
          <label>Who buys it
            <select id="itl-bought-buyer">{PEOPLE_LIST.map((p) => <option value={p}>{p}</option>)}</select>
          </label>
          <label>Trip <select id="itl-bought-trip"></select></label>
          <label id="itl-bought-addto-field">Add to
            <select id="itl-bought-addto">
              <option value="collection">Final Fantasy collection</option>
              <option value="other">Other things I own</option>
            </select>
          </label>
          <label id="itl-bought-passport-field">Paid with passport
            <select id="itl-bought-passport">
              {PEOPLE_LIST.map((p) => <option value={p}>{p}</option>)}
              <option value="none">No passport (not tax-free)</option>
            </select>
          </label>
        </div>
        <p id="itl-bought-no-trip" class="itl-bought-note" hidden></p>
        <p id="itl-bought-msg" class="itl-bought-msg" hidden></p>
        <div class="itl-sheet-row">
          <button id="itl-bought-confirm" type="button" class="itl-bought-confirm">✅ Confirm bought</button>
          <button id="itl-bought-cancel" type="button">Cancel</button>
        </div>
      </div>
      <a id="itl-ed-gmaps" class="itl-gmaps" href="https://www.google.com/maps" target="_blank" rel="noopener">📷 Photos on Google Maps</a>
      <div id="itl-ed-now" class="itl-sheet-row itl-sheet-now" hidden>
        <button id="itl-ed-here" type="button">📍 I'm here now</button>
        <button id="itl-ed-leave" type="button">✅ Leaving now</button>
      </div>
      <div class="itl-sheet-grid">
        <label>⏱ Duration <span><input id="itl-ed-dur" type="number" min="5" step="5" /> min</span></label>
        <label>🕐 Fixed time <input id="itl-ed-time" type="time" /></label>
        <label>🚪 Leave at
          <span class="itl-leaveat">
            <input id="itl-ed-leaveat" type="time" />
            <button id="itl-ed-leaveat-clear" type="button" aria-label="Clear the leave time">✕</button>
          </span>
          <button id="itl-ed-until-close" type="button" class="itl-until-close" hidden>Until closing</button>
        </label>
        <label id="itl-ed-early-label">Arrive early <span><input id="itl-ed-early" type="number" min="0" step="5" /> min</span></label>
        <label>Tag <input id="itl-ed-tag" type="text" list="itl-tag-options" placeholder="MUST, mat …" /></label>
      </div>
      <datalist id="itl-tag-options"><option value="MUST"></option><option value="mat"></option><option value="sett av tid"></option></datalist>
      <label class="itl-sheet-note">Note <textarea id="itl-ed-note" rows="2"></textarea></label>
      <div class="itl-sheet-row">
        <button id="itl-ed-up" type="button">▲ Up</button>
        <button id="itl-ed-down" type="button">▼ Down</button>
        <label>Move to <select id="itl-ed-move"></select></label>
      </div>
      <div class="itl-sheet-row">
        <input id="itl-ed-coord" type="text" placeholder="lat, lng (from Google Maps)" aria-label="Coordinates" />
        <button id="itl-ed-coord-save" type="button">Save</button>
        <button id="itl-ed-coord-fetch" type="button">🔄 From the shop</button>
      </div>
      <p id="itl-ed-coord-msg" class="itl-sheet-msg" hidden></p>
      <div class="itl-sheet-row itl-sheet-foot">
        <button id="itl-ed-delete" type="button" class="itl-sheet-delete">🗑️ Delete</button>
        <a id="itl-detail-edit" class="itl-detail-edit" href="/itinerary-list">Edit in list →</a>
      </div>
    </div>

    <!-- A day that ends too late: the message and, per stop after the latest end, "Move to…"
         another Tokyo day with its end time (built in the script). -->
    <div id="itl-late" class="itl-late" hidden></div>
    <div id="itl-day" class="itl-day"></div>
  </div>

  <script is:inline src="/trip-select.js"></script>
  <script type="application/json" id="itl-data" set:html={JSON.stringify({ plan, days, labels, flight, base: BASE, shops, savedState, found, foundRate, priceTrips, pageTripId: trip?._id || '' })}></script>

  <script>
    import {
      buildPlanState, serializePlan, normalizeSavedPlan, computeDayTimes, resolveStop, stopHoursWarning, dayWarningFor, dayAreas,
      shopOptionGroups, shopStopFrom, customStopFrom, dayRouteUrls, checkDayRequestBody, optimizerInput,
      legFromKey, manualTravelFor, DEFAULT_START, moveStopBy, moveStopToDay, removeStop, setStopDuration,
      setArriveEarly, setFixedTime, markHereNow, markLeavingNow, clearActualTimes, hasActualTimes, setLeaveAt, closingTimeFor,
      type PlanDay, type PlanShop, type PlanStop,
    } from '../lib/itinerary-plan'
    import {
      loadLeaflet, drawDayMap, travelEditorInnerHtml, bindTravelEditor, runCheckDay,
      renderRouteSuggestion, renderRouteApplied, renderNoStopsToReorder, saveStopCoords, fetchStopCoordsFromShop,
      reminderLinkHtml, shopPhotoStripHtml, foundStripHtml, dayReminders, remindersHref,
    } from '../lib/itinerary-ui'
    import type { FoundItem } from '../lib/shop-found'
    import { googleMapsPlaceUrl } from '../lib/shop-maps'
    import { fromTimelineQuery } from '../lib/timeline-back'
    import { OWNER, defaultAddTo, boughtPreCheck, priceEntryFormValues, priceEntryUpdateBody } from '../lib/price-entry-fields'
    import { optimizeRoute } from '../lib/route-optimizer'
    import { linkSuggestions, suggestShop } from '../lib/stop-linking'
    import { validateTrain, trainSummary, type TrainPlan, type TrainTransfer } from '../lib/train-plan'
    import { timelineRange, layoutTimeline, offsetFor, minutesAtOffset, insertIndexForTime, ZOOM_LEVELS, DEFAULT_ZOOM_INDEX, CHIP_PX } from '../lib/itinerary-timeline'
    import { latestEndForFlight, formatClock } from '../lib/itinerary-review-helpers'
    import { transitRouteUrl } from '../lib/itinerary-schedule'
    // "🚆 Plan train" is offered on legs longer than this.
    const TRAIN_PLAN_MIN_LEG = 20
    import { dayWarningMessages, lastTrainLegs, afterMidnight, LAST_TRAIN_MESSAGE } from '../lib/itinerary-schedule'
    import { formatDayShortEn } from '../lib/trip-dates'
    import { tokyoNow } from '../lib/trip-dates'

    const DATA = JSON.parse(document.querySelector('#itl-data')?.textContent || '{}')
    const { plan, days, labels, flight, base, shops, savedState } = DATA
    const foundByShop: Record<string, FoundItem[]> = DATA.found || {}
    const foundRate: number | null = DATA.foundRate ?? null
    const shopById = new Map<string, PlanShop>((shops || []).map((s: PlanShop) => [s._id, s]))
    const wrap = document.querySelector('.itl-wrap') as HTMLElement
    const dayEl = document.querySelector('#itl-day') as HTMLElement
    const esc = (s: unknown) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!)

    // The same load as the list (/itinerary-list): the server's saved plan, else this browser's copy.
    const STORE_KEY = 'ff-itinerary-v12' // must match itinerary-list.astro
    function loadSaved() {
      if (savedState) { try { const p = normalizeSavedPlan(JSON.parse(savedState), plan); if (p) return p } catch (e) {} }
      try { const s = localStorage.getItem(STORE_KEY); return s ? normalizeSavedPlan(JSON.parse(s), plan) : null } catch { return null }
    }
    const built = buildPlanState(plan, days, labels, loadSaved() || {})
    let state: PlanDay[] = built.state
    const extraDays = built.extraDays
    let currentDay: string = wrap.dataset.initialDay || days[0]

    // Zoom (pixels per minute), remembered in this browser — storage can be unavailable (private
    // mode, blocked), so every access is guarded and the default is used then.
    const ZOOM_KEY = 'ff-timeline-zoom'
    let zoomIndex = DEFAULT_ZOOM_INDEX
    try {
      const saved = Number(localStorage.getItem(ZOOM_KEY))
      if (Number.isInteger(saved) && saved >= 0 && saved < ZOOM_LEVELS.length && localStorage.getItem(ZOOM_KEY) !== null) zoomIndex = saved
    } catch (e) {}
    const zoomOut = document.querySelector('#itl-zoom-out') as HTMLButtonElement
    const zoomIn = document.querySelector('#itl-zoom-in') as HTMLButtonElement
    function setZoom(i: number) {
      zoomIndex = Math.max(0, Math.min(ZOOM_LEVELS.length - 1, i))
      try { localStorage.setItem(ZOOM_KEY, String(zoomIndex)) } catch (e) {}
      render()
    }
    zoomOut.addEventListener('click', () => setZoom(zoomIndex - 1))
    zoomIn.addEventListener('click', () => setZoom(zoomIndex + 1))

    // Saving: the same as the list — the whole plan in its { v: 2, days } form
    // (serializePlan), in this browser and, a second later, to /api/itinerary-save.
    const saveStatus = document.querySelector('#itl-save-status') as HTMLElement
    let saveTimer: ReturnType<typeof setTimeout> | undefined
    function saveState() {
      const payload = serializePlan(state, extraDays)
      try { localStorage.setItem(STORE_KEY, payload) } catch {}
      saveStatus.textContent = 'Lagrer…'
      clearTimeout(saveTimer)
      saveTimer = setTimeout(async () => {
        try {
          const res = await fetch('/api/itinerary-save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ data: payload }) })
          saveStatus.textContent = res.ok ? 'Lagret ✓' : 'Lagring feilet'
        } catch (e) {
          saveStatus.textContent = 'Lagret lokalt (ingen nett)'
        }
      }, 1000)
    }

    // The clock in Tokyo — or the ?now= test time (see the frontmatter), which stays put.
    const testTimeEl = document.querySelector('#itl-test-time') as HTMLElement
    const nowTokyo = () => !testTimeEl.hidden
      ? { date: testTimeEl.dataset.date!, minutes: Number(testTimeEl.dataset.minutes) }
      : tokyoNow()

    // Which of "I'm here now" / "Leaving now" a stop offers — only on today's day in Tokyo:
    // "I'm here now" until you've got there, "Leaving now" until you've left. The same on the
    // block and in its edit sheet.
    const nowButtons = (day: PlanDay, x: { actual: boolean; visited: boolean }) => {
      const isToday = day.day === nowTokyo().date
      return { here: isToday && !x.actual, leave: isToday && !x.visited }
    }
    // Pressing one: stored on the stop as actualStart/actualEnd ("HH:MM"); the timetable runs on
    // from them (src/lib/itinerary-schedule.ts).
    function markNow(kind: 'here' | 'leave', day: PlanDay, idx: number) {
      const stop = day.stops[idx]
      const now = nowTokyo().minutes
      if (kind === 'here') markHereNow(stop, now)
      else markLeavingNow(stop, now, computeDayTimes(day, base, shopById).sched.stops[idx].start)
      checkMarks = {}
      saveState(); render()
    }

    // Stops the last "Check day" had something to say about: index -> 'warning' | 'tip'. Cleared
    // when the day or the plan changes (indices would no longer match).
    let checkMarks: Record<number, string> = {}

    function render() {
      const di = state.findIndex((d) => d.day === currentDay)
      const day = state[di]
      dayEl.replaceChildren()
      if (!day) return
      renderDayBar(day)
      const areas = dayAreas(day, shopById)
      const areasEl = document.querySelector('#itl-day-areas') as HTMLElement
      areasEl.textContent = areas.join(' · ')
      areasEl.hidden = !areas.length
      const { sched, inputs, baseStart } = computeDayTimes(day, base, shopById)
      renderLateDay(day, sched)
      // Train legs after the last trains: the stop they go to (or back to the base).
      const lateTrains = new Map(lastTrainLegs(sched).map((l) => [l.index, l]))
      const range = timelineRange(sched)
      const px = ZOOM_LEVELS[zoomIndex]
      zoomOut.disabled = zoomIndex === 0
      zoomIn.disabled = zoomIndex === ZOOM_LEVELS.length - 1
      const grid = document.createElement('div')
      grid.className = 'itl-grid'
      grid.style.height = `${offsetFor(range.end, range, px)}px`
      grid.dataset.start = String(range.start)
      grid.dataset.px = String(px)
      grid.dataset.end = String(range.end)

      for (let m = range.start; m <= range.end; m += 60) {
        const hour = document.createElement('div')
        hour.className = 'itl-hour'
        hour.style.top = `${offsetFor(m, range, px)}px`
        hour.textContent = formatClock(m)
        grid.appendChild(hour)
      }

      // Travel in its own lane on the right (lib/itinerary-timeline.ts layoutTimeline): a striped
      // band with the label inside, or a small chip when the leg is too short for it.
      const layout = layoutTimeline(sched, range, px)
      layout.travel.forEach((tr) => {
        const el = document.createElement('div')
        el.className = 'itl-travel' + (tr.chip ? ' itl-travel-chip' : '') + (tr.back ? ' itl-travel-back' : '')
        // The trip back to the base is an estimate, as on the list — not editable.
        if (!tr.back) el.setAttribute('role', 'button')
        el.title = tr.back ? 'Travel back to the base' : 'Travel time'
        el.style.top = `${tr.chip ? tr.chipTop : tr.top}px`
        el.style.height = `${tr.chip ? CHIP_PX : tr.height}px`
        el.dataset.index = String(tr.index)
        const legTrain = !tr.back ? day.stops[tr.index]?.train : undefined
        if (legTrain) {
          el.classList.add('itl-travel-train')
          el.textContent = `🚆 ${legTrain.departure}`
        } else {
          el.textContent = `${tr.mode === 'walk' ? '🚶' : '🚆'} ${tr.minutes} min`
          // A long leg offers "🚆 Plan train" (a label under the time, drawn by CSS).
          if (!tr.back && !tr.chip && tr.minutes > TRAIN_PLAN_MIN_LEG) el.classList.add('itl-travel-plan')
        }
        grid.appendChild(el)
      })

      // Stops: side by side in columns where they overlap (layoutTimeline).
      layout.stops.forEach((item) => {
        const el = document.createElement('div')
        el.style.top = `${item.top}px`
        el.style.height = `${item.height}px`
        el.style.left = `calc(var(--itl-gap) + var(--itl-cols-w) * ${item.col} / ${item.cols})`
        el.style.width = `calc(var(--itl-cols-w) / ${item.cols} - var(--itl-gap))`
        el.dataset.index = String(item.index)
        el.dataset.col = String(item.col)
        el.dataset.cols = String(item.cols)
        const x = sched.stops[item.index]
        const s = day.stops[item.index]
        const r = resolveStop(s, shopById)
        // Opening hours on the day's weekday (itinerary-plan.ts stopHoursWarning): a short badge
        // ("Closed", "Opens 11:00", "Closes 22:00") and the coloured edge; "Hours not understood"
        // is only a quiet note.
        const hoursWarning = stopHoursWarning(s, shopById, day.day, x.start, x.end)
        const closed = !!hoursWarning && !hoursWarning.note
        const warnings: string[] = []
        if (x.doesntFit) warnings.push(`⚠️ Doesn't fit before ${formatClock(x.doesntFit.anchorTime)} (${x.doesntFit.shortMin} min short)`)
        else if (x.leaveEarlierMin) warnings.push(`⚠️ Leave ${x.leaveEarlierMin} min earlier`)
        if (x.arrivesAfterLeave != null) warnings.push(`⚠️ Arrives after your leave time (${formatClock(x.arrivesAfterLeave)})`)
        const midnight = afterMidnight(x)
        const lastTrain = lateTrains.has(item.index)
        el.className = 'itl-block' + (x.fixed ? ' itl-fixed' : '') + (x.doesntFit ? ' itl-warn-fit' : x.leaveEarlierMin ? ' itl-warn-leave' : midnight || lastTrain ? ' itl-warn-late' : closed ? ' itl-warn-closed' : '')
          + (checkMarks[item.index] ? ` itl-ir-${checkMarks[item.index]}` : '')
        if (checkMarks[item.index]) warnings.push(checkMarks[item.index] === 'warning' ? '🔍 See Check day' : '🔍 Tip in Check day')
        el.dataset.start = String(item.start)
        el.dataset.dur = String(inputs[item.index].durationMin)
        const time = x.visited
          ? `✓ ${formatClock(x.start)}–${formatClock(x.end)}`
          : x.actual
            ? `📍 since ${formatClock(x.start)}`
            : x.fixed
              ? `📌 ${formatClock(x.start)}${x.arrival !== x.start ? ` (arrive ${formatClock(x.arrival)})` : ''}`
              : `${formatClock(x.start)}–${formatClock(x.end)}`
        const timeText = time + (s.leaveAt && !x.actual ? ` · until ${s.leaveAt}` : '')
        if (x.visited) el.classList.add('itl-visited')
        // Today in Tokyo (nowButtons): "I'm here now" / "Leaving now" right under the first line,
        // so a short block doesn't cut them off; just the icons where blocks share the width (the
        // edit sheet has them in full).
        const now = nowButtons(day, x)
        const narrow = item.cols > 1
        const here = now.here ? `<button type="button" class="itl-here" aria-label="I'm here now" title="I'm here now">📍${narrow ? '' : ' I\'m here now'}</button>` : ''
        const leave = now.leave ? `<button type="button" class="itl-leave" aria-label="Leaving now" title="Leaving now">✅${narrow ? '' : ' Leaving now'}</button>` : ''
        const actions = here || leave ? `<span class="itl-actions">${here}${leave}</span>` : ''
        // "Leave by HH:MM" with the list's "⏰ Reminder" (.ics) link (itinerary-ui.ts reminderLinkHtml),
        // just "⏰" where blocks share the width — so a tap on the block mostly misses it.
        const leaveBy = x.leaveBy != null ? `<span class="itl-leaveby">Leave by ${formatClock(x.leaveBy)}${reminderLinkHtml(day, item.index, x.leaveBy, shopById, narrow)}</span>` : ''
        // First line "name · time" (the name only ever shortens with an ellipsis), then the
        // buttons above, the leave-by line, the opening hours, then any warnings.
        // The warnings right under the first line, so a short block still shows them.
        const badges = (midnight ? '<span class="itl-late-badge">After midnight</span>' : '')
          + (lastTrain ? '<span class="itl-late-badge" title="' + esc(LAST_TRAIN_MESSAGE) + '">🚆 Last trains</span>' : '')
          + (closed ? `<span class="itl-hours-badge">${esc(hoursWarning!.badge)}</span>` : '')
          + warnings.map((w) => `<span class="itl-badge">${esc(w)}</span>`).join('')
        // The first line: "<name> · HH:MM–HH:MM · 📍 <area>" — the name is never hidden; the time
        // and the linked shop's area (a stop written by hand has none) are cut off with "…" instead.
        const area = s.shopId ? shopById.get(s.shopId)?.area : null
        const trainLine = s.train ? `<span class="itl-train-line" role="button" title="Edit the train">${esc(trainSummary(s.train))}</span>` : ''
        el.innerHTML = `
          <span class="itl-first"><span class="itl-name">${esc(r.name)}</span><span class="itl-rest"><span class="itl-sep"> · </span><span class="itl-time">${esc(timeText)}</span>${
            area ? `<span class="itl-sep"> · </span><span class="itl-area">📍 ${esc(area)}</span>` : ''}</span></span>
          ${badges ? `<span class="itl-badges">${badges}</span>` : ''}
          ${actions}
          ${trainLine}
          ${leaveBy}
          ${s.hours ? `<span class="itl-hours">${esc(s.hours)}</span>` : ''}
          ${hoursWarning?.note ? `<span class="itl-hours-note">${esc(hoursWarning.message)}</span>` : ''}`
        grid.appendChild(el)
      })

      // The base: where the day starts and ends — the same base and travel as the list
      // (itinerary-schedule.ts: the first leg from the base, returnLeg back to it).
      const flightLatest = flight && flight.date === day.day ? latestEndForFlight(flight) : null
      if (day.stops.length) {
        const startEl = document.createElement('div')
        startEl.className = 'itl-base itl-base-start'
        startEl.style.top = `${offsetFor(baseStart, range, px)}px`
        startEl.textContent = `🏠 Start: base · ${formatClock(baseStart)}`
        grid.appendChild(startEl)
        const endEl = document.createElement('div')
        // On the flight day, back at the base after the time to leave for the airport is a problem.
        const late = flightLatest != null && sched.end > flightLatest
        endEl.className = 'itl-base itl-base-end' + (late ? ' itl-base-late' : '')
        endEl.style.top = `${offsetFor(sched.end, range, px)}px`
        endEl.dataset.minutes = String(sched.end)
        endEl.textContent = `🏠 Back at base ~${formatClock(sched.end)}` + (late ? ` — ⚠️ after ${formatClock(flightLatest!)}, when you must leave for ${flight!.airport}` : '')
          + (lateTrains.has(day.stops.length) ? ` — 🚆 ${LAST_TRAIN_MESSAGE}` : '')
        if (lateTrains.has(day.stops.length)) endEl.classList.add('itl-base-late')
        grid.appendChild(endEl)
      }

      // The flight home: the latest the day's last stop can end (lib/itinerary-review-helpers.ts).
      if (flight && flight.date === day.day) {
        const latest = latestEndForFlight(flight)
        const line = document.createElement('div')
        line.className = 'itl-flight'
        line.style.top = `${offsetFor(latest, range, px)}px`
        line.textContent = `✈️ Leave for ${flight.airport} by ${formatClock(latest)} (${flight.line.replace('✈️ ', '')})`
        grid.appendChild(line)
      }

      const now = document.createElement('div')
      now.className = 'itl-now'
      now.hidden = true
      grid.appendChild(now)
      dayEl.appendChild(grid)
      // Room at the end so the last hour scrolls fully into view above the fixed bottom nav on
      // mobile: the nav's own height (0 where it's hidden, on wider screens) plus the safe area.
      const end = document.createElement('div')
      end.className = 'itl-end'
      const nav = document.querySelector('.bottom-nav') as HTMLElement | null
      end.style.setProperty('--itl-nav-h', `${nav ? nav.offsetHeight : 0}px`)
      dayEl.appendChild(end)
      updateNow()
    }

    // The red "now" line: Tokyo time (lib/trip-dates.ts tokyoNow), whatever the phone's timezone;
    // shown only on today's date in Tokyo, moved just after each minute starts.
    function updateNow() {
      const line = dayEl.querySelector('.itl-now') as HTMLElement | null
      const grid = dayEl.querySelector('.itl-grid') as HTMLElement | null
      if (!line || !grid) return
      const t = nowTokyo()
      const start = Number(grid.dataset.start)
      const top = (t.minutes - start) * Number(grid.dataset.px)
      const show = t.date === currentDay && top >= 0 && top <= grid.offsetHeight
      line.hidden = !show
      if (show) { line.style.top = `${Math.round(top)}px`; line.dataset.minutes = String(t.minutes) }
    }
    function tickEveryMinute() {
      setTimeout(() => { updateNow(); tickEveryMinute() }, 60000 - (Date.now() % 60000) + 50)
    }
    tickEveryMinute()

    // --- The day warning (itinerary-plan.ts dayWarningFor) ---------------------------------------
    // "⚠️ The trip back to the base leaves at 00:20. Trains may not run." / "⚠️ 2 stops are
    // closed at the planned time." and the stops involved, each with "Move to…" every other Tokyo
    // day and when it ends now — so they can go to a day with room. Moving saves like every other
    // edit here.
    const lateEl = document.querySelector('#itl-late') as HTMLElement
    function renderLateDay(day: PlanDay, sched: ReturnType<typeof computeDayTimes>['sched']) {
      const late = dayWarningFor(day, sched, shopById)
      lateEl.hidden = !late
      if (!late) { lateEl.replaceChildren(); return }
      const others = state.filter((d) => d !== day && days.includes(d.day)).map((d) => {
        const ends = d.stops.length ? `ends ${formatClock(computeDayTimes(d, base, shopById).baseEnd)}` : 'no stops yet'
        return `<option value="${esc(d.day)}">${esc(formatDayShortEn(d.day))}, ${ends}</option>`
      }).join('')
      lateEl.innerHTML = dayWarningMessages(late).map((m) => `<p class="itl-late-msg">⚠️ ${esc(m)}</p>`).join('') + (late.involved.length ? `<ul class="itl-late-list">${late.involved.map((i) => `
        <li class="itl-late-item" data-index="${i}"><span class="itl-late-name">${esc(resolveStop(day.stops[i], shopById).name)} · ${formatClock(sched.stops[i].start)}</span>
          <select class="itl-late-move" data-index="${i}" aria-label="Move to another day"><option value="">Move to…</option>${others}</select></li>`).join('')}</ul>` : '')
    }
    lateEl.addEventListener('change', (e) => {
      const sel = (e.target as HTMLElement).closest('.itl-late-move') as HTMLSelectElement | null
      if (!sel || !sel.value) return
      const day = currentDayPlan()
      const to = state.find((d) => d.day === sel.value)
      if (!to) return
      moveStopToDay(day, Number(sel.dataset.index), to)
      checkMarks = {}
      closeSheet()
      saveState(); render()
    })

    // --- "⏰ Reminders for this day" ---------------------------------------------------------------
    // Every leave-by time on the day, all checked; "Add to calendar" downloads ONE .ics with the
    // checked ones (the same events as the single "⏰ Reminder", with a UID per day and stop).
    const remPanel = document.querySelector('#itl-reminders') as HTMLElement
    const remList = document.querySelector('#itl-rem-list') as HTMLUListElement
    const remAdd = document.querySelector('#itl-rem-add') as HTMLAnchorElement
    let remItems: ReturnType<typeof dayReminders> = []
    function updateRemAdd() {
      const checked = [...remList.querySelectorAll<HTMLInputElement>('.itl-rem-check')].filter((c) => c.checked).map((c) => remItems[Number(c.dataset.index)].reminder)
      remAdd.href = checked.length ? remindersHref(checked) : '#'
      remAdd.setAttribute('aria-disabled', checked.length ? 'false' : 'true')
      remAdd.classList.toggle('itl-rem-off', !checked.length)
    }
    function openReminders() {
      const day = currentDayPlan()
      remItems = dayReminders(day, computeDayTimes(day, base, shopById).sched, shopById)
      remList.innerHTML = remItems.map((r, i) => `<li><label class="itl-rem-item"><input type="checkbox" class="itl-rem-check" data-index="${i}" checked /> <span>${esc(r.title)}</span></label></li>`).join('')
      ;(document.querySelector('#itl-rem-empty') as HTMLElement).hidden = remItems.length > 0
      remAdd.download = `leave-reminders-${day.day}.ics`
      updateRemAdd()
      remPanel.hidden = false
      remPanel.scrollIntoView({ block: 'nearest' })
    }
    document.querySelector('#itl-rem-btn')!.addEventListener('click', () => { if (remPanel.hidden) openReminders(); else remPanel.hidden = true })
    document.querySelector('#itl-rem-close')!.addEventListener('click', () => { remPanel.hidden = true })
    remList.addEventListener('change', updateRemAdd)
    const setAll = (on: boolean) => { remList.querySelectorAll<HTMLInputElement>('.itl-rem-check').forEach((c) => { c.checked = on }); updateRemAdd() }
    document.querySelector('#itl-rem-all')!.addEventListener('click', () => setAll(true))
    document.querySelector('#itl-rem-none')!.addEventListener('click', () => setAll(false))
    remAdd.addEventListener('click', (e) => { if (remAdd.getAttribute('aria-disabled') === 'true') e.preventDefault() })

    // --- The day toolbar: start time, Check day, Suggest route, the day's route ----------------
    const startInput = document.querySelector('#itl-start') as HTMLInputElement
    const checkBtn = document.querySelector('#itl-check-btn') as HTMLButtonElement
    const routeBtn = document.querySelector('#itl-route-btn') as HTMLButtonElement
    const dayRouteEl = document.querySelector('#itl-dayroute') as HTMLElement
    const checkPanel = document.querySelector('#itl-check-results') as HTMLElement
    const routePanel = document.querySelector('#itl-route-results') as HTMLElement
    const mapSection = document.querySelector('#itl-map-section') as HTMLDetailsElement
    const mapEl = document.querySelector('#itl-map') as HTMLElement
    let mapInstance: any = null
    const currentDayPlan = () => state.find((d) => d.day === currentDay)!
    // "↺ Reset day": back to the planned times (shown once the day has actual times).
    const resetDayBtn = document.querySelector('#itl-reset-day') as HTMLButtonElement
    resetDayBtn.addEventListener('click', () => {
      const day = currentDayPlan()
      if (!confirm(`Reset the actual times for ${day.date}? The planned times are used again.`)) return
      clearActualTimes(day)
      checkMarks = {}
      saveState(); render()
    })

    // "🗺️ Route for the day": Google Maps through the stops in order, base first and last
    // (itinerary-plan.ts dayRouteUrls — the list's own links; more than 10 points come in parts).
    function renderDayBar(day: PlanDay) {
      startInput.value = day.startTime
      const urls = dayRouteUrls(day.stops.map((s) => resolveStop(s, shopById)), base)
      dayRouteEl.innerHTML = urls
        .map((u, i) => `<a class="itl-dayroute-link" href="${esc(u)}" target="_blank" rel="noopener">🗺️ ${urls.length > 1 ? `Route part ${i + 1}` : 'Route for the day'}</a>`)
        .join('')
      if (mapSection.open) drawMap(day)
      resetDayBtn.hidden = !hasActualTimes(day)
    }

    // The map (closed by default): the same as the list's (itinerary-ui.ts drawDayMap).
    function drawMap(day: PlanDay) {
      if (mapInstance) { try { mapInstance.remove() } catch (e) {} mapInstance = null }
      loadLeaflet().then((ok) => {
        if (!ok || !mapSection.open || currentDayPlan() !== day) return
        if (mapInstance) { try { mapInstance.remove() } catch (e) {} }
        mapInstance = drawDayMap(mapEl, day, base, shopById)
      })
    }
    mapSection.addEventListener('toggle', () => { if (mapSection.open) drawMap(currentDayPlan()) })

    startInput.addEventListener('change', () => {
      currentDayPlan().startTime = startInput.value || DEFAULT_START
      checkMarks = {}
      saveState(); render()
    })

    // "🔍 Check day": the same request and results as the list (itinerary-ui.ts runCheckDay);
    // a stop's item also marks its block, and tapping the item scrolls to it.
    function scrollToBlock(i: number) {
      const block = dayEl.querySelector(`.itl-block[data-index="${i}"]`) as HTMLElement | null
      if (!block) return
      block.scrollIntoView({ behavior: 'smooth', block: 'center' })
      block.classList.add('itl-flash')
      setTimeout(() => block.classList.remove('itl-flash'), 1600)
    }
    checkBtn.addEventListener('click', async () => {
      const day = currentDayPlan()
      const items = await runCheckDay(checkBtn, checkPanel, checkDayRequestBody(day, { base, shopById, flight }), {
        stopName: (i) => (day.stops[i] ? resolveStop(day.stops[i], shopById).name : `Stop ${i + 1}`),
        onStopClick: (i) => scrollToBlock(i),
      })
      checkMarks = {}
      ;(items || []).forEach((it) => {
        if (typeof it.stopIndex !== 'number') return
        if (checkMarks[it.stopIndex] !== 'warning') checkMarks[it.stopIndex] = it.severity === 'warning' ? 'warning' : 'tip'
      })
      render()
    })

    // "🧭 Suggest route": the same optimizer and preview as the list; Apply and Undo save the
    // same way (state -> saveState -> render).
    const undoByDay: Record<string, PlanDay['stops']> = {}
    routeBtn.addEventListener('click', () => {
      const day = currentDayPlan()
      if (!day.stops.length) { renderNoStopsToReorder(routePanel); return }
      const input = optimizerInput(day, { base, shopById })
      const result = optimizeRoute(input.stops, input.startTime, input.start, input.weekday, input.date)
      renderRouteSuggestion(routePanel, result, {
        stopName: (origIdx) => resolveStop(day.stops[origIdx], shopById).name,
        fmt: formatClock,
        onApply: () => {
          undoByDay[day.day] = day.stops.slice()
          day.stops = result.order.map((i) => day.stops[i])
          checkMarks = {}
          saveState(); render()
          renderRouteApplied(routePanel, () => {
            day.stops = undoByDay[day.day]
            delete undoByDay[day.day]
            checkMarks = {}
            saveState(); render()
            routePanel.hidden = true
          })
        },
      })
    })

    // --- Tap a travel chip or band: the same travel time editor as the list ------------------
    const travelEditor = document.querySelector('#itl-travel-editor') as HTMLElement
    const travelEdit = document.querySelector('#itl-travel-edit') as HTMLElement
    document.querySelector('#itl-travel-editor-close')!.addEventListener('click', () => { travelEditor.hidden = true })
    function openTravelEditor(idx: number) {
      const day = currentDayPlan()
      if (!day.stops[idx]) return
      const { sched } = computeDayTimes(day, base, shopById)
      const from = idx === 0 ? { name: 'Base', lat: base.lat, lng: base.lng } : resolveStop(day.stops[idx - 1], shopById)
      const to = resolveStop(day.stops[idx], shopById)
      ;(document.querySelector('#itl-travel-editor-title') as HTMLElement).textContent = `${from.name} → ${to.name}`
      travelEdit.innerHTML = travelEditorInnerHtml({ manual: manualTravelFor(day, idx, shopById), placeholder: sched.stops[idx].travelIn.minutes, from, to })
      bindTravelEditor(travelEdit, (minutes) => {
        const s = day.stops[idx]
        if (minutes == null) { delete s.travelMin; delete s.travelFrom }
        else { s.travelMin = minutes; s.travelFrom = legFromKey(day, idx, shopById) }
        travelEditor.hidden = true
        saveState(); render()
      })
      openTrain(day, idx, sched.stops[idx].travelIn, from, to)
      travelEditor.hidden = false
      travelEditor.scrollIntoView({ block: 'nearest' })
    }

    // --- "🚆 Plan train" on a leg (lib/train-plan.ts; scheduled by itinerary-schedule.ts) ---------
    // Google Maps opens the transit route; the train is then entered by hand (or read from a
    // screenshot) and saved on the stop after the leg, like a typed-in travel time. Nothing is
    // saved before "Save train".
    const trainPanel = document.querySelector('#itl-train') as HTMLElement
    const trainForm = document.querySelector('#itl-train-form') as HTMLFormElement
    const trainError = document.querySelector('#itl-tr-error') as HTMLElement
    const transfersEl = document.querySelector('#itl-tr-transfers') as HTMLElement
    const trEl = (id: string) => document.querySelector(`#itl-tr-${id}`) as HTMLInputElement
    let trainLeg: { day: PlanDay; idx: number } | null = null
    function transferRowHtml(x: Partial<TrainTransfer> = {}): string {
      return `<div class="itl-tr-transfer">
        <span class="itl-tr-transfer-head">Transfer <button type="button" class="itl-tr-transfer-remove" aria-label="Remove this transfer">✕</button></span>
        <label>Station <input class="itl-tr-x-station" type="text" maxlength="60" value="${esc(x.station || '')}" /></label>
        <label>Arrives <input class="itl-tr-x-arr" type="time" value="${esc(x.arrival || '')}" /></label>
        <label>Line <input class="itl-tr-x-line" type="text" maxlength="60" value="${esc(x.line || '')}" /></label>
        <label>Departs <input class="itl-tr-x-dep" type="time" value="${esc(x.departure || '')}" /></label>
        <label>Platform <input class="itl-tr-x-platform" type="text" maxlength="60" value="${esc(x.platform || '')}" /></label>
      </div>`
    }
    // Fill the form (from the saved train, or a screenshot reading) and show it.
    function fillTrainForm(t: Partial<TrainPlan>) {
      trEl('line').value = t.line || ''; trEl('train').value = t.train || ''; trEl('from').value = t.fromStation || ''
      trEl('dep').value = t.departure || ''; trEl('platform').value = t.platform || ''; trEl('to').value = t.toStation || ''
      trEl('arr').value = t.arrival || ''; trEl('walk').value = t.walkToStationMin != null ? String(t.walkToStationMin) : ''
      transfersEl.innerHTML = (t.transfers || []).map(transferRowHtml).join('')
      trainError.hidden = true
      trainForm.hidden = false
    }
    function readTrainForm() {
      return {
        line: trEl('line').value, train: trEl('train').value, fromStation: trEl('from').value, departure: trEl('dep').value,
        platform: trEl('platform').value, toStation: trEl('to').value, arrival: trEl('arr').value, walkToStationMin: trEl('walk').value,
        transfers: [...transfersEl.querySelectorAll<HTMLElement>('.itl-tr-transfer')].map((row) => ({
