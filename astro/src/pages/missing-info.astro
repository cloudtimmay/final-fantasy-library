---
import Base from '../layouts/Base.astro'
import { sanity, urlFor } from '../lib/sanity'
import { missingImportantFields, type CollectionType } from '../lib/collection-fields'

const TYPE_LABELS: Record<CollectionType, string> = { album: 'Album', game: 'Game', book: 'Book', figure: 'Merch' }
const TYPE_ROUTES: Record<CollectionType, string> = { album: 'albums', game: 'games', book: 'books', figure: 'merchandise' }
const TYPE_ICONS: Record<CollectionType, string> = { album: '🎵', game: '🎮', book: '📚', figure: '🧸' }

// Union of every field any type's IMPORTANT_FIELDS entry needs, plus the common ones.
const allDocs = await sanity.fetch(`
  *[_type in ["album","game","book","figure"] && !(_id in path("drafts.**"))] {
    _id, _type, title, needsInfo, image, externalImageUrl,
    artist, composer, barcode, catalogNumber, releaseDate,
    platform, year, developer,
    author, publisher, isbn,
    manufacturer, series
  }
`)

// Considered incomplete if it's missing one of its type's important fields OR was manually
// flagged in Studio (`needsInfo`) — the two are independent signals, not one derived from
// the other (see IMPORTANT_FIELDS/missingImportantFields in lib/collection-fields.ts).
const items = allDocs
  .map((d: any) => {
    const missing = missingImportantFields(d._type, d)
    return { ...d, missing, flagged: d.needsInfo === true }
  })
  .filter((d: any) => d.flagged || d.missing.length > 0)
  .sort((a: any, b: any) => (a._type === b._type ? a.title.localeCompare(b.title) : a._type.localeCompare(b._type)))
---
<Base title="Missing info">
  <div class="missing-wrap">
    <h1>Missing info</h1>
    <p class="hint">
      Collection items missing one of their important fields, or manually flagged in Studio.
      Tap one to open it in edit mode and fill it in — "✨ Fill in from web" can suggest values once you're there.
    </p>

    <div class="filters-bar">
      <div class="filter-row">
        <span class="filter-label">Type</span>
        <div class="chip-group" id="type-filter">
          <button class="chip active" data-value="all" type="button">All</button>
          <button class="chip" data-value="album" type="button">Album</button>
          <button class="chip" data-value="game" type="button">Game</button>
          <button class="chip" data-value="book" type="button">Book</button>
          <button class="chip" data-value="figure" type="button">Merch</button>
        </div>
      </div>
      <div class="filter-row">
        <span class="filter-label">Flagged</span>
        <div class="chip-group" id="flag-filter">
          <button class="chip active" data-value="all" type="button">All incomplete</button>
          <button class="chip" data-value="flagged" type="button">Only flagged</button>
        </div>
      </div>
    </div>

    <p class="count" id="missing-count">{items.length} item{items.length === 1 ? '' : 's'}</p>

    {items.length === 0 ? (
      <p class="empty">Nothing missing — your collection is fully filled in! 🎉</p>
    ) : (
      <div class="missing-list" id="missing-list">
        {items.map((item: any) => (
          <a
            class="missing-row"
            href={`/${TYPE_ROUTES[item._type as CollectionType]}/${item._id}?edit=1`}
            data-type={item._type}
            data-flagged={item.flagged ? 'yes' : 'no'}
          >
            {item.image
              ? <img class="missing-thumb" src={urlFor(item.image).height(100).url()} alt={item.title} loading="lazy" />
              : item.externalImageUrl
              ? <img class="missing-thumb" src={item.externalImageUrl} alt={item.title} loading="lazy" />
              : <div class="missing-thumb placeholder">{TYPE_ICONS[item._type as CollectionType]}</div>
            }
            <div class="missing-info">
              <div class="missing-title">{item.title || 'Untitled'}</div>
              <div class="missing-meta">
                <span class="tag type-tag">{TYPE_LABELS[item._type as CollectionType]}</span>
                {item.flagged && <span class="tag flagged-tag">Flagged</span>}
              </div>
              {item.missing.length > 0 && <div class="missing-fields">Missing: {item.missing.join(', ')}</div>}
            </div>
          </a>
        ))}
      </div>
    )}
  </div>

  <style>
    .missing-wrap { max-width: 640px; }
    .hint { font-size: 0.9rem; color: var(--muted); margin: 0.25rem 0 1.25rem; }

    .filters-bar { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1rem; }
    .filter-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .filter-label { font-size: 0.78rem; color: var(--muted); flex-shrink: 0; min-width: 52px; }
    .chip-group { display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .chip {
      background: var(--surface); color: var(--text); border: 1px solid var(--border);
      padding: 0.35rem 0.75rem; border-radius: 999px; font-size: 0.8rem; cursor: pointer;
      line-height: 1.3;
    }
    .chip.active { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }

    .count { font-size: 0.85rem; color: var(--muted); margin: 0 0 1rem; }
    .empty { color: var(--muted); font-size: 0.95rem; }

    .missing-list { display: flex; flex-direction: column; border-top: 1px solid var(--border); }
    .missing-row {
      display: flex; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid var(--border);
      text-decoration: none; color: inherit; align-items: center;
    }
    .missing-row:hover { background: rgba(255,255,255,0.03); }
    .missing-row[hidden] { display: none; }
    .missing-thumb { width: 52px; height: 52px; object-fit: cover; background: var(--border); flex-shrink: 0; border-radius: 4px; }
    .missing-thumb.placeholder { display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    .missing-info { flex: 1; min-width: 0; }
    .missing-title { font-weight: 600; overflow-wrap: anywhere; }
    .missing-meta { display: flex; gap: 0.4rem; margin-top: 0.25rem; }
    .tag { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.72rem; background: var(--border); color: var(--text); }
    .type-tag { text-transform: capitalize; }
    .flagged-tag { background: var(--accent); color: #fff; font-weight: 600; }
    .missing-fields { font-size: 0.8rem; color: var(--muted); margin-top: 0.3rem; overflow-wrap: anywhere; }
  </style>

  <script>
    const typeFilter = document.querySelector('#type-filter')
    const flagFilter = document.querySelector('#flag-filter')
    const countEl = document.querySelector('#missing-count')

    function setActive(container, value) {
      container.querySelectorAll('.chip').forEach((c) => c.classList.toggle('active', c.dataset.value === value))
    }

    function applyFilters() {
      const type = typeFilter.querySelector('.chip.active').dataset.value
      const onlyFlagged = flagFilter.querySelector('.chip.active').dataset.value === 'flagged'
      let visible = 0
      document.querySelectorAll('.missing-row').forEach((row) => {
        const matchesType = type === 'all' || row.dataset.type === type
        const matchesFlag = !onlyFlagged || row.dataset.flagged === 'yes'
        const show = matchesType && matchesFlag
        row.hidden = !show
        if (show) visible++
      })
      if (countEl) countEl.textContent = `${visible} item${visible === 1 ? '' : 's'}`
    }

    typeFilter?.querySelectorAll('.chip').forEach((c) => c.addEventListener('click', () => { setActive(typeFilter, c.dataset.value); applyFilters() }))
    flagFilter?.querySelectorAll('.chip').forEach((c) => c.addEventListener('click', () => { setActive(flagFilter, c.dataset.value); applyFilters() }))
  </script>
</Base>
