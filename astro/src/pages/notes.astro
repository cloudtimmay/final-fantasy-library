---
import Base from '../layouts/Base.astro'
import { sanity } from '../lib/sanity'
import { cdnImage } from '../lib/image-url'
import { foundItems, foundThumbs, foundPricesQuery, foundPurchasesQuery, type FoundPriceDoc, type FoundPurchaseDoc } from '../lib/shop-found'
import { pickDefaultTrip } from '../lib/spending'

const notes = await sanity.fetch(`
  *[_type == "shopNote" && !(_id in path("drafts.**"))] | order(area asc, shopName asc) {
    _id, shopName, placeType, area, openingHours, note, priority, address, latitude, longitude,
    "tripIds": trips[]._ref
  }
`)

const trips = await sanity.fetch(
  `*[_type == "tripSettings"] | order(_createdAt asc) { _id, label, startDate, endDate }`
)
// The trip whose shops come first: the one picked in the itinerary (remembered in this browser,
// read by the script below), else ?trip=, else the ongoing or next upcoming trip (as /itinerary).
const defaultTripId = pickDefaultTrip(trips.map((t: any) => ({ _id: t._id, label: t.label, startDate: t.startDate || undefined, endDate: t.endDate || undefined, childBudgets: [] })))?._id || ''
const tripLabels = Object.fromEntries(trips.map((t: any) => [t._id, t.label || 'Trip']))

// Under each shop: up to 4 thumbnails of what was found there (lib/shop-found.ts — one per
// product, newest first) and "+N" for the rest, linking to the shop page's "Found here".
const [foundPrices, foundPurchases]: [FoundPriceDoc[], FoundPurchaseDoc[]] = await Promise.all([
  sanity.fetch(foundPricesQuery('defined(shop._ref)')),
  sanity.fetch(foundPurchasesQuery('defined(store._ref)')),
])
const byShop = new Map<string, { prices: FoundPriceDoc[]; purchases: FoundPurchaseDoc[] }>()
const entry = (id: string) => byShop.get(id) || (byShop.set(id, { prices: [], purchases: [] }), byShop.get(id)!)
for (const p of foundPrices || []) if (p.shopId) entry(p.shopId).prices.push(p)
for (const p of foundPurchases || []) if (p.shopId) entry(p.shopId).purchases.push(p)
const foundThumbsFor = (id: string) => {
  const e = byShop.get(id)
  return e ? foundThumbs(foundItems(e.prices, e.purchases)) : { thumbs: [], more: 0 }
}

const areas = [...new Set(notes.map((n: any) => n.area).filter(Boolean))].sort()

const TYPE_ICON: Record<string, string> = {
  shop: '🛍️', restaurant: '🍜', sight: '🗼', other: '📌',
}
const TYPE_LABEL: Record<string, string> = {
  shop: 'Shop', restaurant: 'Restaurant', sight: 'Sight', other: 'Other',
}

function isUrl(s: string): boolean {
  return typeof s === 'string' && /^https?:\/\//i.test(s.trim())
}
---
<Base title="Shop Notes">
  <div class="page-header">
    <h1>Shop Notes</h1>
    <span class="count" id="notes-count">{notes.length} places</span>
  </div>

  <p class="hint">Places to check and notes from the trip. Add via <a href="/add-store">Add shop</a>, edit in Studio.</p>

  <div class="notes-search">
    <input id="search-input" type="search" placeholder="Search shops, notes, areas…" autocomplete="off" />
    <button id="search-clear" class="search-clear" type="button" hidden>✕</button>
  </div>

  <div class="notes-tools">
    {trips.length > 0 && (
      <select id="trip-filter">
        <option value="">All trips</option>
        {trips.map((t: any) => <option value={t._id}>{t.label || 'Trip'}</option>)}
      </select>
    )}
    <select id="type-filter">
      <option value="">All types</option>
      <option value="shop">🛍️ Shops</option>
      <option value="restaurant">🍜 Restaurants</option>
      <option value="sight">🗼 Sights</option>
      <option value="other">📌 Other</option>
    </select>
    <select id="area-filter">
      <option value="">All areas</option>
      {areas.map((a: any) => <option value={a}>{a}</option>)}
    </select>
    <select id="priority-filter">
      <option value="">All</option>
      <option value="must">Must visit</option>
      <option value="maybe">Worth a look</option>
      <option value="visited">Visited</option>
    </select>
  </div>

  <p id="notes-trip-first" class="hint" hidden></p>
  <div class="notes-list" id="notes-list" data-first-trip={defaultTripId} data-trip-labels={JSON.stringify(tripLabels)}>
    {notes.map((n: any) => {
      const hasCoords = typeof n.latitude === 'number' && typeof n.longitude === 'number'
      const addressIsUrl = isUrl(n.address)
      const searchQuery = [n.shopName, addressIsUrl ? '' : n.address, n.area, 'Japan'].filter(Boolean).join(' ')
      const hasQuery = !!(n.shopName || (!addressIsUrl && n.address))

      const mapHref = hasCoords
        ? `https://www.google.com/maps?q=${n.latitude},${n.longitude}`
        : addressIsUrl
        ? n.address
        : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(searchQuery)}`

      const embedSrc = hasCoords
        ? `https://maps.google.com/maps?q=${n.latitude},${n.longitude}&z=16&output=embed`
        : hasQuery
        ? `https://maps.google.com/maps?q=${encodeURIComponent(searchQuery)}&z=16&output=embed`
        : ''

      const found = foundThumbsFor(n._id)
      const tripAttr = (n.tripIds || []).join(' ')
      // Everything searchable, lowercased, in one attribute.
      const haystack = [n.shopName, n.note, n.area, n.openingHours, addressIsUrl ? '' : n.address]
        .filter(Boolean).join(' ').toLowerCase()

      return (
        <div class="note-card" data-area={n.area || ''} data-priority={n.priority || ''} data-type={n.placeType || ''} data-trips={tripAttr} data-search={haystack}>
          <div class="note-head">
            {n.placeType && <span class="type-icon" title={TYPE_LABEL[n.placeType] || n.placeType}>{TYPE_ICON[n.placeType] || '📌'}</span>}
            <span class="note-name">{n.shopName}</span>
            {n.priority === 'must' && <span class="tag must">Must visit</span>}
            {n.priority === 'maybe' && <span class="tag maybe">Worth a look</span>}
            {n.priority === 'visited' && <span class="tag visited">Visited</span>}
          </div>
          {n.area && <div class="note-area">📍 {n.area}</div>}
          {n.openingHours && <div class="note-hours">🕐 {n.openingHours}</div>}
          {n.note && <div class="note-body">{n.note}</div>}
          {n.address && !addressIsUrl && <div class="note-address">{n.address}</div>}
          {found.thumbs.length > 0 && (
            <a class="note-found" href={`/edit-store?id=${n._id}#found-here`} aria-label={`Found here: ${found.thumbs.length + found.more} item${found.thumbs.length + found.more === 1 ? '' : 's'}`}>
              {found.thumbs.map((t) => t.imageUrl
                ? <img class="note-found-img" src={cdnImage(t.imageUrl, 96)} alt={t.name} title={t.name} width="44" height="44" loading="lazy" />
                : <span class="note-found-img note-found-none" title={t.name}>📦</span>)}
              {found.more > 0 && <span class="note-found-more">+{found.more}</span>}
            </a>
          )}

          {embedSrc && (
            <div class="note-map">
              <iframe
                src={embedSrc}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title={`Map of ${n.shopName}`}
              ></iframe>
              {!hasCoords && <div class="map-approx">Approximate — from name</div>}
            </div>
          )}

         <div class="note-actions">
            <a class="map-btn" href={mapHref} target="_blank" rel="noopener">
              🗺️ Open in Maps{hasCoords && <span class="pinned"> · pinned</span>}
            </a>
            <a class="edit-btn" href={`/edit-store?id=${n._id}`}>✏️ Edit</a>
          </div>
        </div>
      )
    })}
  </div>

  <p id="notes-empty" class="notes-empty" hidden>No places match these filters.</p>

  <style>
    .note-found { display: flex; align-items: center; gap: 0.35rem; margin: 0.5rem 0; text-decoration: none; color: var(--muted); }
    .note-found-img { width: 44px; height: 44px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border); background: var(--bg); flex-shrink: 0; }
    .note-found-none { display: flex; align-items: center; justify-content: center; font-size: 1.1rem; box-sizing: border-box; }
    .note-found-more { font-size: 0.85rem; font-weight: 600; padding: 0 0.3rem; }
    .note-found:hover .note-found-more { color: var(--accent); }
    .hint { font-size: 0.9rem; color: var(--muted); margin: 0.25rem 0 1.25rem; }
    .hint a { color: var(--accent); }

    .notes-search { position: relative; margin-bottom: 0.75rem; max-width: 100%; }
    .notes-search input {
      width: 100%; background: var(--surface); color: var(--text);
      border: 1px solid var(--border); padding: 0.75rem 2.4rem 0.75rem 0.85rem;
      border-radius: 8px; font-size: 1rem; box-sizing: border-box;
    }
    .notes-search input:focus { outline: none; border-color: var(--accent); }
    .search-clear {
      position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%);
      background: none; border: none; color: var(--muted); font-size: 1rem;
      cursor: pointer; padding: 0.3rem 0.4rem; line-height: 1;
    }
    .search-clear:hover { color: var(--text); }

    .notes-tools { display: flex; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .notes-tools select {
      background: var(--surface); color: var(--text); border: 1px solid var(--border);
      padding: 0.6rem 0.75rem; border-radius: 6px; max-width: 100%;
    }

    .notes-list { display: flex; flex-direction: column; gap: 0.75rem; max-width: 100%; }
    .note-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
      padding: 1rem; max-width: 100%; box-sizing: border-box; overflow: hidden;
    }
    .note-head { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.4rem; }
    .type-icon { font-size: 1.1rem; line-height: 1; }
    .note-name { font-weight: 700; font-size: 1.05rem; overflow-wrap: anywhere; }
    .note-area { font-size: 0.85rem; color: var(--muted); margin-bottom: 0.5rem; }
    .note-hours { font-size: 0.85rem; color: var(--accent); margin-bottom: 0.5rem; overflow-wrap: anywhere; }
    .note-body { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 0.95rem; margin-bottom: 0.5rem; }
    .note-address { font-size: 0.85rem; color: var(--muted); margin-bottom: 0.6rem; overflow-wrap: anywhere; }
    .tag { padding: 0.25rem 0.55rem; border-radius: 6px; font-size: 0.75rem; font-weight: 700; }
    .tag.must { background: #e74c3c; color: #fff; }
    .tag.maybe { background: #f39c12; color: #2a1a04; }
    .tag.visited { background: #2ecc71; color: #06281a; }

    .note-map {
      margin: 0.5rem 0 0.8rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      background: var(--bg);
      max-width: 100%;
    }
    .note-map iframe {
      display: block;
      width: 100%;
      max-width: 100%;
      height: 200px;
      border: 0;
    }
    .map-approx {
      font-size: 0.72rem;
      color: var(--muted);
      padding: 0.35rem 0.6rem;
      border-top: 1px solid var(--border);
      font-family: 'IBM Plex Mono', monospace;
      letter-spacing: 0.04em;
    }

    .map-btn {
      display: inline-block; background: var(--bg); color: var(--text);
      border: 1px solid var(--accent); padding: 0.45rem 0.8rem; border-radius: 6px;
      text-decoration: none; font-size: 0.85rem;
    }
    .map-btn:hover { background: rgba(255,255,255,0.04); }
    .pinned { color: var(--accent); font-weight: 600; }
    .note-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .edit-btn {
      display: inline-block; background: var(--bg); color: var(--text);
      border: 1px solid var(--border); padding: 0.45rem 0.8rem; border-radius: 6px;
      text-decoration: none; font-size: 0.85rem;
    }
    .edit-btn:hover { border-color: var(--accent); }
    .notes-empty { color: var(--muted); font-size: 0.9rem; padding: 1rem 0; }
  </style>

  <script>
    const searchInput = document.querySelector('#search-input')
    const searchClear = document.querySelector('#search-clear')
    const tripFilter = document.querySelector('#trip-filter')
    const typeFilter = document.querySelector('#type-filter')
    const areaFilter = document.querySelector('#area-filter')
    const priorityFilter = document.querySelector('#priority-filter')
    const countEl = document.querySelector('#notes-count')
    const emptyMsg = document.querySelector('#notes-empty')

    // The selected trip's shops first, then the rest, each in their own order (never filtered —
    // the trip filter does that). Its shops are the ones ticked on the shop page (shopNote.trips).
    const list = document.querySelector('#notes-list') as HTMLElement | null
    if (list) {
      let labels: Record<string, string> = {}
      try { labels = JSON.parse(list.dataset.tripLabels || '{}') } catch (e) {}
      let remembered: string | null = null
      try { remembered = localStorage.getItem('ff-itinerary-trip') } catch (e) {}
      const fromUrl = new URL(window.location.href).searchParams.get('trip')
      const tripId = [fromUrl, remembered, list.dataset.firstTrip].find((id) => !!id && id in labels) || ''
      if (tripId) {
        const cards = [...list.querySelectorAll<HTMLElement>('.note-card')]
        const on = cards.filter((c) => (c.dataset.trips || '').split(' ').includes(tripId))
        if (on.length) {
          // CSS order (the list is a flex column), not moving the cards: each card's map is an
          // iframe, and moving an iframe in the page reloads it — every map at once.
          for (const c of on) c.style.order = '-1'
          const note = document.querySelector('#notes-trip-first') as HTMLElement
          note.textContent = `🧳 ${labels[tripId]}: its shops first (${on.length}), then the rest.`
          note.hidden = false
        }
      }
    }

    function update() {
      const q = searchInput.value.trim().toLowerCase()
      const trip = tripFilter ? tripFilter.value : ''
      const type = typeFilter.value
      const area = areaFilter.value
      const priority = priorityFilter.value
      let visible = 0

      searchClear.hidden = q === ''

      document.querySelectorAll('.note-card').forEach((card) => {
        const cardTrips = (card.dataset.trips || '').split(' ').filter(Boolean)
        const matchesSearch = !q || (card.dataset.search || '').includes(q)
        const matchesTrip = !trip || cardTrips.includes(trip)
        const matchesType = !type || card.dataset.type === type
        const matchesArea = !area || card.dataset.area === area
        const matchesPriority = !priority || card.dataset.priority === priority
        const show = matchesSearch && matchesTrip && matchesType && matchesArea && matchesPriority
        card.style.display = show ? '' : 'none'
        if (show) visible++
      })

      if (countEl) countEl.textContent = `${visible} place${visible === 1 ? '' : 's'}`
      if (emptyMsg) emptyMsg.hidden = visible !== 0
    }

    searchInput.addEventListener('input', update)
    searchClear.addEventListener('click', () => {
      searchInput.value = ''
      searchInput.focus()
      update()
    })
    if (tripFilter) tripFilter.addEventListener('change', update)
    typeFilter.addEventListener('change', update)
    areaFilter.addEventListener('change', update)
    priorityFilter.addEventListener('change', update)
    update()
  </script>
</Base>