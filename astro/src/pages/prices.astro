---
import Base from '../layouts/Base.astro'
import { fetchProducts } from '../lib/price-products'

const products = await fetchProducts()

const CATEGORY_LABELS: Record<string, string> = {
  album: 'Album',
  game: 'Game',
  book: 'Book',
  figure: 'Merchandise',
  other: 'Other',
}
const CONDITION_LABELS: Record<string, string> = {
  new: 'New',
  used: 'Used',
  used_complete: 'Used, complete (box/obi)',
}

function lowestJpy(prices: { price: number; currency: string }[]): number | null {
  const jpy = prices.filter((p) => p.currency === 'JPY').map((p) => p.price)
  return jpy.length ? Math.min(...jpy) : null
}

function formatMoney(price: number, currency: string): string {
  return `${price.toLocaleString('en-US')} ${currency}`
}

function formatDate(iso: string | undefined): string {
  if (!iso) return ''
  const d = new Date(iso)
  if (isNaN(d.getTime())) return ''
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
}
---
<Base title="Prices">
  <div class="prices-wrap">
    <h1>Prices</h1>
    <p class="hint">Everything you've logged. Tap a product to see its full price history.</p>

    <input id="p-search" class="search-input" type="search" placeholder="Search name, Japanese name or JAN…" autocomplete="off" />

    {products.length === 0 ? (
      <p class="empty">No prices logged yet. <a href="/add-price">Add the first one →</a></p>
    ) : (
      <ul class="price-list">
        {products.map((p) => {
          const low = lowestJpy(p.prices)
          const searchHay = `${p.productName} ${p.productNameJp || ''} ${p.jan || ''}`.toLowerCase()
          return (
            <li class="price-row" data-search={searchHay}>
              <details>
                <summary>
                  {p.image ? (
                    <img class="thumb" src={`${p.image.url}?w=100`} alt={p.productName} />
                  ) : (
                    <div class="thumb thumb-placeholder">🏷️</div>
                  )}
                  <div class="summary-info">
                    <div class="summary-name">{p.productName}</div>
                    {p.productNameJp && <div class="summary-jp">{p.productNameJp}</div>}
                    <div class="summary-sub">
                      {p.category && <span class="cat-badge">{CATEGORY_LABELS[p.category] || p.category}</span>}
                      <span class="count-badge">{p.prices.length} price{p.prices.length === 1 ? '' : 's'}</span>
                      {low != null && <span class="low-badge">from {formatMoney(low, 'JPY')}</span>}
                    </div>
                  </div>
                </summary>

                <ul class="history-list">
                  {p.prices.map((price) => (
                    <li class="history-row">
                      <span class="history-source">{price.source}</span>
                      <span class="history-price">{formatMoney(price.price, price.currency)}</span>
                      {price.condition && <span class="history-condition">{CONDITION_LABELS[price.condition] || price.condition}</span>}
                      {price.status === 'bought' && <span class="history-bought">✅</span>}
                      <span class="history-date">{formatDate(price.seenAt)}</span>
                    </li>
                  ))}
                </ul>

                <div class="product-actions">
                  <a class="add-price-link" href={`/add-price?product=${encodeURIComponent(p.key)}`}>+ Add price</a>
                  <a class="edit-product-link" href={`/edit-product?product=${encodeURIComponent(p.key)}`}>✏️ Edit product</a>
                </div>
              </details>
            </li>
          )
        })}
      </ul>
    )}
  </div>

  <script>
    const searchInput = document.querySelector('#p-search')
    const rows = Array.from(document.querySelectorAll('.price-row'))

    function applySearch() {
      const q = searchInput.value.trim().toLowerCase()
      rows.forEach((row) => {
        const hay = row.getAttribute('data-search') || ''
        row.hidden = q !== '' && !hay.includes(q)
      })
    }
    searchInput.addEventListener('input', applySearch)
  </script>

  <style>
    .prices-wrap { max-width: 640px; }
    .hint { font-size: 0.9rem; color: var(--muted); margin: 0.25rem 0 1.25rem; }
    .search-input {
      width: 100%; background: var(--surface); color: var(--text);
      border: 1px solid var(--border); padding: 0.8rem 0.9rem; border-radius: 8px;
      font-size: 1rem; box-sizing: border-box; margin-bottom: 1.25rem;
    }
    .search-input:focus { outline: none; border-color: var(--accent); }

    .empty { color: var(--muted); font-size: 0.95rem; padding: 1rem 0; }
    .empty a { color: var(--accent); }

    .price-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
    .price-row[hidden] { display: none; }

    details {
      background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
      overflow: hidden;
    }
    details[open] { border-color: var(--accent); }

    summary {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0.9rem; cursor: pointer; list-style: none;
    }
    summary::-webkit-details-marker { display: none; }

    .thumb {
      width: 52px; height: 52px; object-fit: cover; border-radius: 6px;
      background: var(--bg); flex-shrink: 0;
    }
    .thumb-placeholder {
      display: flex; align-items: center; justify-content: center; font-size: 1.4rem;
      border: 1px solid var(--border);
    }

    .summary-info { flex: 1; min-width: 0; }
    .summary-name { font-weight: 600; font-size: 1rem; overflow-wrap: anywhere; }
    .summary-jp { font-size: 0.85rem; color: var(--muted); margin-top: 0.1rem; }
    .summary-sub { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.4rem; }
    .cat-badge, .count-badge, .low-badge {
      font-size: 0.72rem; font-weight: 600; padding: 0.2rem 0.5rem; border-radius: 4px;
      font-family: 'IBM Plex Mono', monospace; white-space: nowrap;
    }
    .cat-badge { background: var(--border); color: var(--text); }
    .count-badge { background: rgba(244,162,76,0.15); color: var(--accent); }
    .low-badge { background: rgba(46,204,113,0.15); color: #2ecc71; }

    .history-list {
      list-style: none; margin: 0; padding: 0 0.9rem 0.9rem;
      display: flex; flex-direction: column; gap: 0.4rem;
    }
    .history-row {
      display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;
      font-size: 0.85rem; padding: 0.55rem 0.7rem;
      background: var(--bg); border: 1px solid var(--border); border-radius: 6px;
    }
    .history-source { flex: 1; min-width: 80px; color: var(--text); }
    .history-price { font-weight: 600; color: var(--accent); white-space: nowrap; }
    .history-condition { font-size: 0.78rem; color: var(--muted); white-space: nowrap; }
    .history-bought { white-space: nowrap; }
    .history-date { font-size: 0.78rem; color: var(--muted); white-space: nowrap; margin-left: auto; }

    .product-actions { display: flex; gap: 0.5rem; margin: 0 0.9rem 0.9rem; flex-wrap: wrap; }
    .add-price-link, .edit-product-link {
      flex: 1; min-width: 130px; text-align: center;
      padding: 0.6rem; border-radius: 8px; text-decoration: none; font-size: 0.9rem; font-weight: 600;
    }
    .add-price-link { background: var(--bg); color: var(--accent); border: 1px solid var(--accent); }
    .add-price-link:hover { background: rgba(244,162,76,0.1); }
    .edit-product-link { background: var(--bg); color: var(--text); border: 1px solid var(--border); }
    .edit-product-link:hover { border-color: var(--accent); }
  </style>
</Base>
