---
import Base from '../layouts/Base.astro'
import PriceProductRow from '../components/PriceProductRow.astro'
import { fetchProducts, type Product, type ProductPrice } from '../lib/price-products'
import { PEOPLE_LIST } from '../lib/price-entry-fields'

const products = await fetchProducts()

// One section per person who has at least one matching price, plus "No buyer" last (if
// any price has none) — a buyer value outside PEOPLE_LIST (stale/legacy data) also counts
// as "No buyer" rather than silently vanishing. Built once server-side so Group by Person
// is real markup, not something assembled by JS.
type PersonSection = { key: string; label: string; items: { product: Product; prices: ProductPrice[] }[] }

function buildPersonSections(allProducts: Product[]): PersonSection[] {
  const sections = new Map<string, PersonSection>(PEOPLE_LIST.map((name) => [name, { key: name, label: name, items: [] }]))
  const none: PersonSection = { key: '__none__', label: 'No buyer', items: [] }

  for (const product of allProducts) {
    const byKey = new Map<string, ProductPrice[]>()
    for (const price of product.prices) {
      const key = price.buyer && sections.has(price.buyer) ? price.buyer : '__none__'
      const list = byKey.get(key) ?? []
      list.push(price)
      byKey.set(key, list)
    }
    for (const [key, prices] of byKey) {
      if (key === '__none__') none.items.push({ product, prices })
      else sections.get(key)!.items.push({ product, prices })
    }
  }

  return [...[...sections.values()].filter((s) => s.items.length > 0), ...(none.items.length > 0 ? [none] : [])]
}

const personSections = buildPersonSections(products)

// Lightweight projection for the client-side scan/identify matching below (findProductMatches
// runs in the browser, against whatever was just scanned or identified) — just enough to
// find the best match and know which product's <details> to open, not the full price history.
const matchableProducts = products.map((p) => ({ key: p.key, productName: p.productName, productNameJp: p.productNameJp, jan: p.jan }))
---
<Base title="Prices">
  <div class="prices-wrap">
    <div class="nav-row">
      <a href="/add-menu" id="prices-back" class="page-nav-link">← Back</a>
      <a href="/add-price" class="page-nav-link page-nav-link-add">➕ Add price</a>
    </div>

    <h1>Prices</h1>
    <p class="hint">Everything you've logged. Tap a product to see its full price history.</p>

    <div class="filters-bar">
      <input id="p-search" class="search-input" type="search" placeholder="Search name, Japanese name or JAN…" autocomplete="off" />

      <div class="scan-row">
        <button id="p-scan-btn" class="scan-btn" type="button">📷 Scan barcode</button>
        <label class="upload-btn">
          📷 Identify by photo
          <input id="p-photo-camera" type="file" accept="image/*" capture="environment" hidden />
        </label>
        <label class="upload-btn">
          🖼️ From gallery
          <input id="p-photo-gallery" type="file" accept="image/*" hidden />
        </label>
      </div>
      <div id="p-scan-reader" class="scan-reader" hidden></div>
      <p id="p-scan-msg" class="scan-msg" hidden></p>
      <p id="p-identified-line" class="identified-line" hidden></p>

      <div class="filter-row">
        <span class="filter-label">Person</span>
        <div class="chip-group" id="person-filter">
          <button class="chip active" data-value="all" type="button">All</button>
          {PEOPLE_LIST.map((name) => <button class="chip" data-value={name} type="button">{name}</button>)}
          <button class="chip" data-value="__none__" type="button">No buyer</button>
        </div>
      </div>

      <div class="filter-row">
        <span class="filter-label">Status</span>
        <div class="chip-group" id="status-filter">
          <button class="chip active" data-value="all" type="button">All</button>
          <button class="chip" data-value="considering" type="button">Considering</button>
          <button class="chip" data-value="bought" type="button">Bought</button>
        </div>
      </div>

      <div class="filter-row">
        <span class="filter-label">Group by</span>
        <div class="chip-group" id="group-toggle">
          <button class="chip active" data-value="product" type="button">Product</button>
          <button class="chip" data-value="person" type="button">Person</button>
        </div>
      </div>
    </div>

    {products.length === 0 ? (
      <p class="empty">No prices logged yet. <a href="/add-price">Add the first one →</a></p>
    ) : (
      <>
        <div id="product-group-view" class="group-view">
          <ul class="price-list">
            {products.map((p) => <PriceProductRow product={p} prices={p.prices} />)}
          </ul>
          <p class="empty-filtered" hidden>No prices match these filters.</p>
        </div>

        <div id="person-group-view" class="group-view" hidden>
          {personSections.map((section) => (
            <section class="person-section" data-person={section.key}>
              <h2 class="person-section-title">{section.label}</h2>
              <ul class="price-list">
                {section.items.map(({ product, prices }) => <PriceProductRow product={product} prices={prices} />)}
              </ul>
            </section>
          ))}
          <p class="empty-filtered" hidden>No prices match these filters.</p>
        </div>
      </>
    )}
  </div>

  <script type="application/json" id="price-match-data" set:html={JSON.stringify(matchableProducts)}></script>

  <script is:inline src="/barcode-scanner.js"></script>
  <script is:inline src="/resize-image.js"></script>

  <script>
    import { findProductMatches } from '../lib/product-match'

    const STORAGE_KEY = 'ff-prices-filters'
    const DEFAULTS = { person: 'all', status: 'all', group: 'product' }

    const searchInput = document.querySelector('#p-search')
    const personFilterEl = document.querySelector('#person-filter')
    const statusFilterEl = document.querySelector('#status-filter')
    const groupToggleEl = document.querySelector('#group-toggle')
    const productView = document.querySelector('#product-group-view')
    const personView = document.querySelector('#person-group-view')

    function loadState() {
      const url = new URLSearchParams(window.location.search)
      if (url.has('person') || url.has('status') || url.has('group')) {
        return {
          person: url.get('person') || DEFAULTS.person,
          status: url.get('status') || DEFAULTS.status,
          group: url.get('group') || DEFAULTS.group,
        }
      }
      // Arriving via ?open=<key> (from /add-price, /edit-product, /edit-price) — always
      // show everything unfiltered, so the deep-linked product is never hidden by a
      // filter saved from an earlier session.
      if (url.has('open')) return { ...DEFAULTS }
      try {
        const raw = localStorage.getItem(STORAGE_KEY)
        if (raw) return { ...DEFAULTS, ...JSON.parse(raw) }
      } catch (e) {}
      return { ...DEFAULTS }
    }

    function persistState(state) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)) } catch (e) {}
      try {
        const url = new URL(window.location.href)
        url.searchParams.set('person', state.person)
        url.searchParams.set('status', state.status)
        url.searchParams.set('group', state.group)
        window.history.replaceState(null, '', url.toString())
      } catch (e) {}
    }

    const state = loadState()

    function setActiveChip(container, value) {
      container.querySelectorAll('.chip').forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.value === value)
      })
    }

    function fmtMoney(price, currency) {
      return `${Math.round(price).toLocaleString('en-US')} ${currency}`
    }

    function applyFilters() {
      if (!productView || !personView) return
      const q = searchInput.value.trim().toLowerCase()

      productView.hidden = state.group !== 'product'
      personView.hidden = state.group !== 'person'
      const activeView = state.group === 'person' ? personView : productView
      const inPersonView = activeView === personView

      const sections = inPersonView
        ? Array.from(personView.querySelectorAll('.person-section'))
        : [activeView]

      let anyVisibleOverall = false

      sections.forEach((section) => {
        if (inPersonView && state.person !== 'all') {
          const sectionPerson = section.getAttribute('data-person')
          section.hidden = sectionPerson !== state.person
          if (section.hidden) return
        }

        let anyVisibleInSection = false
        const rows = Array.from(section.querySelectorAll('.price-row'))
        rows.forEach((row) => {
          const hay = row.getAttribute('data-search') || ''
          const searchMatches = q === '' || hay.includes(q)

          const items = Array.from(row.querySelectorAll('.history-item'))
          let visibleCount = 0
          let lowestJpy = null
          items.forEach((item) => {
            // The person filter only needs to narrow individual rows in Product-grouped
            // view — in Person-grouped view the section itself already fixes the buyer,
            // so every row within a shown section already matches.
            const buyer = item.getAttribute('data-buyer') || ''
            const buyerMatches =
              inPersonView || state.person === 'all'
                ? true
                : state.person === '__none__'
                  ? buyer === ''
                  : buyer === state.person
            const statusMatches = state.status === 'all' || item.getAttribute('data-status') === state.status
            const visible = buyerMatches && statusMatches
            item.hidden = !visible
            if (visible) {
              visibleCount++
              if (item.getAttribute('data-currency') === 'JPY') {
                const p = Number(item.getAttribute('data-price'))
                if (!isNaN(p) && (lowestJpy === null || p < lowestJpy)) lowestJpy = p
              }
            }
          })

          const rowVisible = searchMatches && visibleCount > 0
          row.hidden = !rowVisible
          if (rowVisible) {
            anyVisibleInSection = true
            const countBadge = row.querySelector('.count-badge')
            if (countBadge) countBadge.textContent = `${visibleCount} price${visibleCount === 1 ? '' : 's'}`
            const lowBadge = row.querySelector('.low-badge')
            if (lowBadge) {
              if (lowestJpy != null) {
                lowBadge.hidden = false
                lowBadge.textContent = `from ${fmtMoney(lowestJpy, 'JPY')}`
              } else {
                lowBadge.hidden = true
              }
            }
          }
        })

        if (inPersonView) section.hidden = !anyVisibleInSection
        if (anyVisibleInSection) anyVisibleOverall = true
      })

      const emptyEl = activeView.querySelector('.empty-filtered')
      if (emptyEl) emptyEl.hidden = anyVisibleOverall
    }

    function wireChipGroup(container, key) {
      container.querySelectorAll('.chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          const value = btn.dataset.value || DEFAULTS[key]
          state[key] = value
          setActiveChip(container, value)
          persistState(state)
          applyFilters()
        })
      })
    }
    wireChipGroup(personFilterEl, 'person')
    wireChipGroup(statusFilterEl, 'status')
    wireChipGroup(groupToggleEl, 'group')

    setActiveChip(personFilterEl, state.person)
    setActiveChip(statusFilterEl, state.status)
    setActiveChip(groupToggleEl, state.group)
    searchInput.addEventListener('input', applyFilters)
    applyFilters()

    function openProductByKey(key) {
      const target = document.querySelector('details[data-key="' + CSS.escape(key) + '"]')
      if (target) {
        target.open = true
        target.scrollIntoView({ behavior: 'smooth', block: 'start' })
      }
      return !!target
    }

    // Arriving back from /add-price, /edit-product or /edit-price with ?open=<key> —
    // expand that product and bring it into view (filters were reset to show everything
    // above, so the target is guaranteed visible here).
    const openKey = new URLSearchParams(window.location.search).get('open')
    if (openKey) openProductByKey(openKey)

    // --- Barcode scan + "Identify by photo" — same shared findProductMatches() scan.astro
    // uses: exact JAN match first, then name similarity. The match sets the search text
    // (so the existing filter mechanism narrows the list) and opens the best match.
    let matchableProducts = []
    try {
      matchableProducts = JSON.parse(document.querySelector('#price-match-data')?.textContent || '[]')
    } catch (e) {}

    const scanBtn = document.querySelector('#p-scan-btn')
    const scanReader = document.querySelector('#p-scan-reader')
    const scanMsg = document.querySelector('#p-scan-msg')
    const identifiedLine = document.querySelector('#p-identified-line')
    const photoCamera = document.querySelector('#p-photo-camera')
    const photoGallery = document.querySelector('#p-photo-gallery')

    function showScanMsg(text, ok) {
      scanMsg.hidden = false
      scanMsg.textContent = text
      scanMsg.style.color = ok ? 'var(--muted)' : '#e74c3c'
    }

    function showIdentifiedLine(identified) {
      const name = identified.productName || identified.productNameJp || ''
      identifiedLine.hidden = false
      identifiedLine.textContent = `Identified: ${name || '(no name)'}${identified.jan ? ' · JAN ' + identified.jan : ''}`
    }

    function searchAndOpenBestMatch(identified) {
      const matches = findProductMatches(matchableProducts, identified)
      const term = identified.productName || identified.productNameJp || identified.jan || ''
      searchInput.value = term
      applyFilters()
      if (matches.length > 0) {
        openProductByKey(matches[0].product.key)
        showScanMsg(`${matches.length} match${matches.length === 1 ? '' : 'es'} found in your price list.`, true)
      } else if (term) {
        showScanMsg('No match found in your price list for "' + term + '".', false)
      }
    }

    if (scanBtn && window.createBarcodeScanner) {
      const scanner = window.createBarcodeScanner('p-scan-reader')
      scanBtn.addEventListener('click', async () => {
        if (scanner.isRunning()) {
          await scanner.stop()
          scanReader.hidden = true
          scanBtn.textContent = '📷 Scan barcode'
          return
        }
        scanReader.hidden = false
        scanMsg.hidden = true
        try {
          await scanner.start((code) => {
            scanner.stop()
            scanReader.hidden = true
            scanBtn.textContent = '📷 Scan barcode'
            identifiedLine.hidden = true
            searchAndOpenBestMatch({ jan: code })
          })
          scanBtn.textContent = '✕ Close scanner'
        } catch (err) {
          showScanMsg(err && err.message ? err.message : 'Could not access camera.', false)
          scanReader.hidden = true
        }
      })
    }

    function fileToBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader()
        reader.onload = () => {
          const result = String(reader.result || '')
          const commaIdx = result.indexOf(',')
          resolve(commaIdx !== -1 ? result.slice(commaIdx + 1) : result)
        }
        reader.onerror = reject
        reader.readAsDataURL(file)
      })
    }

    async function identifyPhoto(file) {
      if (!file) return
      showScanMsg('Identifying…', true)
      try {
        let forApi = file
        try {
          if (window.resizeImage) forApi = await window.resizeImage(file, 1024, 0.8)
        } catch (e) {}
        const image = await fileToBase64(forApi)
        const res = await fetch('/api/identify-product', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ images: [image] }),
        })
        const data = await res.json().catch(() => null)
        if (!res.ok) {
          showScanMsg((data && data.error) || 'Identification failed.', false)
          return
        }
        const result = data && data.result ? data.result : {}
        if (!result.productName && !result.jan) {
          showScanMsg('Could not identify anything useful in this photo.', false)
          return
        }
        showIdentifiedLine(result)
        searchAndOpenBestMatch(result)
      } catch (e) {
        showScanMsg('Network error.', false)
      }
    }

    if (photoCamera) photoCamera.addEventListener('change', () => { identifyPhoto(photoCamera.files && photoCamera.files[0]); photoCamera.value = '' })
    if (photoGallery) photoGallery.addEventListener('change', () => { identifyPhoto(photoGallery.files && photoGallery.files[0]); photoGallery.value = '' })

    // "← Back" prefers real browser history (so it lands wherever the user actually came
    // from) and only falls back to its href="/add-menu" when there's nothing to go back to.
    // Read before Base.astro's own bottom script (further down the DOM) marks this page as
    // visited, so this reflects whether an EARLIER page set it, not this one.
    let hadPriorPageThisSession = false
    try { hadPriorPageThisSession = !!sessionStorage.getItem('ff-nav-visited') } catch (e) {}

    const backLink = document.querySelector('#prices-back')
    if (backLink) {
      backLink.addEventListener('click', (e) => {
        if (hadPriorPageThisSession) {
          e.preventDefault()
          window.history.back()
        }
      })
    }
  </script>

  <style>
    .prices-wrap { max-width: 640px; }
    .hint { font-size: 0.9rem; color: var(--muted); margin: 0.25rem 0 1.25rem; }

    .nav-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .page-nav-link { color: var(--muted); text-decoration: none; font-size: 0.9rem; }
    .page-nav-link:hover { color: var(--accent); }
    .page-nav-link-add { color: var(--accent); font-weight: 600; }

    .filters-bar { margin-bottom: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; }
    .search-input {
      width: 100%; background: var(--surface); color: var(--text);
      border: 1px solid var(--border); padding: 0.8rem 0.9rem; border-radius: 8px;
      font-size: 1rem; box-sizing: border-box;
    }
    .search-input:focus { outline: none; border-color: var(--accent); }

    .scan-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .scan-btn, .upload-btn {
      flex: 1; min-width: 140px; text-align: center;
      display: inline-block; background: var(--surface); color: var(--text);
      border: 1px solid var(--accent); padding: 0.6rem 0.8rem; border-radius: 8px;
      cursor: pointer; font-size: 0.85rem;
    }
    .scan-btn:hover, .upload-btn:hover { background: rgba(244,162,76,0.08); }
    .scan-reader { width: 100%; max-width: 400px; margin: 0 auto; border-radius: 8px; overflow: hidden; }
    .scan-reader[hidden] { display: none; }
    .scan-msg { font-size: 0.85rem; color: var(--muted); margin: 0; }
    .scan-msg[hidden] { display: none; }
    .identified-line { font-size: 0.85rem; color: var(--text); margin: 0; }
    .identified-line[hidden] { display: none; }

    .filter-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .filter-label { font-size: 0.78rem; color: var(--muted); flex-shrink: 0; min-width: 52px; }
    .chip-group { display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .chip {
      background: var(--surface); color: var(--text); border: 1px solid var(--border);
      padding: 0.35rem 0.75rem; border-radius: 999px; font-size: 0.8rem; cursor: pointer;
      line-height: 1.3;
    }
    .chip.active { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }

    .empty { color: var(--muted); font-size: 0.95rem; padding: 1rem 0; }
    .empty a { color: var(--accent); }
    .empty-filtered { color: var(--muted); font-size: 0.9rem; padding: 1rem 0; }
    .empty-filtered[hidden] { display: none; }

    .group-view[hidden] { display: none; }
    .price-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
    .price-row[hidden] { display: none; }

    .person-section { margin-bottom: 1.5rem; }
    .person-section-title {
      font-size: 0.95rem; font-weight: 700; color: var(--accent); margin: 0 0 0.6rem;
      padding-bottom: 0.4rem; border-bottom: 1px solid var(--border);
    }
    .person-section[hidden] { display: none; }
  </style>
</Base>
