---
import Base from '../layouts/Base.astro'
import { sanity, urlFor } from '../lib/sanity'
import { fetchProducts, fetchOwnedByPerson, fetchCollectionForMatching } from '../lib/price-products'
import { findProductMatches, findOwnersOf, findCollectionMatches } from '../lib/product-match'
import { detailHref } from '../lib/collection-fields'
import { cdnImage } from '../lib/image-url'

const STUDIO_URL = 'https://fflibrary.sanity.studio'

const q = (Astro.url.searchParams.get('q') || '').trim()

// Carried over from a barcode decode or a "📷 Identify by photo" result (see the script
// below) — present on the URL so a price-list match survives the full-page reload that
// submitting the search form causes. Absent on a plain manual search.
const ijan = (Astro.url.searchParams.get('ijan') || '').trim()
const iname = (Astro.url.searchParams.get('iname') || '').trim()
const inamejp = (Astro.url.searchParams.get('inamejp') || '').trim()

const identified = { jan: ijan, productName: iname, productNameJp: inamejp }
const priceMatches = ijan || iname || inamejp ? findProductMatches(await fetchProducts(), identified) : []
const ownerMatches = ijan || iname || inamejp ? findOwnersOf(await fetchOwnedByPerson(), identified) : []

function lowestJpy(prices: { price: number; currency: string }[]): number | null {
  const jpy = prices.filter((p) => p.currency === 'JPY').map((p) => p.price)
  return jpy.length ? Math.min(...jpy) : null
}

const RESULT_FIELDS = `{
  _id, _type, title, status, image, externalImageUrl,
  catalogNumber, barcode, isbn,
  "sub": select(
    _type == "album"  => coalesce(composer, artist),
    _type == "game"   => platform,
    _type == "book"   => author,
    _type == "figure" => manufacturer
  )
}`

// An identified/scanned product is matched against the whole collection in JS (code vs a
// book's isbn or any other item's barcode, then name similarity — see findCollectionMatches())
// rather than only through the GROQ `match` below, which needs every word of the AI's name
// to appear in the stored title ("The Art of Final Fantasy XVI" never found "Art of Final
// Fantasy XVI"). These come first, labelled; the text search's own hits follow.
const collectionMatches = ijan || iname || inamejp ? findCollectionMatches(await fetchCollectionForMatching(), identified) : []
const matchLabels = new Map<string, string>(collectionMatches.map((m) => [m.item._id, m.label]))
let identifiedResults: any[] = []
if (collectionMatches.length) {
  const ids = collectionMatches.map((m) => m.item._id)
  const docs: any[] = await sanity.fetch(`*[_id in $ids]${RESULT_FIELDS}`, { ids })
  identifiedResults = ids.map((id) => docs.find((d) => d._id === id)).filter(Boolean)
}

let results: any[] = []
if (q) {
  const term = `*${q}*`
  results = await sanity.fetch(
    `*[
      _type in ["album","game","book","figure"] &&
      !(_id in path("drafts.**")) &&
      (
        title match $term ||
        catalogNumber match $term ||
        barcode match $term ||
        isbn match $term ||
        artist match $term ||
        composer match $term ||
        author match $term ||
        manufacturer match $term
      )
    ] | order(_type asc, title asc) ${RESULT_FIELDS}`,
    { term }
  )
}
results = [...identifiedResults, ...results.filter((r: any) => !matchLabels.has(r._id))]

// Is any match already owned? Used for the prominent warning banner. No status counts as
// owned, same as the collection pages (many imported items have none).
const ownedMatch = results.find((r: any) => r.status === 'owned' || !r.status)
// Is any match on the wishlist? A friendlier, non-warning callout with a one-tap "Got it"
// (reuses /api/item-status exactly like wishlist.astro's own "Got it" button).
const wishlistMatch = results.find((r: any) => r.status === 'wishlist')
---
<Base title="Scan">
  <div class="scan-wrap">
    <h1>Scan</h1>
    <p class="hint">Search by title, catalog number, barcode or ISBN — or scan the barcode.</p>

    {ownedMatch && (
      <div class="dup-banner">
        ⚠️ <strong>Already in your collection:</strong> “{ownedMatch.title}” is marked as owned.
      </div>
    )}

    {wishlistMatch && (
      <div class="wish-banner">
        <span>⭐ <strong>On your wishlist:</strong> “{wishlistMatch.title}”</span>
        <button id="scan-got-it" class="got-it-btn" type="button" data-id={wishlistMatch._id}>✓ Got it</button>
      </div>
    )}

    <form class="scan-form" method="get" action="/scan">
      <input
        id="scan-input"
        name="q"
        type="search"
        value={q}
        placeholder="Title, catalog no., barcode..."
        autocomplete="off"
      />
      <input id="scan-ijan" name="ijan" type="hidden" value={ijan} />
      <input id="scan-iname" name="iname" type="hidden" value={iname} />
      <input id="scan-inamejp" name="inamejp" type="hidden" value={inamejp} />
      <button type="submit">Search</button>
    </form>

    <button id="scan-toggle" class="scan-cam-btn" type="button">📷 Scan barcode</button>
    <div id="scan-reader" class="scan-reader" hidden></div>
    <p id="scan-msg" class="scan-msg" hidden></p>

    <div class="identify-buttons">
      <label class="upload-btn">
        📷 Identify by photo
        <input id="scan-photo-camera" type="file" accept="image/*" capture="environment" hidden />
      </label>
      <label class="upload-btn">
        🖼️ From gallery
        <input id="scan-photo-gallery" type="file" accept="image/*" hidden />
      </label>
    </div>
    <p id="scan-identify-msg" class="scan-identify-msg" hidden></p>

    <button id="family-register" class="scan-fam-btn" type="button">
      🛍️ Register as family purchase
    </button>

    {(ijan || iname || inamejp) && (
      <p class="identified-line">
        Identified: <strong>{iname || inamejp || '(no name)'}</strong>
        {ijan && ` · JAN ${ijan}`}
      </p>
    )}

    {ownerMatches.length > 0 && (
      <div class="owner-matches">
        {ownerMatches.map(({ person, matchType }) => (
          <p class="owner-match-line">
            <strong>{person}</strong> already has this
            {matchType === 'jan' && <span class="owner-match-badge">Same barcode</span>}
          </p>
        ))}
      </div>
    )}

    {priceMatches.length > 0 && (
      <div class="price-matches">
        <h2>In your price list</h2>
        <div class="price-match-list">
          {priceMatches.map(({ product, label }) => (
            <a class="price-match-row" href={`/prices?open=${encodeURIComponent(product.key)}`}>
              {product.image ? (
                <img class="price-match-thumb" src={cdnImage(product.image.url, 160)} alt={product.productName} />
              ) : (
                <div class="price-match-thumb placeholder">🏷️</div>
              )}
              <div class="price-match-info">
                <div class="price-match-name">{product.productName}</div>
                <div class="price-match-sub">
                  <span class="price-match-badge">{label}</span>
                  <span>{product.prices.length} price{product.prices.length === 1 ? '' : 's'}</span>
                  {lowestJpy(product.prices) != null && <span>from ¥{(lowestJpy(product.prices) as number).toLocaleString('en-US')}</span>}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {q && (
      <div class="scan-results">
        <h2>In your collection</h2>
        {results.length === 0 ? (
          <div class="no-match">
            <strong>Not in collection.</strong>
            <span>No matches for “{q}”. Look it up externally below.</span>
          </div>
        ) : (
          results.map((r: any) => (
            <a class="result-row" href={detailHref(r._type, r._id)}>
              {r.image
                ? <img class="result-thumb" src={urlFor(r.image).height(120).url()} alt={r.title} />
                : r.externalImageUrl
                ? <img class="result-thumb" src={r.externalImageUrl} alt={r.title} />
                : <div class="result-thumb placeholder">{r._type === 'album' ? '🎵' : r._type === 'game' ? '🎮' : r._type === 'book' ? '📚' : '🧸'}</div>
              }
              <div class="result-info">
                <div class="result-title">{r.title}</div>
                <div class="result-sub">
                  {matchLabels.has(r._id) && <span class="match-badge">{matchLabels.get(r._id)}</span>}
                  {Array.isArray(r.sub) ? r.sub.join(', ') : r.sub}
                  {r.catalogNumber ? ` · ${r.catalogNumber}` : ''}
                </div>
              </div>
              <div class="result-status">
                {r.status === 'owned' && <span class="badge owned">OWNED</span>}
                {r.status === 'wishlist' && <span class="badge wishlist">WISHLIST</span>}
                {r.status === 'sold' && <span class="badge sold">SOLD</span>}
                {r.status === 'lent' && <span class="badge lent">LENT OUT</span>}
                {!r.status && <span class="badge owned">OWNED</span>}
              </div>
            </a>
          ))
        )}
      </div>
    )}

    {q && (
      <div class="ext-lookup">
        <h2>Look up “{q}” externally</h2>

        <div class="ext-group">
          <span class="ext-label">Albums</span>
          <a target="_blank" rel="noopener" href={`https://vgmdb.net/search?q=${encodeURIComponent(q)}`}>VGMdb ↗</a>
          <a target="_blank" rel="noopener" href={`https://www.google.com/search?q=${encodeURIComponent(q + ' soundtrack album')}`}>Google ↗</a>
        </div>

        <div class="ext-group">
          <span class="ext-label">Books</span>
          <a target="_blank" rel="noopener" href={`https://openlibrary.org/search?q=${encodeURIComponent(q)}`}>Open Library ↗</a>
          <a target="_blank" rel="noopener" href={`https://www.bookfinder.com/search/?keywords=${encodeURIComponent(q)}`}>BookFinder ↗</a>
          <a target="_blank" rel="noopener" href={`https://www.google.com/search?q=${encodeURIComponent(q + ' book')}`}>Google ↗</a>
        </div>

        <div class="ext-group">
          <span class="ext-label">Games</span>
          <a target="_blank" rel="noopener" href={`https://www.mobygames.com/search/?q=${encodeURIComponent(q)}`}>MobyGames ↗</a>
          <a target="_blank" rel="noopener" href={`https://www.igdb.com/search?type=1&q=${encodeURIComponent(q)}`}>IGDB ↗</a>
          <a target="_blank" rel="noopener" href={`https://www.google.com/search?q=${encodeURIComponent(q + ' game')}`}>Google ↗</a>
        </div>

        <div class="ext-group">
          <span class="ext-label">Merch</span>
          <a target="_blank" rel="noopener" href={`https://myfigurecollection.net/?_tb=item&keywords=${encodeURIComponent(q)}`}>MyFigureCollection ↗</a>
          <a target="_blank" rel="noopener" href={`https://www.google.com/search?q=${encodeURIComponent(q + ' figure')}`}>Google ↗</a>
        </div>

        <div class="ext-group">
          <span class="ext-label">General</span>
          <a target="_blank" rel="noopener" href={`https://www.google.com/search?q=${encodeURIComponent(q)}`}>Google ↗</a>
          <a target="_blank" rel="noopener" href={`https://www.google.com/search?tbm=isch&q=${encodeURIComponent(q)}`}>Google Images ↗</a>
        </div>
      </div>
    )}
  </div>

  <style>
    .scan-wrap { max-width: 640px; }
    .hint { font-size: 0.9rem; color: var(--muted); margin: 0.25rem 0 1.25rem; }

    .dup-banner {
      background: #4a0f1c; border: 1px solid #e74c3c; color: #ffd9d9;
      padding: 0.85rem 1rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.95rem;
    }
    .dup-banner strong { color: #fff; }

    .wish-banner {
      display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap;
      background: rgba(244,162,76,0.08); border: 1px solid rgba(244,162,76,0.4); color: var(--text);
      padding: 0.85rem 1rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.95rem;
    }
    .wish-banner strong { color: var(--accent); }
    .got-it-btn {
      flex-shrink: 0; background: #2ecc71; color: #06281a; border: none;
      padding: 0.5rem 0.9rem; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer;
    }
    .got-it-btn:disabled { opacity: 0.6; cursor: default; }

    .scan-form { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; }
    .scan-form input {
      flex: 1; min-width: 0; background: var(--surface); color: var(--text);
      border: 1px solid var(--border); padding: 0.9rem 1rem; border-radius: 8px; font-size: 1.1rem;
    }
    .scan-form button {
      background: var(--accent); color: var(--bg); border: none;
      padding: 0.9rem 1.4rem; border-radius: 8px; font-size: 1.1rem; cursor: pointer; font-weight: 600;
    }

    .scan-cam-btn {
      width: 100%; background: var(--surface); color: var(--text); border: 1px solid var(--accent);
      padding: 0.8rem; border-radius: 8px; font-size: 1rem; cursor: pointer; margin-bottom: 1rem;
    }
    .scan-reader { width: 100%; max-width: 400px; margin: 0 auto 1rem; border-radius: 8px; overflow: hidden; }
    .scan-msg { font-size: 0.9rem; color: var(--muted); margin-bottom: 1rem; }

    .scan-fam-btn {
      width: 100%; background: var(--surface); color: var(--text); border: 1px solid var(--border);
      padding: 0.8rem; border-radius: 8px; font-size: 1rem; cursor: pointer; margin-bottom: 1rem;
    }
    .scan-fam-btn:hover { border-color: var(--accent); }

    .identify-buttons { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
    .upload-btn {
      flex: 1; min-width: 140px; text-align: center;
      display: inline-block; background: var(--surface); color: var(--text);
      border: 1px solid var(--accent); padding: 0.7rem 0.9rem; border-radius: 8px;
      cursor: pointer; font-size: 0.9rem;
    }
    .upload-btn:hover { background: rgba(244,162,76,0.08); }
    .scan-identify-msg { font-size: 0.9rem; color: var(--muted); margin-bottom: 1rem; }
    .scan-identify-msg[hidden] { display: none; }

    .identified-line { font-size: 0.9rem; color: var(--text); margin-bottom: 1rem; }
    .identified-line strong { color: var(--accent); }

    .owner-matches { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.5rem; }
    .owner-match-line {
      font-size: 0.9rem; color: var(--text); margin: 0; padding: 0.5rem 0.7rem;
      background: rgba(244,162,76,0.06); border: 1px solid rgba(244,162,76,0.3); border-radius: 8px;
      display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
    }
    .owner-match-line strong { color: var(--accent); }
    .owner-match-badge {
      font-weight: 700; font-size: 0.75rem; padding: 0.1rem 0.4rem; border-radius: 4px;
      background: rgba(244,162,76,0.15); color: var(--accent);
    }

    .price-matches { margin-bottom: 1.5rem; }
    .price-matches h2 { font-size: 1rem; margin-bottom: 0.6rem; }
    .price-match-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .price-match-row {
      display: flex; gap: 0.75rem; align-items: center; padding: 0.6rem;
      background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
      text-decoration: none; color: inherit;
    }
    .price-match-row:hover { border-color: var(--accent); }
    .price-match-thumb { width: 44px; height: 44px; object-fit: cover; border-radius: 6px; background: var(--bg); flex-shrink: 0; }
    .price-match-thumb.placeholder { display: flex; align-items: center; justify-content: center; font-size: 1.2rem; border: 1px solid var(--border); }
    .price-match-info { flex: 1; min-width: 0; }
    .price-match-name { font-weight: 600; font-size: 0.92rem; overflow-wrap: anywhere; }
    .price-match-sub { display: flex; gap: 0.5rem; flex-wrap: wrap; font-size: 0.78rem; color: var(--muted); margin-top: 0.2rem; }
    .price-match-badge, .match-badge {
      font-weight: 700; padding: 0.1rem 0.4rem; border-radius: 4px;
      background: rgba(244,162,76,0.15); color: var(--accent);
    }
    .match-badge { margin-right: 0.4rem; }

    .scan-results { display: flex; flex-direction: column; border-top: 1px solid var(--border); margin-bottom: 1.5rem; }
    .scan-results h2 { font-size: 1rem; margin: 0.9rem 0 0.4rem; }
    .result-row { display: flex; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid var(--border); text-decoration: none; color: inherit; align-items: center; }
    .result-row:hover { background: rgba(255,255,255,0.03); }
    .result-thumb { width: 52px; height: 52px; object-fit: cover; background: var(--border); flex-shrink: 0; border-radius: 4px; }
    .result-thumb.placeholder { display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    .result-info { flex: 1; min-width: 0; }
    .result-title { font-weight: 600; }
    .result-sub { font-size: 0.85rem; color: var(--muted); }
    .result-status { flex-shrink: 0; }
    .badge { display: inline-block; padding: 0.35rem 0.6rem; border-radius: 6px; font-size: 0.75rem; font-weight: 700; background: var(--border); color: var(--text); }
    .badge.owned { background: #2ecc71; color: #06281a; }
    .badge.wishlist { background: #3498db; color: #04263d; }
    .badge.sold { background: #e67e22; color: #2a1604; }
    .badge.lent { background: #9b59b6; color: #1f0d28; }

    .no-match { padding: 1.25rem 0; display: flex; flex-direction: column; gap: 0.35rem; }
    .no-match strong { font-size: 1.1rem; }
    .no-match span { color: var(--muted); font-size: 0.9rem; }

    .ext-lookup h2 { font-size: 1rem; margin-bottom: 0.75rem; }
    .ext-group { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
    .ext-label { font-size: 0.8rem; color: var(--muted); width: 60px; flex-shrink: 0; }
    .ext-group a {
      background: var(--surface); color: var(--text); border: 1px solid var(--border);
      padding: 0.5rem 0.85rem; border-radius: 6px; text-decoration: none; font-size: 0.85rem;
    }
    .ext-group a:hover { border-color: var(--accent); }
  </style>

  <script is:inline src="/barcode-scanner.js"></script>
  <script is:inline src="/resize-image.js"></script>
  <script is:inline>
    (function () {
      const toggle = document.getElementById('scan-toggle')
      const reader = document.getElementById('scan-reader')
      const msg = document.getElementById('scan-msg')
      const input = document.getElementById('scan-input')
      const ijanField = document.getElementById('scan-ijan')
      const inameField = document.getElementById('scan-iname')
      const inamejpField = document.getElementById('scan-inamejp')
      const scanner = window.createBarcodeScanner('scan-reader')

      function showMsg(text) {
        msg.hidden = false
        msg.textContent = text
      }

      async function startScan() {
        reader.hidden = false
        msg.hidden = true
        try {
          await scanner.start((code) => {
            input.value = code
            ijanField.value = code
            inameField.value = ''
            inamejpField.value = ''
            stopScan().then(() => { input.form.submit() })
          })
          toggle.textContent = '✕ Close scanner'
        } catch (err) {
          showMsg(err && err.message ? err.message : 'Could not access camera. Allow camera in your browser and try again.')
          reader.hidden = true
        }
      }

      async function stopScan() {
        await scanner.stop()
        reader.hidden = true
        toggle.textContent = '📷 Scan barcode'
      }

      toggle.addEventListener('click', () => {
        if (scanner.isRunning()) stopScan()
        else startScan()
      })

      const famBtn = document.getElementById('family-register')
      if (famBtn) {
        famBtn.addEventListener('click', () => {
          const code = (input.value || '').trim()
          window.location.href = code ? `/add?barcode=${encodeURIComponent(code)}` : '/add'
        })
      }

      // "✓ Got it" on the wishlist callout — same /api/item-status call wishlist.astro's own
      // "Got it" button makes. Reloads on success so the server-rendered badge/banner catch
      // up with the new status, rather than trying to patch the DOM in two places at once.
      const gotItBtn = document.getElementById('scan-got-it')
      if (gotItBtn) {
        gotItBtn.addEventListener('click', async () => {
          gotItBtn.disabled = true
          gotItBtn.textContent = '…'
          try {
            const res = await fetch('/api/item-status', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: gotItBtn.dataset.id, status: 'owned' }),
            })
            if (!res.ok) { gotItBtn.disabled = false; gotItBtn.textContent = 'Retry'; return }
            window.location.reload()
          } catch (e) {
            gotItBtn.disabled = false
            gotItBtn.textContent = 'Retry'
          }
        })
      }

      const params = new URLSearchParams(window.location.search)
      if (params.get('scan') === '1') {
        startScan()
      }

      // --- "📷 Identify by photo" — resize/identify the same way add-price.astro does,
      // then search the collection with the result (and carry it along as ijan/iname/
      // inamejp so the "In your price list" section below can match it after the reload).
      const identifyMsg = document.getElementById('scan-identify-msg')
      const photoCamera = document.getElementById('scan-photo-camera')
      const photoGallery = document.getElementById('scan-photo-gallery')

      function showIdentifyMsg(text, ok) {
        identifyMsg.hidden = false
        identifyMsg.textContent = text
        identifyMsg.style.color = ok ? 'var(--muted)' : '#e74c3c'
      }

      function fileToBase64(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader()
          reader.onload = () => {
            const result = String(reader.result || '')
            const commaIdx = result.indexOf(',')
            resolve(commaIdx !== -1 ? result.slice(commaIdx + 1) : result)
          }
          reader.onerror = reject
          reader.readAsDataURL(file)
        })
      }

      async function identifyPhoto(file) {
        if (!file) return
        showIdentifyMsg('Identifying…', true)
        try {
          let forApi = file
          try {
            if (window.resizeImage) forApi = await window.resizeImage(file, 1024, 0.8)
          } catch (e) {}
          const image = await fileToBase64(forApi)
          const res = await fetch('/api/identify-product', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ images: [image] }),
          })
          const data = await res.json().catch(() => null)
          if (!res.ok) {
            showIdentifyMsg((data && data.error) || 'Identification failed.', false)
            return
          }
          const result = data && data.result ? data.result : {}
          if (!result.productName && !result.jan) {
            showIdentifyMsg('Could not identify anything useful in this photo.', false)
            return
          }
          const url = new URL('/scan', window.location.origin)
          url.searchParams.set('q', result.productName || result.jan || '')
          if (result.jan) url.searchParams.set('ijan', result.jan)
          if (result.productName) url.searchParams.set('iname', result.productName)
          if (result.productNameJp) url.searchParams.set('inamejp', result.productNameJp)
          window.location.href = url.toString()
        } catch (e) {
          showIdentifyMsg('Network error.', false)
        }
      }

      if (photoCamera) photoCamera.addEventListener('change', () => { identifyPhoto(photoCamera.files && photoCamera.files[0]); photoCamera.value = '' })
      if (photoGallery) photoGallery.addEventListener('change', () => { identifyPhoto(photoGallery.files && photoGallery.files[0]); photoGallery.value = '' })
    })()
  </script>
</Base>