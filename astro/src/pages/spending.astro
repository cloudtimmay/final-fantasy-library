---
import Base from '../layouts/Base.astro'
import {
  fetchTripsForSpending,
  fetchFamilyPurchasesForTrip,
  fetchPlannedPriceEntries,
  pickDefaultTrip,
  computePersonSpending,
  sumBoughtNok,
  NORWAY_DUTY_FREE_ALLOWANCE_NOK,
} from '../lib/spending'

const allTrips = await fetchTripsForSpending()

const requestedId = Astro.url.searchParams.get('trip')
const settings = allTrips.find((t) => t._id === requestedId) ?? pickDefaultTrip(allTrips)

function tripLabel(trip, index) {
  if (trip.label) return trip.label
  if (trip.startDate) return new Date(trip.startDate).toLocaleDateString('en-GB')
  return `Trip ${index + 1}`
}

const activeTripId = settings?._id ?? null
// Always the trip's own stored rate — no live-editable override (see Trip Settings).
const rate = settings?.jpyToNokRate ?? 0.06
const budgetNok = settings?.budgetNok ?? null
const budgetYen = settings?.budgetYen ?? null
const childBudgets = settings?.childBudgets ?? []

const tripPurchases = activeTripId ? await fetchFamilyPurchasesForTrip(activeTripId) : []

const tripPeople = childBudgets.map((c) => c.person).filter(Boolean)
const purchasePeople = [...new Set(tripPurchases.map((p) => p.person).filter(Boolean))]
const peopleList = [...new Set([...tripPeople, ...purchasePeople])]

// Computed once, server-side, for every person on this trip — the per-person cards
// (added in a later step) render this directly; the trip frame below aggregates it.
const personSpendings = activeTripId
  ? await Promise.all(
      peopleList.map(async (person) => {
        const planned = await fetchPlannedPriceEntries(person, activeTripId)
        return computePersonSpending(person, childBudgets, tripPurchases, planned, rate)
      })
    )
  : []

function fmtYen(n) {
  return '¥' + Math.round(n).toLocaleString('en-US')
}
function fmtNok(n) {
  return Math.round(n).toLocaleString('nb-NO') + ' kr'
}
function budgetBoth(bNok, bYen) {
  let nok = null, yen = null, nokExplicit = false, yenExplicit = false
  if (bNok) { nok = bNok; yen = rate > 0 ? nok / rate : null; nokExplicit = true }
  else if (bYen) { yen = bYen; nok = yen * rate; yenExplicit = true }
  return { nok, yen, nokExplicit, yenExplicit }
}

// Trip frame: the family's total budget for the trip, compared against everyone's
// bought total (planned is shown separately, never counted against the frame itself).
const frameBudget = budgetBoth(budgetNok, budgetYen)
const frameBoughtNok = sumBoughtNok(tripPurchases, rate)
const framePlannedNok = personSpendings.reduce((sum, p) => sum + p.plannedNok, 0)
const framePlannedExcludedCount = personSpendings.reduce((sum, p) => sum + p.plannedExcludedCurrencyCount, 0)
const frameOverBudget = frameBudget.nok != null && frameBoughtNok > frameBudget.nok
const framePct = frameBudget.nok ? Math.min(100, (frameBoughtNok / frameBudget.nok) * 100) : 0
const frameRemainingNok = frameBudget.nok != null ? frameBudget.nok - frameBoughtNok : null
---
<Base title="Spending">
  <div class="page-header">
    <h1>Spending</h1>
  </div>

  <p class="hint">Family shopping list for the selected trip is below. Budgets are set in Studio (Trip Settings).</p>

  {allTrips.length > 1 && (
    <nav class="trip-switcher">
      <span class="trip-switcher-label">Trip:</span>
      {allTrips.map((trip, index) => (
        <a
          href={`/spending?trip=${trip._id}`}
          class:list={['trip-btn', { active: trip._id === activeTripId }]}
        >{tripLabel(trip, index)}</a>
      ))}
    </nav>
  )}

  <p class="rate-note">1 JPY = {rate} NOK (change in Trip Settings)</p>

  {frameBudget.nok != null && frameBudget.nok > 0 && (
    <div class="frame-card" id="frame-card">
      <div class="frame-head">
        <span>Family trip budget</span>
        <span class="frame-budget-label">
          {fmtNok(frameBudget.nok)}{!frameBudget.nokExplicit ? ' est.' : ''}
          {frameBudget.yen ? ` (${fmtYen(frameBudget.yen)}${!frameBudget.yenExplicit ? ' est.' : ''})` : ''}
        </span>
      </div>
      <div class="frame-bar">
        <div class:list={['frame-fill', { over: frameOverBudget }]} style={`width:${framePct.toFixed(1)}%`}></div>
      </div>
      <div class:list={['frame-meta', { over: frameOverBudget }]}>
        {fmtNok(frameBoughtNok)} spent
        {framePlannedNok > 0 && ` · +${fmtNok(framePlannedNok)} planned`}
        {frameRemainingNok != null && (
          frameRemainingNok >= 0
            ? ` · ${fmtNok(frameRemainingNok)} left`
            : ` · ${fmtNok(-frameRemainingNok)} over`
        )}
      </div>
      {framePlannedExcludedCount > 0 && (
        <p class="frame-note">
          {framePlannedExcludedCount} planned item{framePlannedExcludedCount === 1 ? '' : 's'} in a currency other than JPY/NOK excluded from planned totals.
        </p>
      )}
    </div>
  )}

  <!-- ===== FAMILY SHOPPING LIST (this trip only) ===== -->
  <section class="section">
    <h2 class="section-title">Family shopping — {settings ? (settings.label || 'this trip') : 'no trip'}</h2>

    {peopleList.length > 0 ? (
      <>
        <nav class="person-filter" id="person-filter">
          <span class="person-filter-label">Person:</span>
          <button class="person-btn active" data-person="">All</button>
          {peopleList.map((p) => (
            <button class="person-btn" data-person={p}>{p}</button>
          ))}
        </nav>

        <div class="person-cards" id="person-cards">
          {personSpendings.map((p) => {
            const hasBudget = p.budgetNok != null && p.budgetNok > 0
            const pct = hasBudget ? Math.min(100, (p.boughtNok / p.budgetNok) * 100) : 0
            const overBudget = hasBudget && p.boughtNok > p.budgetNok
            return (
              <div class="person-card" data-person={p.person}>
                <div class="person-head">
                  <span class="person-name">{p.person}</span>
                  <span class:list={['person-spent', { over: overBudget }]}>
                    {hasBudget ? `${fmtNok(p.boughtNok)} / ${fmtNok(p.budgetNok)}` : `${fmtNok(p.boughtNok)} spent`}
                  </span>
                </div>
                {hasBudget && (
                  <div class="person-bar">
                    <div class:list={['person-fill', { over: overBudget }]} style={`width:${pct.toFixed(1)}%`}></div>
                  </div>
                )}
                <div class:list={['person-meta', { over: overBudget }]}>
                  {p.plannedNok > 0 && `+${fmtNok(p.plannedNok)} planned`}
                  {p.remainingNok != null && (
                    p.remainingNok >= 0
                      ? `${p.plannedNok > 0 ? ' · ' : ''}${fmtNok(p.remainingNok)} left`
                      : `${p.plannedNok > 0 ? ' · ' : ''}${fmtNok(-p.remainingNok)} over`
                  )}
                </div>
                {p.overBudgetWithPlanned && (
                  <p class="person-warning">⚠️ Bought + planned would exceed the budget</p>
                )}
                {p.plannedExcludedCurrencyCount > 0 && (
                  <p class="person-note">
                    {p.plannedExcludedCurrencyCount} planned item{p.plannedExcludedCurrencyCount === 1 ? '' : 's'} in a currency other than JPY/NOK excluded from the planned total.
                  </p>
                )}
                <div class:list={['person-duty-free', { over: p.dutyFreeOverNok > 0 }]}>
                  Duty-free: {fmtNok(p.boughtNok)} / {NORWAY_DUTY_FREE_ALLOWANCE_NOK} kr allowance
                  {p.dutyFreeOverNok > 0 ? ` — ${fmtNok(p.dutyFreeOverNok)} over` : ' — under'}
                  <span class="duty-free-hint"> (verify current threshold on toll.no)</span>
                </div>
              </div>
            )
          })}
        </div>

        <div class="store-wrap" id="store-wrap">
          <h3 class="store-title">Tax-free by store / day</h3>
          <div class="store-list" id="store-list"></div>
          <p class="store-note">Assumes shelf prices include 10% tax. Tax-free applies at ¥5,000+ (pre-tax) per store per day. Counts everyone's purchases for this trip.</p>
        </div>

        <div class="spend-list" id="family-list"></div>
      </>
    ) : (
      <p class="hint">No family purchases or per-child budgets for this trip yet. Add them in Studio (Family Purchases / Trip Settings).</p>
    )}
  </section>

  <script define:vars={{ peopleList, tripPurchases, rate }}>
    const personFilter = document.querySelector('#person-filter')
    const personCards = document.querySelectorAll('.person-card')
    const familyList = document.querySelector('#family-list')
    const storeWrap = document.querySelector('#store-wrap')
    const storeList = document.querySelector('#store-list')

    let selectedPerson = '' // '' means "All"

    const TAX_RATE = 0.10
    const PRETAX_THRESHOLD = 5000

    function fmtYen(n) { return '¥' + Math.round(n).toLocaleString('en-US') }
    function fmtNok(n) { return Math.round(n).toLocaleString('nb-NO') + ' kr' }

    // The person cards themselves are fully server-rendered (see personSpendings in the
    // frontmatter) — filtering just shows/hides the pre-rendered card for each person,
    // no recomputation needed client-side.
    function applyPersonCardFilter() {
      personCards.forEach((card) => {
        card.hidden = selectedPerson !== '' && card.dataset.person !== selectedPerson
      })
    }

    function updateFamily() {
      applyPersonCardFilter()

      if (familyList) {
        const visible = selectedPerson
          ? (tripPurchases || []).filter((p) => p.person === selectedPerson)
          : (tripPurchases || [])
        const sorted = visible.slice().sort((a, b) => (a.person || '').localeCompare(b.person || ''))
        familyList.innerHTML = sorted.map((p) => {
          const hasYen = p.priceYen != null && p.priceYen !== ''
          const hasNok = p.priceNok != null && p.priceNok !== ''

          let yenStr = ''
          let nokStr = ''
          if (hasYen) {
            yenStr = fmtYen(Number(p.priceYen))
            nokStr = hasNok ? fmtNok(Number(p.priceNok)) : fmtNok(Number(p.priceYen) * rate) + ' est.'
          } else if (hasNok) {
            nokStr = fmtNok(Number(p.priceNok))
            yenStr = rate > 0 ? fmtYen(Number(p.priceNok) / rate) + ' est.' : ''
          }
          const price = [yenStr, nokStr].filter(Boolean).join(' · ')

          const icon = p.status === 'bought' ? '✅' : '🛒'
          const store = p.storeName ? `<span class="spend-store">${p.storeName}</span>` : ''
          const btn = p.status === 'bought'
            ? `<button class="mark-btn undo" data-id="${p._id}" data-to="planned">↩︎ Planned</button>`
            : `<button class="mark-btn" data-id="${p._id}" data-to="bought">Mark bought</button>`
          return `<div class="spend-row">
            <span class="spend-icon">${icon}</span>
            <span class="spend-title">${p.name || ''}</span>
            <span class="spend-who">${p.person || ''}</span>
            ${store}
            <span class="spend-price">${price}</span>
            ${btn}
          </div>`
        }).join('')

        familyList.querySelectorAll('.mark-btn').forEach((btn) => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault()
            const id = btn.dataset.id
            const to = btn.dataset.to
            btn.disabled = true
            btn.textContent = '…'
            try {
              const res = await fetch('/api/family-purchase-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, status: to }),
              })
              if (!res.ok) { btn.disabled = false; btn.textContent = 'Retry'; return }
              // Person cards, the trip frame, and store/day totals are all computed
              // server-side from this same data — reloading is simpler and more correct
              // than duplicating that computation here just to patch the DOM in place.
              location.reload()
            } catch {
              btn.disabled = false
              btn.textContent = 'Retry'
            }
          })
        })
      }
    }

    function updateStores() {
      if (!storeWrap) return
      const groups = {}
      ;(tripPurchases || []).forEach((p) => {
        if (!p.priceYen) return
        const storeName = (p.storeName && p.storeName.trim()) ? p.storeName.trim() : '— No store —'
        const day = p.purchaseDate || '— No date —'
        const key = storeName + '||' + day
        if (!groups[key]) groups[key] = { storeName, day, incl: 0 }
        groups[key].incl += Number(p.priceYen)
      })

      const keys = Object.keys(groups).sort((a, b) => {
        const ga = groups[a], gb = groups[b]
        if (ga.day !== gb.day) return gb.day.localeCompare(ga.day)
        return ga.storeName.localeCompare(gb.storeName)
      })

      if (!keys.length) { storeWrap.style.display = 'none'; return }
      storeWrap.style.display = ''

      storeList.innerHTML = keys.map((key) => {
        const g = groups[key]
        const incl = g.incl
        const preTax = incl / (1 + TAX_RATE)
        const hasStore = g.storeName !== '— No store —'
        const reached = preTax >= PRETAX_THRESHOLD
        let cls = '', meta

        if (!hasStore) {
          meta = `${fmtYen(incl)} · assign a store to track tax-free`
        } else if (reached) {
          const saved = incl - preTax
          cls = 'ok'
          meta = `${fmtYen(incl)} · tax-free reached · save ~${fmtYen(saved)}`
        } else {
          const neededIncl = PRETAX_THRESHOLD * (1 + TAX_RATE) - incl
          meta = `${fmtYen(incl)} · ${fmtYen(neededIncl)} more to reach tax-free`
        }

        return `<div class="store-row ${cls}">
          <span class="store-name">${g.storeName} <span class="store-day">${g.day}</span></span>
          <span class="store-meta">${meta}</span>
        </div>`
      }).join('')
    }

    function update() {
      updateFamily()
      updateStores()
    }

    if (personFilter) {
      personFilter.querySelectorAll('.person-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          selectedPerson = btn.dataset.person || ''
          personFilter.querySelectorAll('.person-btn').forEach((b) => b.classList.toggle('active', b === btn))
          updateFamily()
        })
      })
    }

    update()
  </script>

  <style>
    .hint { font-size: 0.9rem; color: var(--muted); margin: 0.5rem 0 1.25rem; }

    .trip-switcher { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin-bottom: 1.25rem; }
    .trip-switcher-label { font-size: 0.85rem; color: var(--muted); }
    .person-filter { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin-bottom: 1.25rem; }
    .person-filter-label { font-size: 0.85rem; color: var(--muted); }

    .trip-btn,
    .person-btn {
      padding: 0.45rem 0.95rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--surface);
      color: var(--text);
      font-size: 0.85rem;
      font-weight: 500;
      line-height: 1;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
      transition: background 0.15s, border-color 0.15s, transform 0.05s;
    }

    .trip-btn:hover,
    .person-btn:hover {
      border-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 12%, var(--surface));
    }

    .trip-btn:active,
    .person-btn:active {
      transform: translateY(1px);
    }

    .trip-btn.active,
    .person-btn.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
      box-shadow: 0 2px 6px color-mix(in srgb, var(--accent) 45%, transparent);
      font-weight: 600;
    }

    .section { margin-bottom: 2.5rem; }
    .section-title { font-size: 1.1rem; margin: 0 0 1rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--border); }

    .rate-note { font-size: 0.85rem; color: var(--muted); margin-bottom: 1.5rem; }

    .frame-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; }
    .frame-head { display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.6rem; font-weight: 600; }
    .frame-bar { background: var(--border); border-radius: 999px; height: 12px; overflow: hidden; }
    .frame-fill { background: #2ecc71; height: 100%; width: 0%; transition: width 0.3s; }
    .frame-fill.over { background: #e74c3c; }
    .frame-meta { font-size: 0.85rem; color: var(--muted); margin-top: 0.5rem; }
    .frame-meta.over { color: #e74c3c; font-weight: 600; }
    .frame-note { font-size: 0.75rem; color: var(--muted); margin-top: 0.5rem; }

    .person-cards { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem; }
    .person-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 0.75rem 1rem; }
    .person-card[hidden] { display: none; }
    .person-head { display: flex; justify-content: space-between; gap: 0.75rem; font-size: 0.85rem; margin-bottom: 0.5rem; }
    .person-name { font-weight: 600; }
    .person-spent { color: var(--muted); text-align: right; }
    .person-spent.over { color: #e74c3c; font-weight: 600; }
    .person-bar { background: var(--border); border-radius: 999px; height: 8px; overflow: hidden; }
    .person-fill { background: #2ecc71; height: 100%; width: 0%; transition: width 0.3s; }
    .person-fill.over { background: #e74c3c; }
    .person-meta { font-size: 0.82rem; color: var(--muted); margin-top: 0.4rem; }
    .person-meta.over { color: #e74c3c; font-weight: 600; }
    .person-warning { font-size: 0.78rem; color: #e74c3c; margin-top: 0.4rem; }
    .person-note { font-size: 0.75rem; color: var(--muted); margin-top: 0.4rem; }
    .person-duty-free { font-size: 0.78rem; color: var(--muted); margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px solid var(--border); }
    .person-duty-free.over { color: #e74c3c; font-weight: 600; }
    .duty-free-hint { font-weight: 400; color: var(--muted); }

    .store-wrap { margin-bottom: 1.5rem; }
    .store-title { font-size: 0.95rem; margin: 0 0 0.6rem; }
    .store-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .store-row { display: flex; justify-content: space-between; gap: 0.75rem; align-items: center; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 0.6rem 0.9rem; font-size: 0.85rem; }
    .store-row.ok { border-color: #2ecc71; }
    .store-name { font-weight: 600; }
    .store-day { font-weight: 400; color: var(--muted); font-size: 0.75rem; margin-left: 0.4rem; }
    .store-meta { color: var(--muted); text-align: right; }
    .store-row.ok .store-meta { color: #2ecc71; }
    .store-note { font-size: 0.75rem; color: var(--muted); margin: 0.6rem 0 0; }

    .spend-list { display: flex; flex-direction: column; border-top: 1px solid var(--border); }
    .spend-row { display: flex; gap: 0.75rem; align-items: center; padding: 0.6rem 0; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
    .spend-icon { flex-shrink: 0; }
    .spend-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .spend-who { flex-shrink: 0; font-size: 0.75rem; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 0.1rem 0.5rem; }
    .spend-store { flex-shrink: 0; font-size: 0.75rem; color: var(--muted); }
    .spend-date { color: var(--muted); font-size: 0.8rem; flex-shrink: 0; }
    .spend-price { font-weight: 600; flex-shrink: 0; }

    .mark-btn {
      flex-shrink: 0; background: var(--accent); color: #fff; border: none;
      padding: 0.35rem 0.7rem; border-radius: 6px; font-size: 0.75rem; cursor: pointer; white-space: nowrap;
    }
    .mark-btn.undo { background: var(--surface); color: var(--muted); border: 1px solid var(--border); }
    .mark-btn:disabled { opacity: 0.6; cursor: default; }
  </style>
</Base>